# Shell scripts must use LF so they run under bash on the Pi and in WSL, even
# when checked out on Windows.
*.sh text eol=lf

# Systemd unit files are Linux-only; keep LF.
*.service text eol=lf

# Env files are sourced by bash on the Pi / in WSL; keep LF.
*.env text eol=lf
pi.env.example text eol=lf

# ALSA / other Linux config files must be LF.
*.conf text eol=lf
