# TETRA BlueStation MMI - boot splash on the Waveshare 5" DSI panel (DRM/KMS, no desktop).
#
# Shows deploy/splash.png on the panel from boot until the kiosk UI's first
# frame. For most of that window the app isn't running yet, so the splash must
# be drawn at the framebuffer level.
#
# WHY A RAW /dev/fb0 WRITE (not fbi): fbi renders on a virtual terminal, so it
# is only visible when its VT is the foreground console, and it clears the
# screen to black when it exits (which it does ~1 s after painting under
# systemd). Writing raw pixels straight to /dev/fb0 shows on the panel
# regardless of the foreground VT and stays in the framebuffer memory until the
# UI's DRM modeset scans out over it - a clean, reliable handoff.
#
# The image is pre-converted to the panel's exact framebuffer format (RGB565 for
# the Pi KMS default, matching /sys/class/graphics/fb0) by
# scripts/png_to_fb565.py, producing deploy/splash.raw next to the PNG. The WSL
# deploy path (scripts/cross/install-service.sh) does this for you.
#
# BOOT-TEXT NOTE: keep the panel's console on tty1 but silence it so no
# kernel/systemd text shows behind the splash. In /boot/firmware/cmdline.txt
# keep "console=tty1" and add:
#   quiet loglevel=0 logo.nologo vt.global_cursor_default=0 systemd.show_status=0
# and in config.txt add "disable_splash=1".
#
# Manual install (on the Pi), assuming deploy/splash.raw exists:
#   sudo cp deploy/splash.service /etc/systemd/system/splash.service
#   # edit the splash.raw path below if your dir isn't /home/pi/tetra-tn-ui
#   sudo systemctl daemon-reload && sudo systemctl enable splash.service

[Unit]
Description=Boot splash on DSI panel (raw -> /dev/fb0)
# Paint before the kiosk UI claims the panel, and hold tty1 off the login getty
# so nothing repaints the framebuffer until the UI's modeset.
Before=tetra-bluestation-mmi.service
Conflicts=getty@tty1.service

[Service]
# Oneshot: dd writes the image into the framebuffer and exits; the pixels
# persist in fb memory until the UI modesets. RemainAfterExit keeps the unit
# active so getty@tty1 stays conflicted (suppressed) until the UI starts.
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/dd if=/home/pi/tetra-tn-ui/deploy/splash.raw of=/dev/fb0 bs=1843200 count=1 conv=notrunc status=none

[Install]
WantedBy=multi-user.target
