# Rust build artifacts
/target
**/*.rs.bk

# Backup and editor files
*~
# JetBrains IDE: ignore local IDE state, but track shared run configurations so
# the Windows-dev + deploy-to-Pi run configs are reproducible for everyone.
.idea/*
!.idea/runConfigurations/
.vscode/

# Local TLS material (never commit certs/keys)
/certs/

# OS noise
Thumbs.db
.DS_Store

# Runtime logs
*.log

# Local message store (SDS history persisted at runtime)
/data/

# Local screenshots
*.png

# ETSI-copyrighted ACELP codec libraries (loaded at runtime, never committed)
*.dll
*.so
*.dylib
tetra_acelp*
native/etsi/
