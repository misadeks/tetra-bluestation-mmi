# Rust build artifacts
/target
**/*.rs.bk

# Backup and editor files
*~
# JetBrains IDE: ignore local IDE state, but track shared run configurations so
# the Windows-dev + deploy-to-Pi run configs are reproducible for everyone.
.idea/*
!.idea/runConfigurations/
.vscode/

# Local TLS material (never commit certs/keys)
/certs/

# OS noise
Thumbs.db
.DS_Store

# Runtime logs
*.log

# Synced Raspberry Pi sysroot for WSL cross-compiling (large; device-specific)
/.pi-sysroot/

# Per-developer Pi deploy settings (copied from pi.env.example)
/scripts/cross/pi.env

# Local message store (SDS history persisted at runtime)
/data/

# Local screenshots
*.png
# Generated raw framebuffer splash (derived from deploy/splash.png on deploy)
*.raw

# Compiled shared libraries (never committed)
*.dll
*.so
*.dylib

# Removed ETSI-C codec glue; keep any local remnants (incl. copyrighted
# native/etsi/ sources) out of git for good.
/native/

# Python bytecode cache
__pycache__/
*.pyc

# Internal development log (kept local, not shared)
DECISIONS.md

# Local release payloads / build outputs
/dist/
