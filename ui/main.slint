// TETRA TN UI - Slint UI (Pi touch), styled to match the browser
// tetra-tn-web-ui (Classic-style radio). Device frame of status bar + header +
// stage + softkey grid; home is the talkgroup cycler with the select action
// directly below and a docked PTT; Menu and Dialer reachable from the home
// softkeys. Bundled Inter font, SVG-path icons, large touch metrics. Live values
// are `in` properties set from Rust (app.rs) off MsRuntimeState.

// Bundle the Inter font (matches the web UI) so the look is consistent on
// Windows and the Pi regardless of installed system fonts.
import "fonts/Inter-Regular.ttf";
import "fonts/Inter-Medium.ttf";
import "fonts/Inter-SemiBold.ttf";
import "fonts/Inter-Bold.ttf";
import "fonts/Inter-ExtraBold.ttf";

export enum DeviceInput { Touch, Keypad }
enum Screen { Home, Menu, Info, Folders, Dialer }

export struct FolderRow {
    name: string,
    count: int,
    selected: bool,
}

// Palette lifted from the web UI's :root custom properties.
global Palette {
    out property <color> bg: #06080b;
    out property <color> glass1: #0f1620;
    out property <color> glass2: #0a0f16;
    out property <color> surface: #131c26;
    out property <color> surface2: #17222f;
    out property <color> line: #ffffff12;
    out property <color> line2: #ffffff21;
    out property <color> txt: #eaf0f5;
    out property <color> muted: #8b98a5;
    out property <color> faint: #58656f;
    out property <color> accent: #33a7dd;
    out property <color> green: #37c06a;
    out property <color> red: #f0555a;
    out property <color> amber: #e7a72b;
}

// Line icon rendered from an SVG path (24x24 viewbox), like the web UI icons.
component Icon inherits Path {
    in property <string> d;
    in property <length> size: 22px;
    in property <color> tint: Palette.txt;
    in property <float> weight: 2.0;
    width: root.size;
    height: root.size;
    viewbox-width: 24;
    viewbox-height: 24;
    commands: root.d;
    fill: transparent;
    stroke: root.tint;
    stroke-width: root.weight * 1px;
}

global Icons {
    out property <string> menu: "M4 7L20 7M4 12L20 12M4 17L20 17";
    out property <string> phone: "M5 3.5h3.2l1.6 4-2 1.4a11 11 0 0 0 5.3 5.3l1.4-2 4 1.6V19a2 2 0 0 1-2.2 2A16.5 16.5 0 0 1 4 6.7 2 2 0 0 1 5 3.5z";
    out property <string> back: "M15 18L9 12L15 6";
    out property <string> chevron: "M9 6L15 12L9 18";
    out property <string> chevron-down: "M6 9L12 15L18 9";
    out property <string> info: "M12 3a9 9 0 1 0 0.001 0M12 11L12 16.5";
    out property <string> folder: "M3 7.5a2 2 0 0 1 2-2h3.6l2 2H19a2 2 0 0 1 2 2v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z";
    out property <string> check: "M4 12L10 18L20 6";
    out property <string> login: "M14 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4M10 8L14 12L10 16M14 12L3 12";
    out property <string> logout: "M10 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h4M16 8L20 12L16 16M20 12L9 12";
    out property <string> mic: "M12 3a3 3 0 0 1 3 3v5a3 3 0 0 1-6 0V6a3 3 0 0 1 3-3M6 11a6 6 0 0 0 12 0M12 17v4M8.5 21h7";
    out property <string> backspace: "M9 5.5h11a1.5 1.5 0 0 1 1.5 1.5v10a1.5 1.5 0 0 1-1.5 1.5H9L2.5 12zM12 9.5L17 14.5M17 9.5L12 14.5";
    out property <string> users: "M9 8a3 3 0 1 0 0.01 0M3.6 19c0-3 2.5-5.2 5.4-5.2S14.4 16 14.4 19M16.5 5.5a3 3 0 0 1 0 5.8M17.6 13.9c2 .6 3.3 2.5 3.3 5.1";
}

// 5 signal bars, heights scaled up, bottom-aligned (web UI .sig).
component SignalBars inherits Rectangle {
    in property <int> bars;
    width: 32px;
    height: 20px;
    HorizontalLayout {
        spacing: 2.5px;
        alignment: start;
        for h[i] in [6, 9, 13, 16, 20]: VerticalLayout {
            alignment: end;
            Rectangle {
                width: 4px;
                height: h * 1px;
                border-radius: 1px;
                background: i < root.bars ? #dbe6ee : #35424c;
            }
        }
    }
}

// Rounded channel-link badge with a letter (web UI .lnk).
component LinkBadge inherits Rectangle {
    in property <string> label;
    in property <bool> on;
    width: 24px;
    height: 22px;
    border-radius: 7px;
    background: root.on ? #37c06a2e : #f0555a24;
    Text {
        text: root.label;
        color: root.on ? #79dfa0 : #ff9a9d;
        font-size: 12px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component Battery inherits Rectangle {
    width: 32px;
    height: 16px;
    Rectangle {
        x: 0;
        y: 0;
        width: 28px;
        height: 16px;
        border-width: 1.5px;
        border-color: #7f8f9b;
        border-radius: 3px;
        Rectangle {
            x: 2.5px;
            y: 2.5px;
            width: 17px;
            height: 11px;
            background: Palette.green;
            border-radius: 1px;
        }
    }
    Rectangle {
        x: 28px;
        y: 4.5px;
        width: 3px;
        height: 7px;
        background: #7f8f9b;
        border-radius: 1px;
    }
}

component StatusBar inherits Rectangle {
    in property <int> bars;
    in property <string> network;
    in property <bool> scan;
    in property <bool> control-on;
    in property <bool> telemetry-on;
    in property <string> clock;
    height: 54px;
    background: @linear-gradient(180deg, #0e1822 0%, #0b131b 100%);

    HorizontalLayout {
        padding-left: 18px;
        padding-right: 18px;
        spacing: 12px;
        alignment: start;

        VerticalLayout { alignment: center; SignalBars { bars: root.bars; } }
        VerticalLayout {
            alignment: center;
            Text {
                text: root.network;
                color: Palette.muted;
                font-size: 13px;
                font-weight: 500;
                vertical-alignment: center;
            }
        }
        if root.scan: VerticalLayout {
            alignment: center;
            Text {
                text: "SCAN";
                color: Palette.accent;
                font-size: 12px;
                font-weight: 800;
                letter-spacing: 1.5px;
                vertical-alignment: center;
            }
        }
        Rectangle { horizontal-stretch: 1; }
        VerticalLayout { alignment: center; LinkBadge { label: "C"; on: root.control-on; } }
        VerticalLayout { alignment: center; LinkBadge { label: "T"; on: root.telemetry-on; } }
        VerticalLayout {
            alignment: center;
            Text {
                text: root.clock;
                color: #cdd9e2;
                font-size: 15px;
                font-weight: 600;
                vertical-alignment: center;
            }
        }
        VerticalLayout { alignment: center; Battery { } }
    }
}

component Header inherits Rectangle {
    in property <string> title;
    in property <bool> muted;
    height: 52px;
    background: @linear-gradient(180deg, #0e1822 0%, #0b131b 100%);
    Text {
        text: root.title;
        color: root.muted ? Palette.muted : Palette.txt;
        font-size: 18px;
        font-weight: root.muted ? 500 : 600;
        letter-spacing: root.muted ? 1px : 0.3px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component CyclerArrow inherits Rectangle {
    in property <bool> right;
    in property <bool> enabled: true;
    callback clicked;
    width: 80px;
    height: 168px;
    border-radius: 18px;
    border-width: 1px;
    border-color: Palette.line2;
    background: touch.pressed ? #1b2836 : @linear-gradient(160deg, #17222f 0%, #0f1822 100%);
    opacity: root.enabled ? 1.0 : 0.3;
    touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            root.clicked();
        }
    }
    Icon {
        x: (parent.width - self.width) / 2 + (root.right ? 2px : -2px);
        y: (parent.height - self.height) / 2;
        d: root.right ? Icons.chevron : Icons.back;
        tint: #cfe0ec;
        size: 40px;
        weight: 2.4;
    }
}

component FolderButton inherits Rectangle {
    in property <string> name;
    callback clicked;
    height: 48px;
    border-radius: 999px;
    border-width: 1px;
    border-color: Palette.line;
    background: touch.pressed ? #1b2836 : Palette.surface;
    horizontal-stretch: 0;
    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }
    HorizontalLayout {
        padding-left: 18px;
        padding-right: 16px;
        spacing: 10px;
        alignment: center;
        VerticalLayout { alignment: center; Icon { d: Icons.folder; tint: Palette.accent; size: 18px; } }
        Text {
            text: root.name;
            color: #cfe0ec;
            font-size: 17px;
            font-weight: 600;
            vertical-alignment: center;
        }
        VerticalLayout { alignment: center; Icon { d: Icons.chevron-down; tint: Palette.faint; size: 16px; } }
    }
}

component Badge inherits Rectangle {
    in property <string> text;
    in property <color> fg;
    in property <color> bg;
    height: 28px;
    border-radius: 999px;
    background: root.bg;
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        Text {
            text: root.text;
            color: root.fg;
            font-size: 12px;
            font-weight: 800;
            letter-spacing: 1.5px;
            vertical-alignment: center;
        }
    }
}

component PrimaryButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    in property <string> icon: Icons.check;
    callback clicked;
    height: 64px;
    border-radius: 16px;
    border-width: 1px;
    border-color: root.enabled ? #37c06a80 : Palette.line;
    background: root.enabled
        ? (touch.pressed ? #16321f : @linear-gradient(180deg, #16351f 0%, #10281a 100%))
        : Palette.surface;
    opacity: root.enabled ? 1.0 : 0.45;
    touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            root.clicked();
        }
    }
    HorizontalLayout {
        alignment: center;
        spacing: 10px;
        VerticalLayout {
            alignment: center;
            Icon { d: root.icon; tint: root.enabled ? #8fe6ab : Palette.muted; size: 20px; }
        }
        Text {
            text: root.text;
            color: root.enabled ? #8fe6ab : Palette.muted;
            font-size: 18px;
            font-weight: 700;
            vertical-alignment: center;
        }
    }
}

// Docked push-to-talk button (voice lands in M5/M6; here it reflects state).
component Ptt inherits Rectangle {
    in property <string> text;
    in property <bool> enabled;
    callback pressed;
    height: 138px;
    border-radius: 22px;
    border-width: 1px;
    border-color: root.enabled ? Palette.line2 : #ffffff1f;
    background: root.enabled
        ? (touch.pressed ? @linear-gradient(180deg, #24303d 0%, #1a2430 100%)
                         : @linear-gradient(180deg, #1a2430 0%, #131b24 100%))
        : @linear-gradient(180deg, #1b1d22 0%, #141519 100%);
    opacity: root.enabled ? 1.0 : 0.7;
    touch := TouchArea {
        enabled: root.enabled;
        pointer-event(ev) => {
            if (ev.kind == PointerEventKind.down) {
                root.pressed();
            }
        }
    }
    VerticalLayout {
        alignment: center;
        spacing: 10px;
        HorizontalLayout {
            alignment: center;
            Icon { d: Icons.mic; tint: root.enabled ? Palette.txt : Palette.muted; size: 34px; }
        }
        Text {
            text: root.text;
            color: root.enabled ? Palette.txt : Palette.muted;
            font-size: 18px;
            font-weight: 700;
            letter-spacing: 0.4px;
            horizontal-alignment: center;
        }
    }
}

component Softkey inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <bool> danger;
    in property <bool> enabled: true;
    callback clicked;
    border-radius: 14px;
    border-width: 1px;
    border-color: root.danger ? #b5343a : Palette.line;
    background: root.danger
        ? @linear-gradient(180deg, #d23b41 0%, #a82a2f 100%)
        : (touch.pressed ? #16202b : Palette.surface);
    opacity: root.enabled ? 1.0 : 0.35;
    touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            root.clicked();
        }
    }
    HorizontalLayout {
        alignment: center;
        spacing: 8px;
        VerticalLayout {
            alignment: center;
            if root.icon != "": Icon {
                d: root.icon;
                tint: root.danger ? #ffffff : Palette.txt;
                size: 19px;
            }
        }
        Text {
            text: root.text;
            color: root.danger ? #ffffff : Palette.txt;
            font-size: 15px;
            font-weight: 600;
            vertical-alignment: center;
        }
    }
}

component InfoRow inherits HorizontalLayout {
    in property <string> label;
    in property <string> value;
    in property <color> value-color: Palette.txt;
    height: 40px;
    Text {
        text: root.label;
        color: Palette.muted;
        font-size: 15px;
        vertical-alignment: center;
    }
    Rectangle { horizontal-stretch: 1; }
    Text {
        text: root.value;
        color: root.value-color;
        font-size: 15px;
        font-weight: 600;
        vertical-alignment: center;
        horizontal-alignment: right;
    }
}

component ListRow inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    in property <string> icon;
    in property <color> icon-tint: Palette.accent;
    in property <bool> danger;
    callback clicked;
    height: 68px;
    border-radius: 14px;
    border-width: 1px;
    border-color: Palette.line;
    background: touch.pressed ? #16202b : Palette.surface;
    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 14px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 42px;
                height: 42px;
                border-radius: 12px;
                background: root.danger ? #f0555a1f : #33a7dd1f;
                Icon {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    d: root.icon;
                    tint: root.danger ? Palette.red : root.icon-tint;
                    size: 20px;
                }
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            Text {
                text: root.title;
                color: root.danger ? #ff9a9d : Palette.txt;
                font-size: 17px;
                font-weight: 600;
            }
            if root.subtitle != "": Text {
                text: root.subtitle;
                color: Palette.muted;
                font-size: 13px;
            }
        }
        Rectangle { horizontal-stretch: 1; }
        VerticalLayout { alignment: center; Icon { d: Icons.chevron; tint: Palette.faint; size: 18px; } }
    }
}

// ---- Home screen: talkgroup cycler + select action + docked PTT ----
component HomeScreen inherits Rectangle {
    in property <bool> has-codeplug;
    in property <string> folder-name;
    in property <string> talkgroup-name;
    in property <string> tg-sub;
    in property <string> badge;
    in property <int> badge-kind; // 0 not-selected, 1 scanning, 2 on-air
    in property <bool> can-cycle;
    in property <int> attached-count;
    in property <bool> scan-active;
    in property <bool> select-enabled;
    in property <bool> ptt-enabled;
    in property <string> ptt-label;
    callback cycle-prev;
    callback cycle-next;
    callback select-tg;
    callback open-folders;
    callback ptt;

    property <color> badge-fg: root.badge-kind == 2 ? #ff9a9d : (root.badge-kind == 1 ? #7ecbef : Palette.muted);
    property <color> badge-bg: root.badge-kind == 2 ? #d23b4133 : (root.badge-kind == 1 ? #33a7dd29 : #ffffff10);

    background: transparent;

    VerticalLayout {
        padding: 22px;
        spacing: 18px;

        // Cycler group, vertically centered.
        Rectangle {
            vertical-stretch: 1;
            VerticalLayout {
                alignment: center;
                spacing: 20px;

                if root.has-codeplug: HorizontalLayout {
                    alignment: center;
                    FolderButton {
                        name: root.folder-name;
                        clicked => {
                            root.open-folders();
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 12px;
                    CyclerArrow {
                        right: false;
                        enabled: root.can-cycle;
                        clicked => {
                            root.cycle-prev();
                        }
                    }
                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: center;
                        spacing: 6px;
                        Text {
                            text: "TALKGROUP";
                            color: Palette.faint;
                            font-size: 12px;
                            font-weight: 700;
                            letter-spacing: 4px;
                            horizontal-alignment: center;
                        }
                        Text {
                            text: root.talkgroup-name;
                            color: #f2f7fb;
                            font-size: 64px;
                            font-weight: 800;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                        }
                        Text {
                            text: root.tg-sub;
                            color: Palette.muted;
                            font-size: 15px;
                            horizontal-alignment: center;
                        }
                        if root.badge != "": HorizontalLayout {
                            alignment: center;
                            Badge { text: root.badge; fg: root.badge-fg; bg: root.badge-bg; }
                        }
                    }
                    CyclerArrow {
                        right: true;
                        enabled: root.can-cycle;
                        clicked => {
                            root.cycle-next();
                        }
                    }
                }

                // Select-talkgroup action, directly below the cycler.
                if root.has-codeplug: PrimaryButton {
                    text: root.badge-kind == 2 ? "On air" : "Select talkgroup";
                    enabled: root.select-enabled;
                    clicked => {
                        root.select-tg();
                    }
                }

                if root.scan-active: HorizontalLayout {
                    alignment: center;
                    Rectangle {
                        height: 40px;
                        border-radius: 999px;
                        background: #33a7dd29;
                        HorizontalLayout {
                            padding-left: 16px;
                            padding-right: 16px;
                            Text {
                                text: "SCAN - " + root.attached-count + " groups";
                                color: #7ecbef;
                                font-size: 13px;
                                font-weight: 700;
                                letter-spacing: 1px;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }

        // Fixed PTT dock.
        Ptt {
            text: root.ptt-label;
            enabled: root.ptt-enabled;
            pressed => {
                root.ptt();
            }
        }
    }
}

component MenuScreen inherits Rectangle {
    in property <bool> registered;
    callback open-info;
    callback register;
    callback deregister;
    background: transparent;
    VerticalLayout {
        padding: 18px;
        spacing: 12px;
        alignment: start;
        ListRow {
            title: "Radio Info";
            subtitle: "Registration, network, signal";
            icon: Icons.info;
            clicked => {
                root.open-info();
            }
        }
        ListRow {
            title: root.registered ? "Deregister" : "Register";
            subtitle: root.registered ? "Detach from the network" : "Attach to the network";
            icon: root.registered ? Icons.logout : Icons.login;
            danger: root.registered;
            icon-tint: Palette.green;
            clicked => {
                if (root.registered) {
                    root.deregister();
                } else {
                    root.register();
                }
            }
        }
    }
}

component InfoScreen inherits Rectangle {
    in property <string> reg-state;
    in property <bool> registered;
    in property <string> service-status;
    in property <bool> in-service;
    in property <string> issi;
    in property <string> network;
    in property <string> serving-la;
    in property <string> colour-code;
    in property <string> rssi;
    in property <int> attached-count;
    in property <bool> restart-required;
    background: transparent;
    VerticalLayout {
        padding: 18px;
        spacing: 12px;
        alignment: start;
        Rectangle {
            background: Palette.surface;
            border-radius: 16px;
            border-width: 1px;
            border-color: Palette.line;
            VerticalLayout {
                padding: 18px;
                spacing: 2px;
                InfoRow {
                    label: "Registration";
                    value: root.reg-state;
                    value-color: root.registered ? Palette.green : Palette.muted;
                }
                InfoRow {
                    label: "Service";
                    value: root.service-status;
                    value-color: root.in-service ? Palette.green : Palette.red;
                }
                InfoRow { label: "Own ISSI"; value: root.issi; }
                InfoRow { label: "Network (MCC/MNC)"; value: root.network; }
                InfoRow { label: "Serving LA"; value: root.serving-la; }
                InfoRow { label: "Colour code"; value: root.colour-code; }
                InfoRow { label: "Signal"; value: root.rssi; }
                InfoRow { label: "Attached groups"; value: root.attached-count; }
            }
        }
        if root.restart-required: Text {
            text: "Restart required to apply staged config";
            color: Palette.amber;
            font-size: 14px;
            wrap: word-wrap;
        }
    }
}

component FolderRowView inherits Rectangle {
    in property <string> name;
    in property <int> count;
    in property <bool> selected;
    callback clicked;
    height: 70px;
    border-radius: 16px;
    border-width: 1px;
    border-color: root.selected ? #33a7dd80 : Palette.line;
    background: touch.pressed ? #16202b : (root.selected ? #33a7dd1a : Palette.surface);
    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 14px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 44px;
                height: 44px;
                border-radius: 12px;
                background: #33a7dd24;
                Icon {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    d: Icons.folder;
                    tint: Palette.accent;
                    size: 22px;
                }
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            Text {
                text: root.name;
                color: Palette.txt;
                font-size: 18px;
                font-weight: 600;
            }
            Text {
                text: root.count + (root.count == 1 ? " talkgroup" : " talkgroups");
                color: Palette.muted;
                font-size: 13px;
            }
        }
        Rectangle { horizontal-stretch: 1; }
        if root.selected: VerticalLayout {
            alignment: center;
            Icon { d: Icons.check; tint: Palette.accent; size: 22px; }
        }
    }
}

component FoldersScreen inherits Rectangle {
    in property <[FolderRow]> folders;
    callback select-folder(int);
    background: transparent;
    VerticalLayout {
        padding: 18px;
        spacing: 12px;
        alignment: start;
        for f[idx] in root.folders: FolderRowView {
            name: f.name;
            count: f.count;
            selected: f.selected;
            clicked => {
                root.select-folder(idx);
            }
        }
    }
}

component DialKey inherits Rectangle {
    in property <string> text;
    in property <string> sub;
    callback clicked;
    height: 76px;
    border-radius: 16px;
    border-width: 1px;
    border-color: Palette.line2;
    background: touch.pressed ? #1b2836 : @linear-gradient(180deg, #17222f 0%, #0f1822 100%);
    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }
    VerticalLayout {
        alignment: center;
        spacing: 0px;
        Text {
            text: root.text;
            color: #e8f0f6;
            font-size: 26px;
            font-weight: 600;
            horizontal-alignment: center;
        }
        if root.sub != "": Text {
            text: root.sub;
            color: Palette.faint;
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 1px;
            horizontal-alignment: center;
        }
    }
}

component DialerScreen inherits Rectangle {
    in property <string> number;
    callback key(string);
    callback call;
    background: transparent;
    VerticalLayout {
        padding: 18px;
        spacing: 14px;

        VerticalLayout {
            alignment: center;
            spacing: 4px;
            Text {
                text: root.number == "" ? "Enter number" : root.number;
                color: root.number == "" ? Palette.faint : #ffffff;
                font-size: root.number == "" ? 20px : 34px;
                font-weight: root.number == "" ? 600 : 800;
                letter-spacing: 2px;
                horizontal-alignment: center;
            }
            Text {
                text: "SSI / GROUP";
                color: Palette.muted;
                font-size: 11px;
                letter-spacing: 3px;
                horizontal-alignment: center;
            }
        }

        Rectangle { vertical-stretch: 1; }

        for row in [["1", "2", "3"], ["4", "5", "6"], ["7", "8", "9"], ["*", "0", "#"]]: HorizontalLayout {
            spacing: 10px;
            for d in row: DialKey {
                text: d;
                horizontal-stretch: 1;
                clicked => {
                    root.key(d);
                }
            }
        }

        HorizontalLayout {
            spacing: 10px;
            Rectangle {
                height: 64px;
                horizontal-stretch: 1;
                border-radius: 16px;
                border-width: 1px;
                border-color: Palette.line2;
                background: bstouch.pressed ? #1b2836 : Palette.surface;
                bstouch := TouchArea {
                    clicked => {
                        root.key("back");
                    }
                }
                Icon {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    d: Icons.backspace;
                    tint: Palette.muted;
                    size: 24px;
                }
            }
            Rectangle {
                height: 64px;
                horizontal-stretch: 2;
                border-radius: 16px;
                border-width: 1px;
                border-color: #2bb76880;
                background: root.number == "" ? Palette.surface : (ctouch.pressed ? #17402a : @linear-gradient(180deg, #2bb768 0%, #1f9a55 100%));
                opacity: root.number == "" ? 0.5 : 1.0;
                ctouch := TouchArea {
                    enabled: root.number != "";
                    clicked => {
                        root.call();
                    }
                }
                HorizontalLayout {
                    alignment: center;
                    spacing: 10px;
                    VerticalLayout { alignment: center; Icon { d: Icons.phone; tint: root.number == "" ? Palette.muted : #ffffff; size: 22px; } }
                    Text {
                        text: "Call";
                        color: root.number == "" ? Palette.muted : #ffffff;
                        font-size: 18px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}

// Parked keypad layout for non-touch device models.
component KeypadHome inherits FocusScope {
    property <[string]> items: ["Talkgroups", "Logs", "Radio info", "Settings"];
    property <int> selected: 0;
    init => {
        self.focus();
    }
    key-pressed(event) => {
        if (event.text == Key.UpArrow) {
            root.selected = Math.max(0, root.selected - 1);
            return accept;
        }
        if (event.text == Key.DownArrow) {
            root.selected = Math.min(root.items.length - 1, root.selected + 1);
            return accept;
        }
        return reject;
    }
    VerticalLayout {
        padding: 18px;
        spacing: 12px;
        alignment: start;
        Text {
            text: "Keypad layout - Up/Down to move";
            color: Palette.muted;
            font-size: 15px;
        }
        for item[idx] in root.items: Rectangle {
            height: 56px;
            border-radius: 10px;
            border-width: 1px;
            background: idx == root.selected ? #1f6feb : Palette.surface;
            border-color: idx == root.selected ? #4a8bff : Palette.line;
            HorizontalLayout {
                padding-left: 16px;
                Text {
                    text: item;
                    color: Palette.txt;
                    font-size: 18px;
                    vertical-alignment: center;
                }
            }
        }
        Rectangle { vertical-stretch: 1; }
    }
}

export component MainWindow inherits Window {
    title: "TETRA TN UI";
    default-font-family: "Inter";
    default-font-size: 15px;
    preferred-width: 720px;
    preferred-height: 1280px;
    background: @linear-gradient(180deg, #0f1620 0%, #0a0f16 100%);

    in property <DeviceInput> device-input: DeviceInput.Touch;
    property <Screen> screen: Screen.Home;

    // Live state (set from Rust off MsRuntimeState + channel status).
    in property <bool> control-connected;
    in property <bool> telemetry-connected;
    in property <string> reg-state: "Idle";
    in property <string> service-status: "Out of service";
    in property <bool> in-service;
    in property <bool> registered;
    in property <int> signal-bars;
    in property <string> rssi: "--";
    in property <string> issi: "--";
    in property <string> network: "0 / 0";
    in property <string> serving-la: "0";
    in property <string> colour-code: "0";
    in property <int> attached-count;
    in property <bool> scan-active;
    in property <bool> has-codeplug;
    in property <string> talkgroup-name: "No group";
    in property <string> talkgroup-id: "--";
    in property <string> tg-sub: "";
    in property <string> badge: "";
    in property <int> badge-kind;
    in property <bool> can-cycle;
    in property <bool> select-enabled;
    in property <bool> ptt-enabled;
    in property <string> ptt-label: "Register to talk";
    in property <string> folder-name: "Talkgroups";
    in property <int> sel-folder;
    in property <[FolderRow]> folders;
    in property <bool> restart-required;
    in property <string> clock: "--:--:--";
    in property <string> date: "";
    in property <string> dial-number: "";

    callback register;
    callback deregister;
    callback cycle-prev;
    callback cycle-next;
    callback select-talkgroup;
    callback select-folder(int);
    callback ptt;
    callback dial-key(string);
    callback dial-call;

    function screen-title() -> string {
        if (root.screen == Screen.Menu) {
            return "Menu";
        }
        if (root.screen == Screen.Info) {
            return "Radio Info";
        }
        if (root.screen == Screen.Folders) {
            return "Folders";
        }
        if (root.screen == Screen.Dialer) {
            return "Dialer";
        }
        return root.date;
    }

    VerticalLayout {
        StatusBar {
            bars: root.signal-bars;
            network: root.network;
            scan: root.scan-active;
            control-on: root.control-connected;
            telemetry-on: root.telemetry-connected;
            clock: root.clock;
        }

        Header {
            title: root.screen-title();
            muted: root.screen == Screen.Home;
        }

        if root.device-input == DeviceInput.Touch && root.screen == Screen.Home: HomeScreen {
            vertical-stretch: 1;
            has-codeplug: root.has-codeplug;
            folder-name: root.folder-name;
            talkgroup-name: root.talkgroup-name;
            tg-sub: root.tg-sub;
            badge: root.badge;
            badge-kind: root.badge-kind;
            can-cycle: root.can-cycle;
            attached-count: root.attached-count;
            scan-active: root.scan-active;
            select-enabled: root.select-enabled;
            ptt-enabled: root.ptt-enabled;
            ptt-label: root.ptt-label;
            cycle-prev => {
                root.cycle-prev();
            }
            cycle-next => {
                root.cycle-next();
            }
            select-tg => {
                root.select-talkgroup();
            }
            open-folders => {
                root.screen = Screen.Folders;
            }
            ptt => {
                root.ptt();
            }
        }

        if root.device-input == DeviceInput.Touch && root.screen == Screen.Menu: MenuScreen {
            vertical-stretch: 1;
            registered: root.registered;
            open-info => {
                root.screen = Screen.Info;
            }
            register => {
                root.register();
                root.screen = Screen.Home;
            }
            deregister => {
                root.deregister();
                root.screen = Screen.Home;
            }
        }

        if root.device-input == DeviceInput.Touch && root.screen == Screen.Folders: FoldersScreen {
            vertical-stretch: 1;
            folders: root.folders;
            select-folder(i) => {
                root.select-folder(i);
                root.screen = Screen.Home;
            }
        }

        if root.device-input == DeviceInput.Touch && root.screen == Screen.Info: InfoScreen {
            vertical-stretch: 1;
            reg-state: root.reg-state;
            registered: root.registered;
            service-status: root.service-status;
            in-service: root.in-service;
            issi: root.issi;
            network: root.network;
            serving-la: root.serving-la;
            colour-code: root.colour-code;
            rssi: root.rssi;
            attached-count: root.attached-count;
            restart-required: root.restart-required;
        }

        if root.device-input == DeviceInput.Touch && root.screen == Screen.Dialer: DialerScreen {
            vertical-stretch: 1;
            number: root.dial-number;
            key(k) => {
                root.dial-key(k);
            }
            call => {
                root.dial-call();
            }
        }

        if root.device-input == DeviceInput.Keypad: KeypadHome {
            vertical-stretch: 1;
        }

        // Softkey bar (3-column grid), context-dependent.
        Rectangle {
            height: 84px;
            background: @linear-gradient(180deg, #0c141d 0%, #0a1017 100%);
            HorizontalLayout {
                padding-top: 12px;
                padding-bottom: 12px;
                padding-left: 14px;
                padding-right: 14px;
                spacing: 10px;

                if root.screen == Screen.Home: Softkey {
                    text: "Menu";
                    icon: Icons.menu;
                    horizontal-stretch: 1;
                    clicked => {
                        root.screen = Screen.Menu;
                    }
                }
                if root.screen == Screen.Home: Rectangle { horizontal-stretch: 1; }
                if root.screen == Screen.Home: Softkey {
                    text: "Dialer";
                    icon: Icons.phone;
                    horizontal-stretch: 1;
                    clicked => {
                        root.screen = Screen.Dialer;
                    }
                }

                if root.screen != Screen.Home: Softkey {
                    text: "Back";
                    icon: Icons.back;
                    horizontal-stretch: 1;
                    clicked => {
                        root.screen = Screen.Home;
                    }
                }
                if root.screen != Screen.Home: Rectangle { horizontal-stretch: 2; }
            }
        }
    }
}
