// 5 signal bars, heights scaled up, bottom-aligned (web UI .sig).
component SignalBars inherits Rectangle {
    in property <int> bars;
    in property <bool> registered;
    width: 32px;
    height: 20px;
    HorizontalLayout {
        spacing: 2.5px;
        alignment: start;
        for h[i] in [6, 9, 13, 16, 20]: VerticalLayout {
            alignment: end;
            Rectangle {
                width: 4px;
                height: h * 1px;
                border-radius: 1px;
                background: i < root.bars ? (root.registered ? #55d98a : Palette.red) : #35424c;
            }
        }
    }
}

// Rounded channel-link badge with a letter (web UI .lnk).
component LinkBadge inherits Rectangle {
    in property <string> label;
    in property <bool> on;
    width: 24px;
    height: 22px;
    border-radius: 7px;
    background: root.on ? #37c06a2e : #f0555a24;
    Text {
        text: root.label;
        color: root.on ? #79dfa0 : #ff9a9d;
        font-size: 12px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component Battery inherits Rectangle {
    width: 32px;
    height: 16px;
    Rectangle {
        x: 0;
        y: 0;
        width: 28px;
        height: 16px;
        border-width: 1.5px;
        border-color: #7f8f9b;
        border-radius: 3px;
        Rectangle {
            x: 2.5px;
            y: 2.5px;
            width: 17px;
            height: 11px;
            background: Palette.green;
            border-radius: 1px;
        }
    }
    Rectangle {
        x: 28px;
        y: 4.5px;
        width: 3px;
        height: 7px;
        background: #7f8f9b;
        border-radius: 1px;
    }
}

component StatusBar inherits Rectangle {
    in property <int> bars;
    in property <bool> registered;
    in property <bool> registering;
    in property <bool> in-service: true;
    in property <string> network;
    in property <bool> scan;
    in property <bool> control-on;
    in property <bool> telemetry-on;
    // Green only when attached AND in service; red otherwise.
    property <bool> ok: root.registered && root.in-service;
    // Blink phase toggled by a timer while the radio is registering.
    property <bool> blink-on: false;
    height: 70px;
    background: @linear-gradient(180deg, #0e1822 0%, #0b131b 100%);

    blink-timer := Timer {
        interval: 450ms;
        running: root.registering;
        triggered => {
            root.blink-on = !root.blink-on;
        }
    }

    HorizontalLayout {
        padding-left: 18px;
        padding-right: 14px;
        spacing: 12px;

        VerticalLayout {
            alignment: center;
            Icon {
                d: Icons.antenna;
                size: 30px;
                weight: 2.2;
                // Registering: blink red on/off. Otherwise green when OK, red when not.
                tint: root.registering
                    ? (root.blink-on ? Palette.red : #4a1417)
                    : (root.ok ? #55d98a : Palette.red);
            }
        }
        VerticalLayout { alignment: center; SignalBars { bars: root.bars; registered: root.ok; } }
        VerticalLayout {
            alignment: center;
            Text {
                text: root.network;
                color: Palette.muted;
                font-size: 15px;
                font-weight: 500;
                vertical-alignment: center;
            }
        }
        VerticalLayout { alignment: center; LinkBadge { label: "C"; on: root.control-on; } }
        VerticalLayout { alignment: center; LinkBadge { label: "T"; on: root.telemetry-on; } }
        if root.scan: VerticalLayout {
            alignment: center;
            Text {
                text: "SCAN";
                color: Palette.accent;
                font-size: 13px;
                font-weight: 800;
                letter-spacing: 1.5px;
                vertical-alignment: center;
            }
        }

        Rectangle { horizontal-stretch: 1; }

        // Battery pinned flush to the far right (time lives in the header below).
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;
            Battery { }
        }
    }
}

component Header inherits Rectangle {
    in property <string> title;
    in property <bool> muted;
    height: 60px;
    background: @linear-gradient(180deg, #0e1822 0%, #0b131b 100%);
    Text {
        text: root.title;
        color: root.muted ? Palette.muted : Palette.txt;
        font-size: 19px;
        font-weight: root.muted ? 500 : 600;
        letter-spacing: root.muted ? 1px : 0.3px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component CyclerArrow inherits Rectangle {
    in property <bool> right;
    in property <bool> enabled: true;
    callback clicked;
    width: 96px;
    height: 208px;
    border-radius: 20px;
    border-width: 1px;
    border-color: Palette.line2;
    background: touch.pressed ? #1b2836 : @linear-gradient(160deg, #17222f 0%, #0f1822 100%);
    opacity: root.enabled ? 1.0 : 0.3;
    touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            root.clicked();
        }
    }
    Icon {
        x: (parent.width - self.width) / 2 + (root.right ? 2px : -2px);
        y: (parent.height - self.height) / 2;
        d: root.right ? Icons.chevron : Icons.back;
        tint: #cfe0ec;
        size: 48px;
        weight: 2.6;
    }
}

component FolderButton inherits Rectangle {
    in property <string> name;
    callback clicked;
    height: 52px;
    border-radius: 14px;
    border-width: 1px;
    border-color: Palette.line;
    background: touch.pressed ? #1b2836 : Palette.surface;
    horizontal-stretch: 0;
    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }
    HorizontalLayout {
        padding-left: 18px;
        padding-right: 16px;
        spacing: 10px;
        alignment: center;
        VerticalLayout { alignment: center; Icon { d: Icons.folder; tint: Palette.accent; size: 18px; } }
        Text {
            text: root.name;
            color: #cfe0ec;
            font-size: 17px;
            font-weight: 600;
            vertical-alignment: center;
        }
        VerticalLayout { alignment: center; Icon { d: Icons.chevron-down; tint: Palette.faint; size: 16px; } }
    }
}

component Badge inherits Rectangle {
    in property <string> text;
    in property <color> fg;
    in property <color> bg;
    height: 36px;
    border-radius: 11px;
    background: root.bg;
    HorizontalLayout {
        padding-left: 18px;
        padding-right: 18px;
        Text {
            text: root.text;
            color: root.fg;
            font-size: 15px;
            font-weight: 800;
            letter-spacing: 1.5px;
            vertical-alignment: center;
        }
    }
}

component PrimaryButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    in property <string> icon: Icons.check;
    callback clicked;
    height: 64px;
    border-radius: 16px;
    border-width: 1px;
    border-color: root.enabled ? #37c06a80 : Palette.line;
    background: root.enabled
        ? (touch.pressed ? #16321f : @linear-gradient(180deg, #16351f 0%, #10281a 100%))
        : Palette.surface;
    opacity: root.enabled ? 1.0 : 0.45;
    touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            root.clicked();
        }
    }
    HorizontalLayout {
        alignment: center;
        spacing: 10px;
        VerticalLayout {
            alignment: center;
            Icon { d: root.icon; tint: root.enabled ? #8fe6ab : Palette.muted; size: 20px; }
        }
        Text {
            text: root.text;
            color: root.enabled ? #8fe6ab : Palette.muted;
            font-size: 18px;
            font-weight: 700;
            vertical-alignment: center;
        }
    }
}

component DangerButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    in property <string> icon: Icons.trash;
    callback clicked;
    height: 64px;
    border-radius: 16px;
    border-width: 1px;
    border-color: root.enabled ? #f0555a80 : Palette.line;
    background: root.enabled
        ? (touch.pressed ? #3a1618 : @linear-gradient(180deg, #3a1618 0%, #2a1013 100%))
        : Palette.surface;
    opacity: root.enabled ? 1.0 : 0.45;
    touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            root.clicked();
        }
    }
    HorizontalLayout {
        alignment: center;
        spacing: 10px;
        VerticalLayout {
            alignment: center;
            Icon { d: root.icon; tint: root.enabled ? #ff9a9d : Palette.muted; size: 20px; }
        }
        Text {
            text: root.text;
            color: root.enabled ? #ff9a9d : Palette.muted;
            font-size: 18px;
            font-weight: 700;
            vertical-alignment: center;
        }
    }
}

component SecondaryButton inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <bool> danger: false;
    callback clicked;
    height: 64px;
    border-radius: 14px;
    border-width: 1px;
    border-color: root.danger ? #f0555a80 : Palette.line2;
    background: touch.pressed ? (root.danger ? #3a1a1c : #1b2836) : Palette.surface;
    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }
    HorizontalLayout {
        alignment: center;
        spacing: 10px;
        VerticalLayout {
            alignment: center;
            if root.icon != "": Icon { d: root.icon; tint: root.danger ? Palette.red : Palette.txt; size: 20px; }
        }
        Text {
            text: root.text;
            color: root.danger ? #ff9a9d : Palette.txt;
            font-size: 17px;
            font-weight: 600;
            vertical-alignment: center;
        }
    }
}

// Docked push-to-talk button. `state`: 0 idle, 1 requesting, 2 on air, 3 locked.
component Ptt inherits Rectangle {
    in property <string> text;
    in property <string> sub;
    in property <bool> enabled;
    in property <int> state;
    callback press-down;
    callback release;
    height: 138px;
    border-radius: 22px;
    border-width: 1px;
    border-color: root.state == 2 ? #ff5a5f
        : root.state == 1 ? #e6b53f
        : (root.enabled ? Palette.line2 : #ffffff1f);
    background: root.state == 2
        ? @linear-gradient(180deg, #d23b41 0%, #a82a2f 100%)
        : root.state == 1
            ? @linear-gradient(180deg, #7a5f1e 0%, #5c470f 100%)
            : (root.enabled
                ? (touch.pressed ? @linear-gradient(180deg, #24303d 0%, #1a2430 100%)
                                 : @linear-gradient(180deg, #1a2430 0%, #131b24 100%))
                : @linear-gradient(180deg, #1b1d22 0%, #141519 100%));
    opacity: root.enabled ? 1.0 : 0.7;
    touch := TouchArea {
        enabled: root.enabled;
        pointer-event(ev) => {
            if (ev.kind == PointerEventKind.down) {
                root.press-down();
            }
            if (ev.kind == PointerEventKind.up) {
                root.release();
            }
        }
    }
    HorizontalLayout {
        alignment: center;
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            Icon { d: Icons.mic; tint: root.enabled ? Palette.txt : Palette.muted; size: 34px; }
        }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            Text {
                text: root.text;
                color: root.enabled ? Palette.txt : Palette.muted;
                font-size: 18px;
                font-weight: 700;
                letter-spacing: 0.4px;
                horizontal-alignment: center;
            }
            if root.sub != "": Text {
                text: root.sub;
                color: root.enabled ? #b9ccd8 : Palette.muted;
                font-size: 13px;
                font-weight: 600;
                horizontal-alignment: center;
                overflow: elide;
            }
        }
    }
}

component Softkey inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <bool> danger;
    in property <bool> enabled: true;
    in property <int> badge-count;
    callback clicked;
    border-radius: 14px;
    border-width: 1px;
    border-color: root.danger ? #b5343a : Palette.line;
    background: root.danger
        ? @linear-gradient(180deg, #d23b41 0%, #a82a2f 100%)
        : (touch.pressed ? #16202b : Palette.surface);
    opacity: root.enabled ? 1.0 : 0.35;
    touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            root.clicked();
        }
    }
    HorizontalLayout {
        alignment: center;
        spacing: 8px;
        VerticalLayout {
            alignment: center;
            if root.icon != "": Icon {
                d: root.icon;
                tint: root.danger ? #ffffff : Palette.txt;
                size: 22px;
            }
        }
        Text {
            text: root.text;
            color: root.danger ? #ffffff : Palette.txt;
            font-size: 18px;
            font-weight: 600;
            vertical-alignment: center;
        }
    }
    if root.badge-count > 0: Rectangle {
        x: parent.width - self.width + 8px;
        y: -8px;
        width: max(20px, txt.preferred-width + 10px);
        height: 20px;
        border-radius: 8px;
        background: Palette.red;
        border-width: 2px;
        border-color: #0b1017;
        txt := Text {
            text: root.badge-count > 99 ? "99+" : root.badge-count;
            color: #ffffff;
            font-size: 11px;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

component InfoRow inherits HorizontalLayout {
    in property <string> label;
    in property <string> value;
    in property <color> value-color: Palette.txt;
    height: 46px;
    Text {
        text: root.label;
        color: Palette.muted;
        font-size: 17px;
        vertical-alignment: center;
    }
    Rectangle { horizontal-stretch: 1; }
    Text {
        text: root.value;
        color: root.value-color;
        font-size: 17px;
        font-weight: 600;
        vertical-alignment: center;
        horizontal-alignment: right;
    }
}

// Unified list row used across Menu, Folders and the Event Log.
component ListRow inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    in property <string> icon;
    in property <color> icon-tint: Palette.accent;
    in property <bool> danger;
    in property <string> trailing-text;
    in property <bool> selected;
    in property <bool> show-chevron: true;
    callback clicked;
    height: 92px;
    border-radius: 16px;
    border-width: 1px;
    border-color: root.selected ? #33a7dd80 : Palette.line;
    background: touch.pressed ? #16202b : (root.selected ? #33a7dd1a : Palette.surface);
    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }
    HorizontalLayout {
        padding-left: 18px;
        padding-right: 18px;
        spacing: 16px;
        if root.icon != "": VerticalLayout {
            alignment: center;
            Rectangle {
                width: 54px;
                height: 54px;
                border-radius: 15px;
                background: root.danger ? #f0555a1f : #33a7dd1f;
                Icon {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    d: root.icon;
                    tint: root.danger ? Palette.red : root.icon-tint;
                    size: 27px;
                }
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 4px;
            horizontal-stretch: 1;
            Text {
                text: root.title;
                color: root.danger ? #ff9a9d : Palette.txt;
                font-size: 21px;
                font-weight: 600;
                overflow: elide;
            }
            if root.subtitle != "": Text {
                text: root.subtitle;
                color: Palette.muted;
                font-size: 15px;
                overflow: elide;
            }
        }
        if root.trailing-text != "": VerticalLayout {
            alignment: center;
            Text {
                text: root.trailing-text;
                color: Palette.faint;
                font-size: 15px;
                font-weight: 600;
            }
        }
        if root.selected: VerticalLayout {
            alignment: center;
            Icon { d: Icons.check; tint: Palette.accent; size: 26px; }
        }
        if root.show-chevron && !root.selected && root.trailing-text == "": VerticalLayout {
            alignment: center;
            Icon { d: Icons.chevron; tint: Palette.faint; size: 22px; }
        }
    }
}

// ---- Home screen: talkgroup cycler + select action + docked PTT ----
component HomeScreen inherits Rectangle {
    in property <bool> has-codeplug;
    in property <string> folder-name;
    in property <string> home-display;
    in property <string> talkgroup-name;
    in property <string> tg-sub;
    in property <string> badge;
    in property <int> badge-kind; // 0 not-selected, 1 scanning, 2 on-air
    in property <bool> can-cycle;
    in property <int> attached-count;
    in property <bool> scan-active;
    in property <bool> select-enabled;
    in property <bool> show-cancel;
    in property <bool> ptt-enabled;
    in property <string> ptt-label;
    in property <bool> group-call-active;
    in property <string> group-call-name;
    in property <string> group-call-status;
    in property <string> group-talker-id;
    in property <int> group-ptt-state;
    callback cycle-prev;
    callback cycle-next;
    callback select-tg;
    callback cancel-select;
    callback open-folders;
    callback ptt;
    callback group-ptt-down;
    callback group-ptt-up;
    callback hangup-group;

    property <color> badge-fg: root.badge-kind == 2 ? #ff9a9d : (root.badge-kind == 1 ? #7ecbef : Palette.muted);
    property <color> badge-bg: root.badge-kind == 2 ? #d23b4133 : (root.badge-kind == 1 ? #33a7dd29 : #ffffff10);

    background: transparent;

    VerticalLayout {
        padding: 22px;
        spacing: 18px;

        // Home-mode display: operator banner pushed by the network, shown above
        // the selected talkgroup. Only present when the network has sent text.
        if root.home-display != "": Rectangle {
            height: hd-row.preferred-height + 24px;
            border-radius: 14px;
            border-width: 1px;
            border-color: #33a7dd3d;
            background: #12212e;
            hd-row := HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                padding-top: 12px;
                padding-bottom: 12px;
                spacing: 12px;
                VerticalLayout {
                    alignment: center;
                    Icon { d: Icons.info; tint: Palette.accent; size: 22px; }
                }
                Text {
                    text: root.home-display;
                    color: #dbeafc;
                    font-size: 20px;
                    font-weight: 600;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    wrap: word-wrap;
                }
            }
        }

        // Cycler group, vertically centered. Replaced by the group-call panel
        // while a group call is up.
        Rectangle {
            vertical-stretch: 1;
            if root.group-call-active: VerticalLayout {
                alignment: center;
                spacing: 14px;
                HorizontalLayout {
                    alignment: center;
                    Rectangle {
                        height: 30px;
                        border-radius: 10px;
                        background: #d23b4133;
                        HorizontalLayout {
                            padding-left: 16px;
                            padding-right: 16px;
                            Text {
                                text: "GROUP IN USE";
                                color: #ff9a9d;
                                font-size: 13px;
                                font-weight: 800;
                                letter-spacing: 2px;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
                Text {
                    text: root.group-call-name;
                    color: #f2f7fb;
                    font-size: 52px;
                    font-weight: 800;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
                Text {
                    text: root.group-call-status;
                    color: Palette.muted;
                    font-size: 17px;
                    font-weight: 600;
                    horizontal-alignment: center;
                }
                if root.group-talker-id != "": Text {
                    text: root.group-talker-id;
                    color: #cfe9ff;
                    font-size: 26px;
                    font-weight: 700;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
            }

            if !root.group-call-active: VerticalLayout {
                alignment: center;
                spacing: 20px;

                if root.has-codeplug: HorizontalLayout {
                    alignment: center;
                    FolderButton {
                        name: root.folder-name;
                        clicked => {
                            root.open-folders();
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 12px;
                    CyclerArrow {
                        right: false;
                        enabled: root.can-cycle;
                        clicked => {
                            root.cycle-prev();
                        }
                    }
                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: center;
                        spacing: 8px;
                        Text {
                            text: root.talkgroup-name;
                            color: #f2f7fb;
                            font-size: 64px;
                            font-weight: 800;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                        }
                        Text {
                            text: root.tg-sub;
                            color: Palette.muted;
                            font-size: 21px;
                            font-weight: 600;
                            horizontal-alignment: center;
                        }
                        if root.badge != "": HorizontalLayout {
                            alignment: center;
                            Badge { text: root.badge; fg: root.badge-fg; bg: root.badge-bg; }
                        }
                    }
                    CyclerArrow {
                        right: true;
                        enabled: root.can-cycle;
                        clicked => {
                            root.cycle-next();
                        }
                    }
                }

                // Select-talkgroup action, directly below the cycler. A Cancel
                // button appears beside it when a TX group is active, snapping
                // the cycler back to that group.
                if root.has-codeplug: HorizontalLayout {
                    spacing: 10px;
                    PrimaryButton {
                        horizontal-stretch: 1;
                        text: root.badge-kind == 2 ? "On air" : "Select talkgroup";
                        enabled: root.select-enabled;
                        clicked => {
                            root.select-tg();
                        }
                    }
                    if root.show-cancel: SecondaryButton {
                        horizontal-stretch: 1;
                        text: "Cancel";
                        clicked => {
                            root.cancel-select();
                        }
                    }
                }

                if root.scan-active: HorizontalLayout {
                    alignment: center;
                    Rectangle {
                        height: 40px;
                        border-radius: 12px;
                        background: #33a7dd29;
                        HorizontalLayout {
                            padding-left: 16px;
                            padding-right: 16px;
                            Text {
                                text: "SCAN - " + root.attached-count + " groups";
                                color: #7ecbef;
                                font-size: 13px;
                                font-weight: 700;
                                letter-spacing: 1px;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }

        // Fixed PTT dock: drives the group-call floor (press to key, release to
        // cease). Its look reflects the current floor state.
        Ptt {
            text: root.group-ptt-state == 2 ? "ON AIR"
                : root.group-ptt-state == 1 ? "Requesting..."
                : root.group-ptt-state == 3 ? "Floor busy"
                : root.ptt-label;
            enabled: root.ptt-enabled;
            state: root.group-ptt-state;
            press-down => {
                root.group-ptt-down();
            }
            release => {
                root.group-ptt-up();
            }
        }
    }
}

component MenuScreen inherits Rectangle {
    in property <bool> registered;
    in property <int> unread;
    in property <int> unread-messages;
    in property <int> missed-calls;
    in property <bool> show-event-log: true;
    callback open-info;
    callback open-logs;
    callback open-groups;
    callback open-contacts;
    callback open-messages;
    callback open-recents;
    callback open-config;
    callback open-program;
    callback open-settings;
    callback open-survey;
    callback open-network;
    background: transparent;
    VerticalLayout {
        padding: 18px;
        spacing: 12px;
        alignment: start;
        ListRow {
            title: "Messages";
            subtitle: root.unread-messages > 0 ? root.unread-messages + " unread messages" : "Send and read text messages";
            icon: Icons.message;
            clicked => {
                root.open-messages();
            }
        }
        ListRow {
            title: "Recents";
            subtitle: root.missed-calls > 0 ? root.missed-calls + " missed calls" : "Call history and redial";
            icon: Icons.phone;
            trailing-text: root.missed-calls > 0 ? root.missed-calls : "";
            clicked => {
                root.open-recents();
            }
        }
        ListRow {
            title: "Talkgroups";
            subtitle: "Select, scan, attach and detach groups";
            icon: Icons.users;
            clicked => {
                root.open-groups();
            }
        }
        ListRow {
            title: "Network";
            subtitle: "Registration, signal and cell survey";
            icon: Icons.radio;
            clicked => {
                root.open-network();
            }
        }
        if root.show-event-log: ListRow {
            title: "Event Log";
            subtitle: root.unread > 0 ? root.unread + " new events" : "Telemetry events";
            icon: Icons.logs;
            clicked => {
                root.open-logs();
            }
        }
        ListRow {
            title: "Contacts";
            subtitle: "Phone book: call people and gateways";
            icon: Icons.phone;
            clicked => {
                root.open-contacts();
            }
        }
        ListRow {
            title: "Config";
            subtitle: "View and apply the device configuration";
            icon: Icons.gear;
            clicked => {
                root.open-config();
            }
        }
        ListRow {
            title: "Programming";
            subtitle: "Edit the codeplug: networks, groups, contacts";
            icon: Icons.folder;
            clicked => {
                root.open-program();
            }
        }
        ListRow {
            title: "Settings";
            subtitle: "Ringtones and app preferences";
            icon: Icons.gear;
            clicked => {
                root.open-settings();
            }
        }
    }
}

component LogsScreen inherits Rectangle {
    in property <[LogRow]> logs;
    callback open(string, string, string);
    background: transparent;
    // Flickable is the direct child so it fills the screen; the softkey bar below
    // it stays pinned to the bottom regardless of how many rows there are.
    Flickable {
        viewport-height: col.preferred-height;
        col := VerticalLayout {
            padding: 16px;
            spacing: 10px;
            alignment: start;
            if root.logs.length == 0: Text {
                text: "No events yet";
                color: Palette.muted;
                font-size: 16px;
                horizontal-alignment: center;
            }
            for e in root.logs: ListRow {
                title: e.variant;
                subtitle: e.summary;
                icon: Icons.logs;
                trailing-text: e.time;
                clicked => {
                    root.open(e.variant, e.time, e.detail);
                }
            }
        }
    }
}

component LogDetailScreen inherits Rectangle {
    in property <string> variant;
    in property <string> time;
    in property <string> body;
    background: transparent;
    VerticalLayout {
        padding: 16px;
        spacing: 12px;
        HorizontalLayout {
            spacing: 12px;
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 48px;
                    height: 48px;
                    border-radius: 13px;
                    background: #33a7dd1f;
                    Icon {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        d: Icons.logs;
                        tint: Palette.accent;
                        size: 24px;
                    }
                }
            }
            VerticalLayout {
                alignment: center;
                spacing: 2px;
                horizontal-stretch: 1;
                Text {
                    text: root.variant;
                    color: Palette.txt;
                    font-size: 20px;
                    font-weight: 700;
                    overflow: elide;
                }
                Text {
                    text: "Received " + root.time;
                    color: Palette.muted;
                    font-size: 14px;
                }
            }
        }
        Rectangle {
            vertical-stretch: 1;
            border-radius: 14px;
            border-width: 1px;
            border-color: Palette.line;
            background: #070d14;
            Flickable {
                viewport-height: body-text.preferred-height + 24px;
                body-text := Text {
                    x: 14px;
                    y: 12px;
                    width: parent.width - 28px;
                    text: root.body;
                    color: #b9ccd8;
                    font-size: 14px;
                    font-family: "Consolas";
                    wrap: word-wrap;
                }
            }
        }
    }
}

component AlertOverlay inherits Rectangle {
    in property <string> title;
    in property <string> message;
    in property <int> kind; // 0 amber, 1 red, 2 green
    callback dismiss;
    width: 100%;
    height: 100%;
    background: #03070ce0;

    property <color> tint: root.kind == 1 ? Palette.red : (root.kind == 2 ? Palette.green : Palette.amber);
    property <color> tint-soft: root.kind == 1 ? #f0555a29 : (root.kind == 2 ? #37c06a29 : #e7a72b29);
    property <string> glyph: root.kind == 1 ? Icons.alert : (root.kind == 2 ? Icons.check : Icons.info);

    TouchArea {
        clicked => {
            root.dismiss();
        }
    }

    Rectangle {
        width: Math.min(parent.width - 32px, 480px);
        height: card.preferred-height;
        background: #16212e;
        border-radius: 24px;
        border-width: 2px;
        border-color: root.tint;
        drop-shadow-blur: 40px;
        drop-shadow-color: #000000b0;
        // Swallow taps on the card so they don't dismiss via the scrim.
        TouchArea { }
        card := VerticalLayout {
            padding: 34px;
            spacing: 22px;
            alignment: start;
            HorizontalLayout {
                alignment: center;
                Rectangle {
                    width: 92px;
                    height: 92px;
                    border-radius: 46px;
                    background: root.tint-soft;
                    border-width: 2px;
                    border-color: root.tint;
                    Icon {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        d: root.glyph;
                        tint: root.tint;
                        size: 46px;
                    }
                }
            }
            Text {
                text: root.title;
                color: #ffffff;
                font-size: 28px;
                font-weight: 800;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
            if root.message != "": Text {
                text: root.message;
                color: #d7e2ec;
                font-size: 22px;
                font-weight: 500;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
            Rectangle {
                height: 64px;
                border-radius: 16px;
                background: okt.pressed ? root.tint.darker(15%) : root.tint;
                okt := TouchArea {
                    clicked => {
                        root.dismiss();
                    }
                }
                Text {
                    text: "OK";
                    color: #0b131c;
                    font-size: 22px;
                    font-weight: 800;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
    }
}

// Modal confirm dialog for destructive actions, styled like AlertOverlay.
// `confirm` runs the action; tapping the scrim or Cancel dismisses.
component ConfirmOverlay inherits Rectangle {
    in property <string> title;
    in property <string> message;
    in property <string> confirm-label: "Delete";
    callback confirm;
    callback cancel;
    width: 100%;
    height: 100%;
    background: #03070ce0;

    TouchArea {
        clicked => {
            root.cancel();
        }
    }

    Rectangle {
        width: Math.min(parent.width - 32px, 480px);
        height: card.preferred-height;
        background: #16212e;
        border-radius: 24px;
        border-width: 2px;
        border-color: Palette.red;
        drop-shadow-blur: 40px;
        drop-shadow-color: #000000b0;
        // Swallow taps on the card so they don't dismiss via the scrim.
        TouchArea { }
        card := VerticalLayout {
            padding: 34px;
            spacing: 22px;
            alignment: start;
            HorizontalLayout {
                alignment: center;
                Rectangle {
                    width: 92px;
                    height: 92px;
                    border-radius: 46px;
                    background: #f0555a29;
                    border-width: 2px;
                    border-color: Palette.red;
                    Icon {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        d: Icons.trash;
                        tint: Palette.red;
                        size: 44px;
                    }
                }
            }
            Text {
                text: root.title;
                color: #ffffff;
                font-size: 28px;
                font-weight: 800;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
            if root.message != "": Text {
                text: root.message;
                color: #d7e2ec;
                font-size: 22px;
                font-weight: 500;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
            HorizontalLayout {
                spacing: 12px;
                SecondaryButton {
                    text: "Cancel";
                    icon: Icons.close;
                    horizontal-stretch: 1;
                    clicked => {
                        root.cancel();
                    }
                }
                DangerButton {
                    text: root.confirm-label;
                    icon: Icons.trash;
                    horizontal-stretch: 1;
                    clicked => {
                        root.confirm();
                    }
                }
            }
        }
    }
}

component InfoScreen inherits Rectangle {
    in property <string> reg-state;
    in property <bool> registered;
    in property <string> service-status;
    in property <bool> in-service;
    in property <string> issi;
    in property <string> network;
    in property <string> serving-la;
    in property <string> colour-code;
    in property <string> rssi;
    in property <int> attached-count;
    in property <bool> restart-required;
    background: transparent;
    VerticalLayout {
        padding: 18px;
        spacing: 12px;
        alignment: start;
        Rectangle {
            background: Palette.surface;
            border-radius: 16px;
            border-width: 1px;
            border-color: Palette.line;
            VerticalLayout {
                padding: 18px;
                spacing: 2px;
                InfoRow {
                    label: "Registration";
                    value: root.reg-state;
                    value-color: root.registered ? Palette.green : Palette.muted;
                }
                InfoRow {
                    label: "Service";
                    value: root.service-status;
                    value-color: root.in-service ? Palette.green : Palette.red;
                }
                InfoRow { label: "Own ISSI"; value: root.issi; }
                InfoRow { label: "Network (MCC/MNC)"; value: root.network; }
                InfoRow { label: "Serving LA"; value: root.serving-la; }
                InfoRow { label: "Colour code"; value: root.colour-code; }
                InfoRow { label: "Signal"; value: root.rssi; }
                InfoRow { label: "Attached groups"; value: root.attached-count; }
            }
        }
        if root.restart-required: Text {
            text: "Restart required to apply staged config";
            color: Palette.amber;
            font-size: 14px;
            wrap: word-wrap;
        }
    }
}

// Network hub: the radio-info card plus an entry to the cell survey.
component NetworkScreen inherits Rectangle {
    in property <string> reg-state;
    in property <bool> registered;
    in property <string> service-status;
    in property <bool> in-service;
    in property <string> issi;
    in property <string> network;
    in property <string> serving-la;
    in property <string> colour-code;
    in property <string> rssi;
    in property <int> attached-count;
    in property <bool> restart-required;
    callback open-survey;
    callback register;
    callback deregister;
    background: transparent;
    VerticalLayout {
        padding: 18px;
        spacing: 12px;
        alignment: start;
        Rectangle {
            background: Palette.surface;
            border-radius: 16px;
            border-width: 1px;
            border-color: Palette.line;
            VerticalLayout {
                padding: 18px;
                spacing: 2px;
                InfoRow {
                    label: "Registration";
                    value: root.reg-state;
                    value-color: root.registered ? Palette.green : Palette.muted;
                }
                InfoRow {
                    label: "Service";
                    value: root.service-status;
                    value-color: root.in-service ? Palette.green : Palette.red;
                }
                InfoRow { label: "Own ISSI"; value: root.issi; }
                InfoRow { label: "Network (MCC/MNC)"; value: root.network; }
                InfoRow { label: "Serving LA"; value: root.serving-la; }
                InfoRow { label: "Colour code"; value: root.colour-code; }
                InfoRow { label: "Signal"; value: root.rssi; }
                InfoRow { label: "Attached groups"; value: root.attached-count; }
            }
        }
        if root.restart-required: Text {
            text: "Restart required to apply staged config";
            color: Palette.amber;
            font-size: 14px;
            wrap: word-wrap;
        }
        ListRow {
            title: "Cell survey";
            subtitle: "Survey carriers and camp on a cell";
            icon: Icons.radio;
            clicked => {
                root.open-survey();
            }
        }
        ListRow {
            title: root.registered ? "Deregister" : "Register";
            subtitle: root.registered ? "Detach from the network" : "Attach to the network";
            icon: root.registered ? Icons.logout : Icons.login;
            danger: root.registered;
            icon-tint: Palette.green;
            clicked => {
                if (root.registered) {
                    root.deregister();
                } else {
                    root.register();
                }
            }
        }
    }
}

component FoldersScreen inherits Rectangle {
    in property <[FolderRow]> folders;
    callback select-folder(int);
    background: transparent;
    VerticalLayout {
        padding: 18px;
        spacing: 12px;
        alignment: start;
        for f[idx] in root.folders: ListRow {
            title: f.name;
            subtitle: f.count + (f.count == 1 ? " talkgroup" : " talkgroups");
            icon: Icons.folder;
            selected: f.selected;
            clicked => {
                root.select-folder(idx);
            }
        }
    }
}

component Toggle inherits Rectangle {
    in property <bool> on;
    callback toggled(bool);
    width: 66px;
    height: 38px;
    border-radius: 19px;
    border-width: 1px;
    border-color: root.on ? #37c06a80 : Palette.line2;
    background: root.on ? #37c06a3d : #ffffff10;
    TouchArea {
        clicked => {
            root.toggled(!root.on);
        }
    }
    Rectangle {
        width: 30px;
        height: 30px;
        border-radius: 15px;
        x: root.on ? parent.width - self.width - 4px : 4px;
        y: (parent.height - self.height) / 2;
        background: root.on ? #79dfa0 : #8fa3b8;
        animate x { duration: 120ms; easing: ease; }
    }
}

component TagPill inherits Rectangle {
    in property <int> tag; // 1 scan, 2 tx
    height: 22px;
    border-radius: 8px;
    background: root.tag == 2 ? #37c06a2e : #33a7dd29;
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        Text {
            text: root.tag == 2 ? "TX" : "SCAN";
            color: root.tag == 2 ? #79dfa0 : #7ecbef;
            font-size: 11px;
            font-weight: 800;
            letter-spacing: 0.8px;
            vertical-alignment: center;
        }
    }
}

component GroupRowView inherits Rectangle {
    in property <string> name;
    in property <string> sub;
    in property <int> tag;
    in property <bool> attached;
    in property <bool> is-tx;
    callback select;
    callback add;
    callback detach;
    height: 84px;
    border-radius: 16px;
    border-width: 1px;
    border-color: root.is-tx ? #37c06a55 : Palette.line;
    background: touch.pressed ? #16202b : Palette.surface;
    touch := TouchArea {
        clicked => {
            root.select();
        }
    }
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 12px;
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            spacing: 5px;
            horizontal-stretch: 1;
            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                Text {
                    text: root.name;
                    color: Palette.txt;
                    font-size: 19px;
                    font-weight: 600;
                    overflow: elide;
                }
                if root.tag > 0: VerticalLayout { alignment: center; TagPill { tag: root.tag; } }
                Rectangle { horizontal-stretch: 1; }
            }
            Text {
                text: root.sub;
                color: Palette.muted;
                font-size: 14px;
                overflow: elide;
            }
        }
        if !root.is-tx: VerticalLayout {
            alignment: center;
            Rectangle {
                width: 48px;
                height: 48px;
                border-radius: 13px;
                border-width: 1px;
                border-color: Palette.line2;
                background: act.pressed
                    ? #24303d
                    : (root.attached ? #f0555a1f : #37c06a1f);
                act := TouchArea {
                    clicked => {
                        if (root.attached) {
                            root.detach();
                        } else {
                            root.add();
                        }
                    }
                }
                Icon {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    d: root.attached ? Icons.minus : Icons.plus;
                    tint: root.attached ? #ff9a9d : #79dfa0;
                    size: 24px;
                }
            }
        }
    }
}

component ScanRowView inherits Rectangle {
    in property <string> name;
    in property <string> sub;
    in property <bool> active;
    callback toggled(bool);
    height: 76px;
    border-radius: 16px;
    border-width: 1px;
    border-color: root.active ? #37c06a55 : Palette.line;
    background: Palette.surface;
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            spacing: 3px;
            horizontal-stretch: 1;
            Text {
                text: root.name;
                color: Palette.txt;
                font-size: 18px;
                font-weight: 600;
                overflow: elide;
            }
            if root.sub != "": Text {
                text: root.sub;
                color: Palette.muted;
                font-size: 13px;
                overflow: elide;
            }
        }
        VerticalLayout {
            alignment: center;
            Toggle {
                on: root.active;
                toggled(v) => {
                    root.toggled(v);
                }
            }
        }
    }
}

component SectionHeader inherits Text {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 2px;
    color: Palette.faint;
}

component GroupsScreen inherits Rectangle {
    in property <[GroupRow]> groups;
    in property <[ScanRow]> scanlists;
    callback select(int, int);
    callback add(int, int);
    callback detach(int);
    callback toggle-scan(string, bool);
    background: transparent;
    Flickable {
        viewport-height: col.preferred-height;
        col := VerticalLayout {
            padding: 16px;
            spacing: 10px;
            alignment: start;
            if root.groups.length == 0: Text {
                text: "No talkgroups programmed";
                color: Palette.muted;
                font-size: 16px;
                horizontal-alignment: center;
            }
            if root.scanlists.length > 0: SectionHeader { text: "SCAN LISTS"; }
            for s in root.scanlists: ScanRowView {
                name: s.name;
                sub: s.sub;
                active: s.active;
                toggled(v) => {
                    root.toggle-scan(s.name, v);
                }
            }
            if root.scanlists.length > 0 && root.groups.length > 0: SectionHeader {
                text: "TALKGROUPS";
            }
            for g in root.groups: GroupRowView {
                name: g.name;
                sub: g.sub;
                tag: g.tag;
                attached: g.attached;
                is-tx: g.is-tx;
                select => {
                    root.select(g.gssi, g.cou);
                }
                add => {
                    root.add(g.gssi, g.cou);
                }
                detach => {
                    root.detach(g.gssi);
                }
            }
        }
    }
}

// One contact row: tap the body to open the detail page, tap the green side
// button for a fast duplex call.
component ContactRowView inherits Rectangle {
    in property <string> title;
    in property <string> sub;
    in property <int> kind;
    callback open;
    callback call;
    height: 92px;
    border-radius: 16px;
    border-width: 1px;
    border-color: Palette.line;
    clip: true;
    background: Palette.surface;
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 96px;
        spacing: 12px;
        // Body (icon + text) opens the detail page.
        body := Rectangle {
            horizontal-stretch: 1;
            btouch := TouchArea {
                clicked => {
                    root.open();
                }
            }
            HorizontalLayout {
                spacing: 14px;
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 50px;
                        height: 50px;
                        border-radius: 14px;
                        background: #33a7dd1f;
                        Icon {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            d: root.kind == 1 ? Icons.phone : Icons.users;
                            tint: Palette.accent;
                            size: 26px;
                        }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    spacing: 4px;
                    horizontal-stretch: 1;
                    Text {
                        text: root.title;
                        color: Palette.txt;
                        font-size: 21px;
                        font-weight: 600;
                        overflow: elide;
                    }
                    Text {
                        text: root.sub;
                        color: Palette.muted;
                        font-size: 15px;
                        overflow: elide;
                    }
                }
            }
        }
    }
    // Green call button filling the whole right end of the card (clip rounds it).
    Rectangle {
        x: parent.width - self.width;
        y: 0;
        width: 84px;
        height: parent.height;
        background: ctouch.pressed ? #16321f : #10281a;
        // Left divider between the content and the call button.
        Rectangle {
            x: 0;
            width: 1px;
            height: parent.height;
            background: #37c06a4d;
        }
        ctouch := TouchArea {
            clicked => {
                root.call();
            }
        }
        Icon {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            d: Icons.phone;
            tint: Palette.green;
            size: 28px;
        }
    }
}

component TargetSeg inherits Rectangle {
    in property <string> label;
    in property <bool> selected;
    callback clicked;
    height: 54px;
    min-width: 110px;
    horizontal-stretch: 1;
    border-radius: 12px;
    border-width: 1px;
    border-color: root.selected ? Palette.accent : Palette.line2;
    background: root.selected ? #33a7dd29 : Palette.surface;
    TouchArea {
        clicked => {
            root.clicked();
        }
    }
    Text {
        width: parent.width - 12px;
        height: 100%;
        text: root.label;
        color: root.selected ? #9fd3ef : Palette.muted;
        font-size: 16px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }
}

// Dialer-style selector: Private + one button per gateway, equal-width buttons
// up to 4 per row and 2 rows. Shared by the dialer and the contact editor.
component TargetSelector inherits VerticalLayout {
    in property <[DialTarget]> targets;
    in property <int> sel;
    callback selected(int);
    spacing: 8px;
    HorizontalLayout {
        spacing: 8px;
        if root.targets.length > 0: TargetSeg { label: root.targets[0].label; selected: root.sel == 0; clicked => { root.selected(0); } }
        if root.targets.length > 1: TargetSeg { label: root.targets[1].label; selected: root.sel == 1; clicked => { root.selected(1); } }
        if root.targets.length > 2: TargetSeg { label: root.targets[2].label; selected: root.sel == 2; clicked => { root.selected(2); } }
        if root.targets.length > 3: TargetSeg { label: root.targets[3].label; selected: root.sel == 3; clicked => { root.selected(3); } }
    }
    if root.targets.length > 4: HorizontalLayout {
        spacing: 8px;
        TargetSeg { label: root.targets[4].label; selected: root.sel == 4; clicked => { root.selected(4); } }
        if root.targets.length > 5: TargetSeg { label: root.targets[5].label; selected: root.sel == 5; clicked => { root.selected(5); } }
        if root.targets.length > 6: TargetSeg { label: root.targets[6].label; selected: root.sel == 6; clicked => { root.selected(6); } }
        if root.targets.length > 7: TargetSeg { label: root.targets[7].label; selected: root.sel == 7; clicked => { root.selected(7); } }
    }
}

component ContactDetailScreen inherits Rectangle {
    in property <string> name;
    in property <string> callsign;
    in property <string> sub;
    in property <bool> is-phone;
    callback call-duplex;
    callback call-simplex;
    callback message;
    callback edit;
    callback delete;
    property <bool> del-confirm: false;
    background: transparent;
    VerticalLayout {
        padding: 18px;
        spacing: 14px;
        Rectangle {
            height: 176px;
            border-radius: 18px;
            border-width: 1px;
            border-color: Palette.line;
            background: Palette.surface;
            VerticalLayout {
                alignment: center;
                spacing: 6px;
                HorizontalLayout {
                    alignment: center;
                    Rectangle {
                        width: 66px;
                        height: 66px;
                        border-radius: 20px;
                        background: #33a7dd1f;
                        Icon {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            d: root.is-phone ? Icons.phone : Icons.users;
                            tint: Palette.accent;
                            size: 30px;
                        }
                    }
                }
                Text {
                    text: root.name;
                    color: Palette.txt;
                    font-size: 26px;
                    font-weight: 800;
                    horizontal-alignment: center;
                    overflow: elide;
                }
                if root.callsign != "": Text {
                    text: root.callsign;
                    color: #9fd3ef;
                    font-size: 16px;
                    horizontal-alignment: center;
                }
                Text {
                    text: root.sub;
                    color: Palette.muted;
                    font-size: 15px;
                    horizontal-alignment: center;
                }
            }
        }
        PrimaryButton {
            text: "Call (duplex)";
            icon: Icons.phone;
            clicked => {
                root.call-duplex();
            }
        }
        if !root.is-phone: SecondaryButton {
            text: "Simplex (PTT) call";
            icon: Icons.mic;
            clicked => {
                root.call-simplex();
            }
        }
        if !root.is-phone: SecondaryButton {
            text: "Message";
            icon: Icons.message;
            clicked => {
                root.message();
            }
        }
        Rectangle {
            vertical-stretch: 1;
        }
        HorizontalLayout {
            spacing: 10px;
            SecondaryButton {
                text: "Edit";
                icon: Icons.edit;
                horizontal-stretch: 1;
                clicked => {
                    root.edit();
                }
            }
            SecondaryButton {
                text: "Delete";
                icon: Icons.trash;
                danger: true;
                horizontal-stretch: 1;
                clicked => {
                    root.del-confirm = true;
                }
            }
        }
    }
    if root.del-confirm: ConfirmOverlay {
        title: "Delete contact";
        message: "Delete " + root.name + "? This cannot be undone.";
        confirm-label: "Delete";
        confirm => {
            root.del-confirm = false;
            root.delete();
        }
        cancel => {
            root.del-confirm = false;
        }
    }
}

// One key on the on-screen keyboard.
// A single key styled exactly like the dialer's DialKey, so the on-screen
// keyboard, the editor numeric pad and the in-call DTMF pad all match the dialer.
component KeyCap inherits Rectangle {
    in property <string> label;
    in property <string> icon;
    in property <bool> active;
    in property <bool> enabled: true;
    // When true, show the letter uppercase (QWERTY shift is on).
    in property <bool> caps;
    callback tapped;
    height: 76px;
    horizontal-stretch: 1;
    border-radius: 16px;
    border-width: 1px;
    opacity: root.enabled ? 1.0 : 0.35;
    border-color: root.active ? Palette.accent : Palette.line2;
    background: kt.pressed
        ? #1b2836
        : (root.active ? #33a7dd29 : @linear-gradient(180deg, #17222f 0%, #0f1822 100%));
    kt := TouchArea {
        enabled: root.enabled;
        clicked => {
            root.tapped();
        }
    }
    if root.icon != "": Icon {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        d: root.icon;
        tint: #e8f0f6;
        size: 26px;
    }
    if root.icon == "": Text {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        text: root.caps ? root.label.to-uppercase() : root.label;
        color: #e8f0f6;
        font-size: 26px;
        font-weight: 600;
    }
}

// On-screen keyboard: QWERTY for text fields, numeric pad for digit fields.
// Letters are emitted lowercase; the app applies the shift latch.
component OnScreenKeyboard inherits Rectangle {
    in property <bool> numeric;
    in property <bool> shift;
    // When true (ISSI field), the *, # and + keys are disabled (digits only).
    in property <bool> digits-only;
    callback key(string);
    callback backspace;
    callback shift-toggle;
    VerticalLayout {
        spacing: 6px;
        if !root.numeric: VerticalLayout {
            spacing: 6px;
            HorizontalLayout {
                spacing: 6px;
                KeyCap { label: "1"; tapped => { root.key("1"); } }
                KeyCap { label: "2"; tapped => { root.key("2"); } }
                KeyCap { label: "3"; tapped => { root.key("3"); } }
                KeyCap { label: "4"; tapped => { root.key("4"); } }
                KeyCap { label: "5"; tapped => { root.key("5"); } }
                KeyCap { label: "6"; tapped => { root.key("6"); } }
                KeyCap { label: "7"; tapped => { root.key("7"); } }
                KeyCap { label: "8"; tapped => { root.key("8"); } }
                KeyCap { label: "9"; tapped => { root.key("9"); } }
                KeyCap { label: "0"; tapped => { root.key("0"); } }
            }
            HorizontalLayout {
                spacing: 6px;
                KeyCap { label: "q"; caps: root.shift; tapped => { root.key("q"); } }
                KeyCap { label: "w"; caps: root.shift; tapped => { root.key("w"); } }
                KeyCap { label: "e"; caps: root.shift; tapped => { root.key("e"); } }
                KeyCap { label: "r"; caps: root.shift; tapped => { root.key("r"); } }
                KeyCap { label: "t"; caps: root.shift; tapped => { root.key("t"); } }
                KeyCap { label: "y"; caps: root.shift; tapped => { root.key("y"); } }
                KeyCap { label: "u"; caps: root.shift; tapped => { root.key("u"); } }
                KeyCap { label: "i"; caps: root.shift; tapped => { root.key("i"); } }
                KeyCap { label: "o"; caps: root.shift; tapped => { root.key("o"); } }
                KeyCap { label: "p"; caps: root.shift; tapped => { root.key("p"); } }
            }
            HorizontalLayout {
                spacing: 6px;
                Rectangle { width: 22px; }
                KeyCap { label: "a"; caps: root.shift; tapped => { root.key("a"); } }
                KeyCap { label: "s"; caps: root.shift; tapped => { root.key("s"); } }
                KeyCap { label: "d"; caps: root.shift; tapped => { root.key("d"); } }
                KeyCap { label: "f"; caps: root.shift; tapped => { root.key("f"); } }
                KeyCap { label: "g"; caps: root.shift; tapped => { root.key("g"); } }
                KeyCap { label: "h"; caps: root.shift; tapped => { root.key("h"); } }
                KeyCap { label: "j"; caps: root.shift; tapped => { root.key("j"); } }
                KeyCap { label: "k"; caps: root.shift; tapped => { root.key("k"); } }
                KeyCap { label: "l"; caps: root.shift; tapped => { root.key("l"); } }
                Rectangle { width: 22px; }
            }
            HorizontalLayout {
                spacing: 6px;
                KeyCap { label: root.shift ? "SHIFT" : "shift"; active: root.shift; horizontal-stretch: 2; tapped => { root.shift-toggle(); } }
                KeyCap { label: "z"; caps: root.shift; tapped => { root.key("z"); } }
                KeyCap { label: "x"; caps: root.shift; tapped => { root.key("x"); } }
                KeyCap { label: "c"; caps: root.shift; tapped => { root.key("c"); } }
                KeyCap { label: "v"; caps: root.shift; tapped => { root.key("v"); } }
                KeyCap { label: "b"; caps: root.shift; tapped => { root.key("b"); } }
                KeyCap { label: "n"; caps: root.shift; tapped => { root.key("n"); } }
                KeyCap { label: "m"; caps: root.shift; tapped => { root.key("m"); } }
                KeyCap { icon: Icons.backspace; horizontal-stretch: 2; tapped => { root.backspace(); } }
            }
            HorizontalLayout {
                spacing: 6px;
                KeyCap { label: "-"; tapped => { root.key("-"); } }
                KeyCap { label: "space"; horizontal-stretch: 6; tapped => { root.key(" "); } }
                KeyCap { label: "."; tapped => { root.key("."); } }
            }
        }
        if root.numeric: VerticalLayout {
            spacing: 6px;
            HorizontalLayout {
                spacing: 6px;
                KeyCap { label: "1"; tapped => { root.key("1"); } }
                KeyCap { label: "2"; tapped => { root.key("2"); } }
                KeyCap { label: "3"; tapped => { root.key("3"); } }
            }
            HorizontalLayout {
                spacing: 6px;
                KeyCap { label: "4"; tapped => { root.key("4"); } }
                KeyCap { label: "5"; tapped => { root.key("5"); } }
                KeyCap { label: "6"; tapped => { root.key("6"); } }
            }
            HorizontalLayout {
                spacing: 6px;
                KeyCap { label: "7"; tapped => { root.key("7"); } }
                KeyCap { label: "8"; tapped => { root.key("8"); } }
                KeyCap { label: "9"; tapped => { root.key("9"); } }
            }
            HorizontalLayout {
                spacing: 6px;
                KeyCap { label: "*"; enabled: !root.digits-only; tapped => { root.key("*"); } }
                KeyCap { label: "0"; tapped => { root.key("0"); } }
                KeyCap { label: "#"; enabled: !root.digits-only; tapped => { root.key("#"); } }
            }
            HorizontalLayout {
                spacing: 6px;
                KeyCap { label: "+"; enabled: !root.digits-only; tapped => { root.key("+"); } }
                KeyCap { icon: Icons.backspace; horizontal-stretch: 2; tapped => { root.backspace(); } }
            }
        }
    }
}

// A labelled, tappable form field showing its current value.
component EditFieldRow inherits Rectangle {
    in property <string> label;
    in property <string> text;
    in property <string> placeholder;
    in property <bool> focused;
    callback pick;
    height: 58px;
    border-radius: 12px;
    border-width: root.focused ? 2px : 1px;
    border-color: root.focused ? Palette.accent : Palette.line2;
    background: Palette.surface;
    TouchArea {
        clicked => {
            root.pick();
        }
    }
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 10px;
        VerticalLayout {
            alignment: center;
            Text {
                text: root.label;
                width: 96px;
                color: Palette.muted;
                font-size: 15px;
            }
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            Text {
                text: root.text == "" ? root.placeholder : root.text;
                color: root.text == "" ? Palette.faint : Palette.txt;
                font-size: 20px;
                font-weight: 600;
                overflow: elide;
            }
        }
    }
}

// Contacts search bar: tap to search, shows the query and a clear button.
component SearchBar inherits Rectangle {
    in property <string> query;
    callback activate;
    callback clear;
    height: 58px;
    border-radius: 12px;
    border-width: 1px;
    border-color: Palette.line2;
    background: Palette.surface;
    focus-ta := TouchArea {
        clicked => {
            root.activate();
        }
    }
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 8px;
        spacing: 10px;
        VerticalLayout {
            alignment: center;
            Icon { d: Icons.search; tint: Palette.muted; size: 22px; }
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            Text {
                text: root.query == "" ? "Search contacts" : root.query;
                color: root.query == "" ? Palette.faint : Palette.txt;
                font-size: 20px;
                overflow: elide;
            }
        }
        if root.query != "": Rectangle {
            width: 46px;
            clear-ta := TouchArea {
                clicked => {
                    root.clear();
                }
            }
            Icon {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                d: Icons.close;
                tint: Palette.muted;
                size: 22px;
            }
        }
    }
}

component ContactsScreen inherits Rectangle {
    in property <[ContactRow]> contacts;
    in property <string> query;
    property <bool> searching: false;
    callback open-contact(int);
    callback call-contact(int);
    callback add-contact;
    callback search-key(string);
    callback search-backspace;
    callback search-clear;
    background: transparent;
    VerticalLayout {
        padding: 16px;
        spacing: 10px;
        SearchBar {
            query: root.query;
            activate => {
                root.searching = true;
            }
            clear => {
                root.search-clear();
            }
        }
        // A little extra breathing room between the search bar and the list.
        Rectangle { height: 6px; }
        Flickable {
            vertical-stretch: 1;
            viewport-height: col.preferred-height;
            col := VerticalLayout {
                spacing: 10px;
                alignment: start;
                if root.contacts.length == 0: Text {
                    text: root.query == "" ? "No contacts programmed" : "No matches for '\{root.query}'";
                    color: Palette.muted;
                    font-size: 16px;
                    horizontal-alignment: center;
                }
                for c in root.contacts: ContactRowView {
                    title: c.name;
                    sub: c.sub;
                    kind: c.kind;
                    open => {
                        root.searching = false;
                        root.open-contact(c.index);
                    }
                    call => {
                        root.call-contact(c.index);
                    }
                }
            }
        }
        // Bottom: the search keyboard while searching, otherwise the Add button.
        if root.searching: VerticalLayout {
            spacing: 10px;
            OnScreenKeyboard {
                numeric: false;
                shift: false;
                key(c) => {
                    root.search-key(c);
                }
                backspace => {
                    root.search-backspace();
                }
                shift-toggle => {
                }
            }
            SecondaryButton {
                text: "Done";
                icon: Icons.check;
                clicked => {
                    root.searching = false;
                }
            }
        }
        if !root.searching: PrimaryButton {
            text: "Add contact";
            icon: Icons.plus;
            clicked => {
                root.add-contact();
            }
        }
    }
}

component ContactEditScreen inherits Rectangle {
    in property <string> title;
    in property <string> name;
    in property <string> callsign;
    in property <string> issi;
    in property <string> number;
    in property <bool> is-phone;
    in property <int> focus-field; // 0 name, 1 callsign, 2 issi, 3 number
    in property <bool> numeric;
    in property <bool> shift;
    in property <[DialTarget]> targets;
    in property <int> target-sel;
    callback set-focus(int);
    callback key(string);
    callback backspace;
    callback shift-toggle;
    callback select-target(int);
    callback save;
    callback cancel;
    background: transparent;
    VerticalLayout {
        padding: 14px;
        spacing: 16px;
        EditFieldRow {
            label: "Name";
            text: root.name;
            placeholder: "Required";
            focused: root.focus-field == 0;
            pick => {
                root.set-focus(0);
            }
        }
        EditFieldRow {
            label: "Callsign";
            text: root.callsign;
            placeholder: "Optional";
            focused: root.focus-field == 1;
            pick => {
                root.set-focus(1);
            }
        }
        // Contact target: Private (ISSI) or one of the gateways (phone).
        TargetSelector {
            targets: root.targets;
            sel: root.target-sel;
            selected(i) => {
                root.select-target(i);
            }
        }
        if !root.is-phone: EditFieldRow {
            label: "ISSI";
            text: root.issi;
            placeholder: "1..16777215";
            focused: root.focus-field == 2;
            pick => {
                root.set-focus(2);
            }
        }
        if root.is-phone: EditFieldRow {
            label: "Number";
            text: root.number;
            placeholder: "digits to dial";
            focused: root.focus-field == 3;
            pick => {
                root.set-focus(3);
            }
        }
        Rectangle {
            vertical-stretch: 1;
            min-height: 6px;
        }
        OnScreenKeyboard {
            numeric: root.numeric;
            shift: root.shift;
            digits-only: root.numeric && !root.is-phone;
            key(c) => {
                root.key(c);
            }
            backspace => {
                root.backspace();
            }
            shift-toggle => {
                root.shift-toggle();
            }
        }
        // Small gap between the keyboard and the action buttons.
        Rectangle { height: 8px; }
        HorizontalLayout {
            spacing: 10px;
            SecondaryButton {
                text: "Cancel";
                icon: Icons.close;
                horizontal-stretch: 1;
                clicked => {
                    root.cancel();
                }
            }
            PrimaryButton {
                text: "Save";
                icon: Icons.check;
                horizontal-stretch: 1;
                clicked => {
                    root.save();
                }
            }
        }
    }
}

// One conversation row in the messages list.
component ConvRowView inherits Rectangle {
    in property <string> name;
    in property <string> snippet;
    in property <int> unread;
    in property <string> ts;
    callback open;
    callback long-press;
    property <bool> held: false;
    height: 92px;
    border-radius: 16px;
    border-width: 1px;
    border-color: Palette.line;
    background: touch.pressed ? #16202b : Palette.surface;
    hold-timer := Timer {
        interval: 500ms;
        running: false;
        triggered => {
            self.running = false;
            root.held = true;
            root.long-press();
        }
    }
    touch := TouchArea {
        pointer-event(ev) => {
            if (ev.kind == PointerEventKind.down) {
                root.held = false;
                hold-timer.running = true;
            }
            if (ev.kind == PointerEventKind.up) {
                hold-timer.running = false;
                if (!root.held) {
                    root.open();
                }
            }
            if (ev.kind == PointerEventKind.cancel) {
                hold-timer.running = false;
            }
        }
    }
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 14px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 50px;
                height: 50px;
                border-radius: 14px;
                background: #33a7dd1f;
                Icon {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    d: Icons.message;
                    tint: Palette.accent;
                    size: 26px;
                }
                if root.unread > 0: Rectangle {
                    x: parent.width - self.width + 6px;
                    y: -6px;
                    width: 22px;
                    height: 22px;
                    border-radius: 8px;
                    background: Palette.red;
                    Text {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        text: root.unread;
                        color: #ffffff;
                        font-size: 13px;
                        font-weight: 800;
                    }
                }
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 4px;
            horizontal-stretch: 1;
            Text {
                text: root.name;
                color: Palette.txt;
                font-size: 21px;
                font-weight: root.unread > 0 ? 800 : 600;
                overflow: elide;
            }
            Text {
                text: root.snippet;
                color: Palette.muted;
                font-size: 15px;
                overflow: elide;
            }
        }
        VerticalLayout {
            alignment: center;
            Text {
                text: root.ts;
                color: Palette.faint;
                font-size: 13px;
            }
        }
    }
}

component MessagesScreen inherits Rectangle {
    in property <[ConvRow]> conversations;
    callback open-thread(int);
    callback new-message;
    callback delete-thread(int, bool);
    property <bool> confirm-visible: false;
    property <int> pending-peer;
    property <bool> pending-group;
    property <string> pending-name;
    background: transparent;
    VerticalLayout {
        padding: 16px;
        spacing: 10px;
        Flickable {
            vertical-stretch: 1;
            viewport-height: col.preferred-height;
            col := VerticalLayout {
                spacing: 10px;
                alignment: start;
                if root.conversations.length == 0: Text {
                    text: "No messages yet";
                    color: Palette.muted;
                    font-size: 16px;
                    horizontal-alignment: center;
                }
                for c in root.conversations: ConvRowView {
                    name: c.name;
                    snippet: c.snippet;
                    unread: c.unread;
                    ts: c.ts;
                    open => {
                        root.open-thread(c.peer);
                    }
                    long-press => {
                        root.pending-peer = c.peer;
                        root.pending-group = c.is-group;
                        root.pending-name = c.name;
                        root.confirm-visible = true;
                    }
                }
            }
        }
        PrimaryButton {
            text: "New message";
            icon: Icons.plus;
            clicked => {
                root.new-message();
            }
        }
    }
    if root.confirm-visible: ConfirmOverlay {
        title: "Delete conversation";
        message: "Delete all messages with " + root.pending-name + "? This cannot be undone.";
        confirm-label: "Delete";
        confirm => {
            root.confirm-visible = false;
            root.delete-thread(root.pending-peer, root.pending-group);
        }
        cancel => {
            root.confirm-visible = false;
        }
    }
}

// A single message bubble (right-aligned + ticks when outgoing).
component MsgBubble inherits Rectangle {
    in property <bool> outgoing;
    in property <string> text;
    in property <int> state; // 0 sending,1 delivered,2 read,3 failed,4 inbound
    in property <string> ts;
    callback long-press;
    property <bool> held: false;
    HorizontalLayout {
        padding: 2px;
        if root.outgoing: Rectangle { horizontal-stretch: 1; }
        Rectangle {
            max-width: 520px;
            border-radius: 14px;
            background: bubble-touch.pressed ? (root.outgoing ? #2a7fb0 : #24333f) : (root.outgoing ? #1f6f9e : #1b2732);
            hold-timer := Timer {
                interval: 500ms;
                running: false;
                triggered => {
                    self.running = false;
                    root.held = true;
                    root.long-press();
                }
            }
            bubble-touch := TouchArea {
                pointer-event(ev) => {
                    if (ev.kind == PointerEventKind.down) {
                        root.held = false;
                        hold-timer.running = true;
                    }
                    if (ev.kind == PointerEventKind.up) {
                        hold-timer.running = false;
                    }
                    if (ev.kind == PointerEventKind.cancel) {
                        hold-timer.running = false;
                    }
                }
            }
            VerticalLayout {
                padding: 10px;
                spacing: 3px;
                Text {
                    text: root.text;
                    color: #eef6fb;
                    font-size: 18px;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    alignment: end;
                    spacing: 6px;
                    Text {
                        text: root.ts;
                        color: #9fb4c4;
                        font-size: 12px;
                    }
                    if root.outgoing: Text {
                        text: root.state == 3 ? "failed"
                            : root.state == 2 ? "read"
                            : root.state == 1 ? "delivered"
                            : "sending";
                        color: root.state == 3 ? #ff9a9d : (root.state == 2 ? #7fe0a6 : #9fb4c4);
                        font-size: 12px;
                        font-weight: 700;
                    }
                }
            }
        }
        if !root.outgoing: Rectangle { horizontal-stretch: 1; }
    }
}

component MsgThreadScreen inherits Rectangle {
    in property <[MsgRow]> messages;
    in property <string> draft;
    in property <bool> shift;
    callback key(string);
    callback backspace;
    callback shift-toggle;
    callback send;
    callback delete-message(int);
    property <bool> confirm-visible: false;
    property <int> pending-id;
    property <string> pending-text;
    in property <int> scroll-tick;
    // Mirror of the message-list height so we can scroll once it actually grows.
    property <length> content-h: col.preferred-height;
    // Set when an open/send asked to scroll; cleared once we've pinned to bottom.
    property <bool> want-bottom: false;
    background: transparent;
    // Pin to the bottom only when opening the thread or sending (Rust bumps the
    // tick), not on every keystroke or inbound message.
    changed scroll-tick => {
        root.want-bottom = true;
        settle-timer.running = true;
    }
    // The new message changes the list height: scroll the moment it appears.
    changed content-h => {
        if (root.want-bottom) {
            flick.viewport-y = Math.min(0px, flick.height - root.content-h);
            root.want-bottom = false;
        }
    }
    // Fallback for when the height doesn't change (e.g. re-opening a thread whose
    // content already fills the view): scroll after layout settles.
    settle-timer := Timer {
        interval: 16ms;
        running: false;
        triggered => {
            self.running = false;
            if (root.want-bottom) {
                flick.viewport-y = Math.min(0px, flick.height - flick.viewport-height);
                root.want-bottom = false;
            }
        }
    }
    VerticalLayout {
        padding: 12px;
        spacing: 10px;
        flick := Flickable {
            vertical-stretch: 1;
            viewport-height: col.preferred-height;
            col := VerticalLayout {
                spacing: 6px;
                alignment: start;
                if root.messages.length == 0: Text {
                    text: "No messages in this conversation";
                    color: Palette.muted;
                    font-size: 15px;
                    horizontal-alignment: center;
                }
                for m in root.messages: MsgBubble {
                    outgoing: m.outgoing;
                    text: m.text;
                    state: m.state;
                    ts: m.ts;
                    long-press => {
                        root.pending-id = m.id;
                        root.pending-text = m.text;
                        root.confirm-visible = true;
                    }
                }
            }
        }
        // Draft preview.
        Rectangle {
            height: 52px;
            border-radius: 12px;
            border-width: 1px;
            border-color: Palette.line2;
            background: Palette.surface;
            HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 1;
                    Text {
                        text: root.draft == "" ? "Type a message" : root.draft;
                        color: root.draft == "" ? Palette.faint : Palette.txt;
                        font-size: 18px;
                        overflow: elide;
                    }
                }
            }
        }
        OnScreenKeyboard {
            numeric: false;
            shift: root.shift;
            key(c) => {
                root.key(c);
            }
            backspace => {
                root.backspace();
            }
            shift-toggle => {
                root.shift-toggle();
            }
        }
        PrimaryButton {
            text: "Send";
            icon: Icons.send;
            enabled: root.draft != "";
            clicked => {
                root.send();
            }
        }
    }
    if root.confirm-visible: ConfirmOverlay {
        title: "Delete message";
        message: "Delete this message? This cannot be undone.";
        confirm-label: "Delete";
        confirm => {
            root.confirm-visible = false;
            root.delete-message(root.pending-id);
        }
        cancel => {
            root.confirm-visible = false;
        }
    }
}

component MsgNewScreen inherits Rectangle {
    in property <string> issi;
    callback key(string);
    callback backspace;
    callback start;
    callback cancel;
    background: transparent;
    VerticalLayout {
        padding: 14px;
        spacing: 14px;
        EditFieldRow {
            label: "To (ISSI)";
            text: root.issi;
            placeholder: "Recipient number";
            focused: true;
        }
        Rectangle {
            vertical-stretch: 1;
            min-height: 6px;
        }
        OnScreenKeyboard {
            numeric: true;
            digits-only: true;
            key(c) => {
                root.key(c);
