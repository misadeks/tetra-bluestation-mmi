            PrimaryButton {
                text: "Start";
                icon: Icons.check;
                enabled: root.issi != "";
                horizontal-stretch: 1;
                clicked => {
                    root.start();
                }
            }
        }
    }
}

// ---- Codeplug programming: hub + generic list + generic edit form ----

// A labelled on/off toggle row.
component ToggleRow inherits Rectangle {
    in property <string> label;
    in property <bool> on;
    callback toggled;
    height: 58px;
    border-radius: 12px;
    border-width: 1px;
    border-color: Palette.line2;
    background: Palette.surface;
    TouchArea {
        clicked => {
            root.toggled();
        }
    }
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 10px;
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            Text {
                text: root.label;
                color: Palette.txt;
                font-size: 18px;
                font-weight: 600;
                overflow: elide;
            }
        }
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 58px;
                height: 30px;
                border-radius: 15px;
                background: root.on ? Palette.green : #33414f;
                Rectangle {
                    width: 24px;
                    height: 24px;
                    border-radius: 12px;
                    background: #ffffff;
                    x: root.on ? parent.width - self.width - 3px : 3px;
                    y: 3px;
                }
            }
        }
    }
}

// A tap-to-cycle row (e.g. folder, class of usage).
component CycleRow inherits Rectangle {
    in property <string> label;
    in property <string> value;
    callback tapped;
    height: 58px;
    border-radius: 12px;
    border-width: 1px;
    border-color: Palette.line2;
    background: touch.pressed ? #16202b : Palette.surface;
    touch := TouchArea {
        clicked => {
            root.tapped();
        }
    }
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 10px;
        VerticalLayout {
            alignment: center;
            Text {
                text: root.label;
                width: 116px;
                color: Palette.muted;
                font-size: 15px;
            }
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            Text {
                text: root.value;
                color: Palette.txt;
                font-size: 20px;
                font-weight: 600;
                overflow: elide;
            }
        }
        VerticalLayout {
            alignment: center;
            Icon { d: Icons.chevron-down; tint: Palette.faint; size: 20px; }
        }
    }
}

// The codeplug programming hub: pick a section to edit.
component ProgHubScreen inherits Rectangle {
    callback open-section(int);
    callback open-tree;
    background: transparent;
    Flickable {
        viewport-height: hcol.preferred-height;
        hcol := VerticalLayout {
            padding: 16px;
            spacing: 10px;
            alignment: start;
            ListRow {
                title: "Networks";
                subtitle: "Home network and allowed networks";
                icon: Icons.radio;
                clicked => { root.open-section(0); }
            }
            ListRow {
                title: "Talkgroups & folders";
                subtitle: "Browse the tree, add and move groups";
                icon: Icons.folder;
                clicked => { root.open-tree(); }
            }
            ListRow {
                title: "Scan lists";
                subtitle: "Groups scanned together";
                icon: Icons.radio;
                clicked => { root.open-section(3); }
            }
            ListRow {
                title: "Gateways";
                subtitle: "External-call access points";
                icon: Icons.phone;
                clicked => { root.open-section(4); }
            }
            ListRow {
                title: "Home mode display";
                subtitle: "SDS text feature toggle";
                icon: Icons.gear;
                clicked => { root.open-section(6); }
            }
        }
    }
}

// Generic list of a codeplug section's entries (Rust supplies the rows).
component EntityListScreen inherits Rectangle {
    in property <[EntityRow]> rows;
    in property <string> empty-text;
    in property <string> add-label;
    callback open(int);
    callback add;
    background: transparent;
    VerticalLayout {
        padding: 16px;
        spacing: 10px;
        Flickable {
            vertical-stretch: 1;
            viewport-height: lcol.preferred-height;
            lcol := VerticalLayout {
                spacing: 10px;
                alignment: start;
                if root.rows.length == 0: Text {
                    text: root.empty-text;
                    color: Palette.muted;
                    font-size: 16px;
                    horizontal-alignment: center;
                }
                for r in root.rows: ListRow {
                    title: r.title;
                    subtitle: r.sub;
                    clicked => {
                        root.open(r.index);
                    }
                }
            }
        }
        if root.add-label != "": PrimaryButton {
            text: root.add-label;
            icon: Icons.plus;
            clicked => {
                root.add();
            }
        }
    }
}

// Generic edit form driven by a [FormField] model.
component FormEditScreen inherits Rectangle {
    in property <[FormField]> fields;
    in property <int> focus-field; // index of the focused text/number field, -1 = none
    in property <bool> shift;
    in property <bool> can-delete;
    in property <string> title;
    property <bool> del-confirm: false;
    callback pick(int);
    callback key(string);
    callback backspace;
    callback shift-toggle;
    callback toggle(int);
    callback cycle(int);
    callback save;
    callback cancel;
    callback delete;
    property <int> focus-kind: (root.focus-field >= 0 && root.focus-field < root.fields.length)
        ? root.fields[root.focus-field].kind : 0;
    background: transparent;
    VerticalLayout {
        padding: 14px;
        spacing: 12px;
        Flickable {
            vertical-stretch: 1;
            viewport-height: fcol.preferred-height;
            fcol := VerticalLayout {
                spacing: 10px;
                alignment: start;
                for f[i] in root.fields: Rectangle {
                    height: 58px;
                    if f.kind == 3: ToggleRow {
                        width: 100%;
                        label: f.label;
                        on: f.on;
                        toggled => {
                            root.toggle(i);
                        }
                    }
                    if f.kind == 4: CycleRow {
                        width: 100%;
                        label: f.label;
                        value: f.value;
                        tapped => {
                            root.cycle(i);
                        }
                    }
                    if f.kind == 0 || f.kind == 1 || f.kind == 2: EditFieldRow {
                        width: 100%;
                        label: f.label;
                        text: f.value;
                        placeholder: "";
                        focused: root.focus-field == i;
                        pick => {
                            root.pick(i);
                        }
                    }
                }
            }
        }
        OnScreenKeyboard {
            numeric: root.focus-kind == 1 || root.focus-kind == 2;
            digits-only: root.focus-kind == 1;
            shift: root.shift;
            key(c) => {
                root.key(c);
            }
            backspace => {
                root.backspace();
            }
            shift-toggle => {
                root.shift-toggle();
            }
        }
        Rectangle { height: 6px; }
        HorizontalLayout {
            spacing: 10px;
            if root.can-delete: DangerButton {
                text: "Delete";
                icon: Icons.trash;
                horizontal-stretch: 1;
                clicked => {
                    root.del-confirm = true;
                }
            }
            SecondaryButton {
                text: "Cancel";
                icon: Icons.close;
                horizontal-stretch: 1;
                clicked => {
                    root.cancel();
                }
            }
            PrimaryButton {
                text: "Save";
                icon: Icons.check;
                horizontal-stretch: 1;
                clicked => {
                    root.save();
                }
            }
        }
    }
    if root.del-confirm: ConfirmOverlay {
        title: "Delete";
        message: "Delete " + root.title + "? This cannot be undone.";
        confirm-label: "Delete";
        confirm => {
            root.del-confirm = false;
            root.delete();
        }
        cancel => {
            root.del-confirm = false;
        }
    }
}

