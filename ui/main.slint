component TreeGroupRow inherits Rectangle {
    in property <string> title;
    in property <string> sub;
    in property <bool> can-up;
    in property <bool> can-down;
    callback tapped;
    callback move-up;
    callback move-down;
    height: 62px;
    border-radius: 12px;
    background: touch.pressed ? #16202b : Palette.surface;
    border-width: 1px;
    border-color: Palette.line;
    touch := TouchArea {
        clicked => {
            root.tapped();
        }
    }
    HorizontalLayout {
        padding-left: 26px;
        padding-right: 6px;
        spacing: 8px;
        VerticalLayout {
            alignment: center;
            Icon { d: Icons.users; tint: Palette.muted; size: 24px; }
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            spacing: 2px;
            Text {
                text: root.title;
                color: Palette.txt;
                font-size: 18px;
                font-weight: 600;
                overflow: elide;
            }
            Text { text: root.sub; color: Palette.muted; font-size: 13px; }
        }
        Rectangle {
            width: 44px;
            up-ta := TouchArea {
                enabled: root.can-up;
                clicked => {
                    root.move-up();
                }
            }
            Icon {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                d: Icons.chevron-up;
                tint: root.can-up ? (up-ta.pressed ? Palette.accent : Palette.txt) : #ffffff22;
                size: 24px;
            }
        }
        Rectangle {
            width: 44px;
            down-ta := TouchArea {
                enabled: root.can-down;
                clicked => {
                    root.move-down();
                }
            }
            Icon {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                d: Icons.chevron-down;
                tint: root.can-down ? (down-ta.pressed ? Palette.accent : Palette.txt) : #ffffff22;
                size: 24px;
            }
        }
    }
}

component TreeAddRow inherits Rectangle {
    in property <string> label;
    callback tapped;
    height: 46px;
    border-radius: 10px;
    background: touch.pressed ? #16202b : transparent;
    border-width: 1px;
    border-color: #ffffff14;
    touch := TouchArea {
        clicked => {
            root.tapped();
        }
    }
    HorizontalLayout {
        padding-left: 26px;
        spacing: 8px;
        VerticalLayout {
            alignment: center;
            Icon { d: Icons.plus; tint: Palette.accent; size: 20px; }
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            Text { text: root.label; color: #9fd3ef; font-size: 15px; font-weight: 600; }
        }
    }
}

// The folders + talkgroups tree: folders as headers with their groups nested,
// an "Other" bucket, add-group per folder, and an add-folder button.
component TreeScreen inherits Rectangle {
    in property <[TreeRow]> rows;
    callback folder(int);
    callback toggle(int);
    callback group(int);
    callback add-group(int);
    callback add-folder;
    callback move-up(int);
    callback move-down(int);
    background: transparent;
    VerticalLayout {
        padding: 16px;
        spacing: 10px;
        Flickable {
            vertical-stretch: 1;
            viewport-height: tcol.preferred-height;
            tcol := VerticalLayout {
                spacing: 8px;
                alignment: start;
                for r in root.rows: Rectangle {
                    height: r.kind == 0 ? 76px : (r.kind == 2 ? 46px : (r.kind == 3 ? 40px : 62px));
                    if r.kind == 0: TreeFolderHeader {
                        width: 100%;
                        title: r.title;
                        sub: r.sub;
                        editable: r.index >= 0;
                        collapsed: r.collapsed;
                        tapped => {
                            root.toggle(r.index);
                        }
                        edit => {
                            root.folder(r.index);
                        }
                    }
                    if r.kind == 1: TreeGroupRow {
                        width: 100%;
                        title: r.title;
                        sub: r.sub;
                        can-up: r.can-up;
                        can-down: r.can-down;
                        tapped => {
                            root.group(r.index);
                        }
                        move-up => {
                            root.move-up(r.index);
                        }
                        move-down => {
                            root.move-down(r.index);
                        }
                    }
                    if r.kind == 2: TreeAddRow {
                        width: 100%;
                        label: r.title;
                        tapped => {
                            root.add-group(r.index);
                        }
                    }
                    if r.kind == 3: Text {
                        text: r.title;
                        color: Palette.muted;
                        font-size: 15px;
                        vertical-alignment: center;
                        horizontal-alignment: center;
                    }
                }
            }
        }
        PrimaryButton {
            text: "Add folder";
            icon: Icons.plus;
            clicked => {
                root.add-folder();
            }
        }
    }
}

// Ringtone settings: enable toggle + a call-category selector + a selectable
// tone list (tap previews + selects the tone for the chosen category).
component RingtoneScreen inherits Rectangle {
    in property <[EntityRow]> tones;
    in property <int> selected;
    in property <int> category; // 0 simplex, 1 duplex, 2 gateway
    in property <bool> enabled;
    callback toggle;
    callback select(int);
    callback pick-category(int);
    property <[string]> cat-labels: ["Private PTT", "Private duplex", "Gateway"];
    background: transparent;
    VerticalLayout {
        padding: 16px;
        spacing: 12px;
        ToggleRow {
            label: "Ring on incoming calls";
            on: root.enabled;
            toggled => {
                root.toggle();
            }
        }
        Text {
            text: "Ringtone for";
            color: Palette.muted;
            font-size: 14px;
            letter-spacing: 1px;
        }
        // Call-category segmented selector.
        HorizontalLayout {
            spacing: 8px;
            for label[i] in root.cat-labels: Rectangle {
                horizontal-stretch: 1;
                height: 46px;
                border-radius: 12px;
                border-width: 1px;
                border-color: i == root.category ? Palette.accent : Palette.line2;
                background: i == root.category ? #33a7dd1f : (seg.pressed ? #1b2836 : Palette.surface);
                seg := TouchArea {
                    clicked => {
                        root.pick-category(i);
                    }
                }
                Text {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    text: label;
                    color: i == root.category ? #9fd3ef : Palette.txt;
                    font-size: 15px;
                    font-weight: i == root.category ? 800 : 600;
                }
            }
        }
        Flickable {
            vertical-stretch: 1;
            viewport-height: rcol.preferred-height;
            rcol := VerticalLayout {
                spacing: 10px;
                alignment: start;
                for t[i] in root.tones: ListRow {
                    title: t.title;
                    subtitle: t.sub;
                    icon: Icons.bell;
                    selected: i == root.selected;
                    show-chevron: false;
                    clicked => {
                        root.select(t.index);
                    }
                }
            }
        }
        Text {
            text: "Tap a ringtone to preview and select it for the chosen call type.";
            color: Palette.faint;
            font-size: 13px;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
    }
}

// Settings hub: entry points for UI-only settings.
component SettingsScreen inherits Rectangle {
    callback open-ringtones;
    background: transparent;
    VerticalLayout {
        padding: 16px;
        spacing: 10px;
        alignment: start;
        ListRow {
            title: "Ringtone";
            subtitle: "Incoming-call sounds per call type";
            icon: Icons.bell;
            clicked => {
                root.open-ringtones();
            }
        }
    }
}

// One recents row: outcome-tinted direction icon, name/number, time, sub, and a
// quick-call button. Tap the body to open detail; long-press to delete.
component RecentRowView inherits Rectangle {
    in property <string> title;
    in property <string> sub;
    in property <string> time;
    in property <int> kind; // 0 answered,1 missed,2 rejected,3 no-answer,4 failed
    in property <bool> outgoing;
    in property <bool> can-call;
    callback open;
    callback call;
    callback long-press;
    property <bool> held: false;
    property <bool> missed: root.kind == 1;
    height: 92px;
    border-radius: 16px;
    border-width: 1px;
    border-color: Palette.line;
    clip: true;
    background: touch.pressed ? #16202b : Palette.surface;
    hold-timer := Timer {
        interval: 500ms;
        running: false;
        triggered => {
            self.running = false;
            root.held = true;
            root.long-press();
        }
    }
    touch := TouchArea {
        pointer-event(ev) => {
            if (ev.kind == PointerEventKind.down) {
                root.held = false;
                hold-timer.running = true;
            }
            if (ev.kind == PointerEventKind.up) {
                hold-timer.running = false;
                if (!root.held) {
                    root.open();
                }
            }
            if (ev.kind == PointerEventKind.cancel) {
                hold-timer.running = false;
            }
        }
    }
    HorizontalLayout {
        padding-left: 16px;
        padding-right: root.can-call ? 96px : 16px;
        spacing: 14px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 46px;
                height: 46px;
                border-radius: 13px;
                background: root.missed ? #f0555a1f : #33a7dd1f;
                Icon {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    d: root.outgoing ? Icons.call-out : Icons.call-in;
                    tint: root.missed ? Palette.red : (root.outgoing ? #7fe0a6 : Palette.accent);
                    size: 24px;
                }
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 3px;
            horizontal-stretch: 1;
            Text {
                text: root.title;
                color: root.missed ? #ff9a9d : Palette.txt;
                font-size: 20px;
                font-weight: root.missed ? 800 : 600;
                overflow: elide;
            }
            Text {
                text: root.sub;
                color: Palette.muted;
                font-size: 14px;
                overflow: elide;
            }
        }
        VerticalLayout {
            alignment: center;
            Text { text: root.time; color: Palette.faint; font-size: 13px; }
        }
    }
    // Green call button filling the whole right end of the card (clip rounds it).
    if root.can-call: Rectangle {
        x: parent.width - self.width;
        y: 0;
        width: 84px;
        height: parent.height;
        background: callta.pressed ? #16321f : #10281a;
        // Left divider between the content and the call button.
        Rectangle {
            x: 0;
            width: 1px;
            height: parent.height;
            background: #37c06a4d;
        }
        callta := TouchArea {
            clicked => {
                root.call();
            }
        }
        Icon {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            d: Icons.phone;
            tint: Palette.green;
            size: 28px;
        }
    }
}

component RecentsScreen inherits Rectangle {
    in property <[RecentRow]> rows;
    in property <bool> missed-only;
    callback open(int);
    callback call(int);
    callback delete(int);
    callback set-filter(bool);
    callback clear-all;
    property <bool> confirm-clear: false;
    property <bool> confirm-del: false;
    property <int> pending-id;
    property <string> pending-title;
    background: transparent;
    VerticalLayout {
        padding: 16px;
        spacing: 10px;
        // Filter chips (same size as the dialer's target selectors).
        HorizontalLayout {
            spacing: 8px;
            Rectangle {
                horizontal-stretch: 1;
                height: 54px;
                border-radius: 12px;
                border-width: 1px;
                border-color: !root.missed-only ? Palette.accent : Palette.line2;
                background: !root.missed-only ? #33a7dd29 : Palette.surface;
                TouchArea { clicked => { root.set-filter(false); } }
                Text {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    text: "All";
                    color: !root.missed-only ? #9fd3ef : Palette.muted;
                    font-size: 16px;
                    font-weight: 700;
                }
            }
            Rectangle {
                horizontal-stretch: 1;
                height: 54px;
                border-radius: 12px;
                border-width: 1px;
                border-color: root.missed-only ? Palette.red : Palette.line2;
                background: root.missed-only ? #f0555a29 : Palette.surface;
                TouchArea { clicked => { root.set-filter(true); } }
                Text {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    text: "Missed";
                    color: root.missed-only ? #ff9a9d : Palette.muted;
                    font-size: 16px;
                    font-weight: 700;
                }
            }
        }
        // A little extra breathing room between the filter and the list.
        Rectangle { height: 6px; }
        // Empty state: large, centred in the remaining space.
        if root.rows.length == 0: Rectangle {
            vertical-stretch: 1;
            Text {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                text: root.missed-only ? "No missed calls" : "No recent calls";
                color: Palette.muted;
                font-size: 22px;
                font-weight: 600;
                horizontal-alignment: center;
            }
        }
        if root.rows.length > 0: Flickable {
            vertical-stretch: 1;
            viewport-height: rccol.preferred-height;
            rccol := VerticalLayout {
                spacing: 10px;
                alignment: start;
                for r in root.rows: RecentRowView {
                    title: r.title;
                    sub: r.sub;
                    time: r.time;
                    kind: r.kind;
                    outgoing: r.outgoing;
                    can-call: r.can-call;
                    open => {
                        root.open(r.id);
                    }
                    call => {
                        root.call(r.id);
                    }
                    long-press => {
                        root.pending-id = r.id;
                        root.pending-title = r.title;
                        root.confirm-del = true;
                    }
                }
            }
        }
        if root.rows.length > 0: SecondaryButton {
            text: "Clear all";
            icon: Icons.trash;
            danger: true;
            clicked => {
                root.confirm-clear = true;
            }
        }
    }
    if root.confirm-del: ConfirmOverlay {
        title: "Delete call";
        message: "Remove this entry from Recents?";
        confirm-label: "Delete";
        confirm => {
            root.confirm-del = false;
            root.delete(root.pending-id);
        }
        cancel => {
            root.confirm-del = false;
        }
    }
    if root.confirm-clear: ConfirmOverlay {
        title: "Clear Recents";
        message: "Delete the entire call log? This cannot be undone.";
        confirm-label: "Clear all";
        confirm => {
            root.confirm-clear = false;
            root.clear-all();
        }
        cancel => {
            root.confirm-clear = false;
        }
    }
}

component RecentDetailScreen inherits Rectangle {
    in property <string> title;
    in property <string> sub;
    in property <string> time;
    in property <int> kind;
    in property <bool> outgoing;
    in property <bool> can-call;
    in property <bool> can-ptt;
    in property <bool> can-message;
    in property <bool> can-add;
    callback call-duplex;
    callback call-ptt;
    callback message;
    callback add-contact;
    callback delete;
    property <bool> confirm-del: false;
    property <bool> missed: root.kind == 1;
    background: transparent;
    VerticalLayout {
        padding: 18px;
        spacing: 14px;
        Rectangle {
            height: 168px;
            border-radius: 18px;
            border-width: 1px;
            border-color: Palette.line;
            background: Palette.surface;
            VerticalLayout {
                alignment: center;
                spacing: 6px;
                HorizontalLayout {
                    alignment: center;
                    Rectangle {
                        width: 66px;
                        height: 66px;
                        border-radius: 20px;
                        background: root.missed ? #f0555a1f : #33a7dd1f;
                        Icon {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            d: root.outgoing ? Icons.call-out : Icons.call-in;
                            tint: root.missed ? Palette.red : (root.outgoing ? #7fe0a6 : Palette.accent);
                            size: 30px;
                        }
                    }
                }
                Text {
                    text: root.title;
                    color: Palette.txt;
                    font-size: 26px;
                    font-weight: 800;
                    horizontal-alignment: center;
                    overflow: elide;
                }
                Text {
                    text: root.sub;
                    color: Palette.muted;
                    font-size: 15px;
                    horizontal-alignment: center;
                }
                Text {
                    text: root.time;
                    color: Palette.faint;
                    font-size: 13px;
                    horizontal-alignment: center;
                }
            }
        }
        if root.can-call: PrimaryButton {
            text: "Call (duplex)";
            icon: Icons.phone;
            clicked => {
                root.call-duplex();
            }
        }
        if root.can-ptt: SecondaryButton {
            text: "Call (PTT)";
            icon: Icons.mic;
            clicked => {
                root.call-ptt();
            }
        }
        if root.can-message: SecondaryButton {
            text: "Message";
            icon: Icons.message;
            clicked => {
                root.message();
            }
        }
        if root.can-add: SecondaryButton {
            text: "Add to contacts";
            icon: Icons.plus;
            clicked => {
                root.add-contact();
            }
        }
        Rectangle { vertical-stretch: 1; }
        DangerButton {
            text: "Delete";
            icon: Icons.trash;
            clicked => {
                root.confirm-del = true;
            }
        }
    }
    if root.confirm-del: ConfirmOverlay {
        title: "Delete call";
        message: "Remove this entry from Recents?";
        confirm-label: "Delete";
        confirm => {
            root.confirm-del = false;
            root.delete();
        }
        cancel => {
            root.confirm-del = false;
        }
    }
}

component ConfigScreen inherits Rectangle {
    in property <string> toml;
    callback apply;
    callback refresh;
    background: transparent;
    VerticalLayout {
        padding: 16px;
        spacing: 12px;
        Rectangle {
            vertical-stretch: 1;
            border-radius: 14px;
            border-width: 1px;
            border-color: Palette.line;
            background: #070d14;
            Flickable {
                viewport-height: body.preferred-height + 24px;
                body := Text {
                    x: 14px;
                    y: 12px;
                    width: parent.width - 28px;
                    text: root.toml == "" ? "No config loaded yet" : root.toml;
                    color: #b9ccd8;
                    font-size: 13px;
                    font-family: "Consolas";
                    wrap: word-wrap;
                }
            }
        }
        HorizontalLayout {
            spacing: 10px;
            SecondaryButton {
                text: "Refresh";
                icon: Icons.refresh;
                horizontal-stretch: 1;
                clicked => {
                    root.refresh();
                }
            }
            PrimaryButton {
                text: "Apply Config";
                icon: Icons.check;
                horizontal-stretch: 1;
                clicked => {
                    root.apply();
                }
            }
        }
    }
}

component SurveyRowView inherits Rectangle {
    in property <string> title;
    in property <string> sub1;
    in property <string> sub2;
    callback register;
    callback monitor;
    height: 150px;
    border-radius: 14px;
    border-width: 1px;
    border-color: Palette.line;
    background: Palette.surface;
    VerticalLayout {
        padding: 14px;
        spacing: 6px;
        Text {
            text: root.title;
            color: Palette.txt;
            font-size: 20px;
            font-weight: 700;
        }
        Text {
            text: root.sub1;
            color: Palette.muted;
            font-size: 14px;
        }
        Text {
            text: root.sub2;
            color: Palette.muted;
            font-size: 14px;
        }
        HorizontalLayout {
            spacing: 10px;
            padding-top: 4px;
            PrimaryButton {
                text: "Register";
                icon: Icons.login;
                horizontal-stretch: 1;
                clicked => {
                    root.register();
                }
            }
            SecondaryButton {
                text: "Monitor";
                icon: Icons.activity;
                horizontal-stretch: 1;
                clicked => {
                    root.monitor();
                }
            }
        }
    }
}

component SurveyScreen inherits Rectangle {
    in property <bool> manual;
    in property <bool> scanning;
    in property <string> status;
    in property <[SurveyRow]> rows;
    callback toggle-mode;
    callback scan;
    callback stop;
    callback camp(int, bool);
    background: transparent;
    Flickable {
        viewport-height: col.preferred-height;
        col := VerticalLayout {
            padding: 16px;
            spacing: 12px;
            alignment: start;

            // Manual/Auto toggle.
            Rectangle {
                height: 76px;
                border-radius: 14px;
                border-width: 1px;
                border-color: Palette.line;
                background: Palette.surface;
                HorizontalLayout {
                    padding-left: 18px;
                    padding-right: 18px;
                    spacing: 12px;
                    Text {
                        text: "Manual cell selection";
                        color: Palette.txt;
                        font-size: 19px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                    Rectangle { horizontal-stretch: 1; }
                    VerticalLayout {
                        alignment: center;
                        Toggle {
                            on: root.manual;
                            toggled(v) => {
                                root.toggle-mode();
                            }
                        }
                    }
                }
            }

            if !root.manual: Rectangle {
                height: 160px;
                VerticalLayout {
                    alignment: center;
                    spacing: 10px;
                    HorizontalLayout {
                        alignment: center;
                        Icon { d: Icons.radio; tint: Palette.muted; size: 34px; }
                    }
                    Text {
                        text: "Auto mode";
                        color: Palette.txt;
                        font-size: 18px;
                        font-weight: 700;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: "The stack scans and camps on its own. Switch to Manual to survey the programmed carriers and pick a cell.";
                        color: Palette.muted;
                        font-size: 14px;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }
                }
            }

            if root.manual: HorizontalLayout {
                if root.scanning: SecondaryButton {
                    text: "Stop scan";
                    icon: Icons.close;
                    horizontal-stretch: 1;
                    clicked => {
                        root.stop();
                    }
                }
                if !root.scanning: PrimaryButton {
                    text: "Scan cells";
                    icon: Icons.radio;
                    horizontal-stretch: 1;
                    clicked => {
                        root.scan();
                    }
                }
            }

            if root.manual && root.status != "": Text {
                text: root.status;
                color: Palette.muted;
                font-size: 14px;
                horizontal-alignment: center;
            }

            if root.manual: VerticalLayout {
                spacing: 12px;
                for r in root.rows: SurveyRowView {
                    title: r.title;
                    sub1: r.sub1;
                    sub2: r.sub2;
                    register => {
                        root.camp(r.carrier, true);
                    }
                    monitor => {
                        root.camp(r.carrier, false);
                    }
                }
            }

            if root.manual && root.rows.length == 0 && !root.scanning: Text {
                text: "Tap Scan to survey the programmed carriers. The survey is receive-only.";
                color: Palette.muted;
                font-size: 14px;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
        }
    }
}

// In-call view (individual). A proper screen: keeps the status/header/nav chrome
// and mirrors the web UI's .call-hero + docked PTT. Hang up lives in the nav bar.
component InCallScreen inherits Rectangle {
    in property <string> dir;
    in property <string> peer;
    in property <string> sub;
    in property <string> state;
    in property <string> clock;
    in property <bool> can-ptt;
    in property <int> ptt-state;
    in property <bool> ptt-enabled;
    in property <bool> show-dtmf;
    in property <string> digits;
    callback ptt-down;
    callback ptt-up;
    callback dtmf(string);
    background: transparent;
    VerticalLayout {
        padding: 22px;
        spacing: 10px;
        // Hero, vertically centered.
        Rectangle {
            vertical-stretch: 1;
            VerticalLayout {
                alignment: center;
                spacing: 4px;
                Text {
                    text: root.dir;
                    color: Palette.muted;
                    font-size: 13px;
                    letter-spacing: 1px;
                    font-weight: 600;
                    horizontal-alignment: center;
                }
                Text {
                    text: root.peer;
                    color: #ffffff;
                    font-size: 40px;
                    font-weight: 800;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
                Text {
                    text: root.sub;
                    color: Palette.muted;
                    font-size: 15px;
                    horizontal-alignment: center;
                }
                Rectangle { height: 10px; }
                Text {
                    text: root.state;
                    color: #8fe6ab;
                    font-size: 16px;
                    font-weight: 600;
                    horizontal-alignment: center;
                }
                if root.clock != "": Text {
                    text: root.clock;
                    color: #cfe9ff;
                    font-size: 24px;
                    font-weight: 700;
                    horizontal-alignment: center;
                }
            }
        }
        // DTMF keypad (duplex calls: post-dial / IVR). Sends one tone per key.
        if root.show-dtmf: VerticalLayout {
            spacing: 8px;
            Rectangle {
                height: 60px;
                border-radius: 12px;
                border-width: 1px;
                border-color: Palette.line2;
                background: #0b1119;
                Text {
                    text: root.digits == "" ? "DTMF" : root.digits;
                    color: root.digits == "" ? Palette.faint : #cfe9ff;
                    font-size: 32px;
                    font-weight: 700;
                    letter-spacing: 3px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
            // Gap between the DTMF readout and the keypad.
            Rectangle { height: 14px; }
            for row in [["1", "2", "3"], ["4", "5", "6"], ["7", "8", "9"], ["*", "0", "#"]]: HorizontalLayout {
                spacing: 10px;
                for d in row: KeyCap {
                    label: d;
                    tapped => {
                        root.dtmf(d);
                    }
                }
            }
        }
        // Docked PTT (simplex active calls only), same position as home/group.
        if root.can-ptt: Ptt {
            text: root.ptt-state == 2 ? "ON AIR"
                : root.ptt-state == 1 ? "Requesting..."
                : "Push to talk";
            enabled: root.ptt-enabled;
            state: root.ptt-state;
            press-down => {
                root.ptt-down();
            }
            release => {
                root.ptt-up();
            }
        }
    }
}

// Incoming-call modal overlay (mirrors the web UI .callov / .inc-card).
component IncomingOverlay inherits Rectangle {
    in property <string> peer;
    in property <string> sub;
    callback answer;
    callback reject;
    width: 100%;
    height: 100%;
    // Full-screen opaque incoming-call view (matches the app background).
    background: @linear-gradient(180deg, #0f1620 0%, #0a0f16 100%);
    VerticalLayout {
        padding: 26px;
        padding-bottom: 30px;
        spacing: 0px;
        // Caller identity, vertically centred in the space above the buttons.
        Rectangle {
            vertical-stretch: 1;
            VerticalLayout {
                alignment: center;
                spacing: 18px;
                HorizontalLayout {
                    alignment: center;
                    Rectangle {
                        width: 108px;
                        height: 108px;
                        border-radius: 54px;
                        background: #37c06a29;
                        border-width: 2px;
                        border-color: #37c06a4d;
                        HorizontalLayout {
                            alignment: center;
                            VerticalLayout {
                                alignment: center;
                                Icon { d: Icons.phone; tint: Palette.green; size: 48px; }
                            }
                        }
                    }
                }
                Text {
                    text: "INCOMING CALL";
                    color: Palette.muted;
                    font-size: 14px;
                    letter-spacing: 2px;
                    font-weight: 700;
                    horizontal-alignment: center;
                }
                Text {
                    text: root.peer;
                    color: #ffffff;
                    font-size: 42px;
                    font-weight: 800;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
                Text {
                    text: root.sub;
                    color: #9fd3ef;
                    font-size: 24px;
                    font-weight: 600;
                    horizontal-alignment: center;
                }
            }
        }
        // Reject / Answer docked at the bottom.
        HorizontalLayout {
            spacing: 16px;
            Rectangle {
                horizontal-stretch: 1;
                height: 104px;
                border-radius: 18px;
                background: rej.pressed
                    ? @linear-gradient(180deg, #cf3f44 0%, #a82a2f 100%)
                    : @linear-gradient(180deg, #ef5a5f 0%, #cf3f44 100%);
                rej := TouchArea {
                    clicked => {
                        root.reject();
                    }
                }
                VerticalLayout {
                    alignment: center;
                    spacing: 8px;
                    HorizontalLayout {
                        alignment: center;
                        Icon { d: Icons.phone-off; tint: #ffffff; size: 30px; }
                    }
                    Text {
                        text: "Reject";
                        color: #ffffff;
                        font-size: 17px;
                        font-weight: 700;
                        horizontal-alignment: center;
                    }
                }
            }
            Rectangle {
                horizontal-stretch: 1;
                height: 104px;
                border-radius: 18px;
                background: ans.pressed
                    ? @linear-gradient(180deg, #1f9a55 0%, #178045 100%)
                    : @linear-gradient(180deg, #2bb768 0%, #1f9a55 100%);
                ans := TouchArea {
                    clicked => {
                        root.answer();
                    }
                }
                VerticalLayout {
                    alignment: center;
                    spacing: 8px;
                    HorizontalLayout {
                        alignment: center;
                        Icon { d: Icons.phone; tint: #ffffff; size: 30px; }
                    }
                    Text {
                        text: "Answer";
                        color: #ffffff;
                        font-size: 17px;
                        font-weight: 700;
                        horizontal-alignment: center;
                    }
                }
            }
        }
    }
}

component DialKey inherits Rectangle {
    in property <string> text;
    in property <string> sub;
    callback clicked;
    callback long-press;
    property <bool> held: false;
    height: 76px;
    border-radius: 16px;
    border-width: 1px;
    border-color: Palette.line2;
    background: touch.pressed ? #1b2836 : @linear-gradient(180deg, #17222f 0%, #0f1822 100%);
    hold-timer := Timer {
        interval: 450ms;
        running: false;
        triggered => {
            self.running = false;
            root.held = true;
            root.long-press();
        }
    }
    touch := TouchArea {
        pointer-event(ev) => {
            if (ev.kind == PointerEventKind.down) {
                root.held = false;
                hold-timer.running = true;
            }
            if (ev.kind == PointerEventKind.up) {
                hold-timer.running = false;
                if (!root.held) {
                    root.clicked();
                }
            }
            if (ev.kind == PointerEventKind.cancel) {
                hold-timer.running = false;
            }
        }
    }
    VerticalLayout {
        alignment: center;
        spacing: 0px;
        Text {
            text: root.text;
            color: #e8f0f6;
            font-size: 26px;
            font-weight: 600;
            horizontal-alignment: center;
        }
        if root.sub != "": Text {
            text: root.sub;
            color: Palette.faint;
            font-size: 14px;
            font-weight: 700;
            letter-spacing: 1px;
            horizontal-alignment: center;
        }
    }
}

component DialerScreen inherits Rectangle {
    in property <string> number;
    in property <string> recent-hint;
    // Selectable targets: index 0 = Private (ISSI), then one per codeplug gateway.
    in property <[DialTarget]> targets: [{ label: "Private", max-len: 8 }];
    // Currently selected target index.
    property <int> sel: 0;
    // Digit cap for the current target (private ISSI = 8; gateway = 24 - prefix).
    property <int> max-len: root.sel < root.targets.length ? root.targets[root.sel].max-len : 8;
    property <bool> is-private: root.sel == 0;
    callback key(string);
    // place-call(target-index, duplex)
    callback place-call(int, bool);
    callback open-recents;
    callback open-contacts;
    background: transparent;
    VerticalLayout {
        padding: 18px;
        spacing: 12px;

        // Target selector: Private + one button per gateway. Equal-width buttons,
        // up to 4 per row and 2 rows (so up to 8 targets shown).
        VerticalLayout {
            spacing: 8px;
            HorizontalLayout {
                spacing: 8px;
                if root.targets.length > 0: TargetSeg {
                    label: root.targets[0].label;
                    selected: root.sel == 0;
                    clicked => { root.sel = 0; root.key("max\{root.targets[0].max-len}"); }
                }
                if root.targets.length > 1: TargetSeg {
                    label: root.targets[1].label;
                    selected: root.sel == 1;
                    clicked => { root.sel = 1; root.key("max\{root.targets[1].max-len}"); }
                }
                if root.targets.length > 2: TargetSeg {
                    label: root.targets[2].label;
                    selected: root.sel == 2;
                    clicked => { root.sel = 2; root.key("max\{root.targets[2].max-len}"); }
                }
                if root.targets.length > 3: TargetSeg {
                    label: root.targets[3].label;
                    selected: root.sel == 3;
                    clicked => { root.sel = 3; root.key("max\{root.targets[3].max-len}"); }
                }
            }
            if root.targets.length > 4: HorizontalLayout {
                spacing: 8px;
                TargetSeg {
                    label: root.targets[4].label;
                    selected: root.sel == 4;
                    clicked => { root.sel = 4; root.key("max\{root.targets[4].max-len}"); }
                }
                if root.targets.length > 5: TargetSeg {
                    label: root.targets[5].label;
                    selected: root.sel == 5;
                    clicked => { root.sel = 5; root.key("max\{root.targets[5].max-len}"); }
                }
                if root.targets.length > 6: TargetSeg {
                    label: root.targets[6].label;
                    selected: root.sel == 6;
                    clicked => { root.sel = 6; root.key("max\{root.targets[6].max-len}"); }
                }
                if root.targets.length > 7: TargetSeg {
                    label: root.targets[7].label;
                    selected: root.sel == 7;
                    clicked => { root.sel = 7; root.key("max\{root.targets[7].max-len}"); }
                }
            }
        }

        // Top area shows the typed number (or the prompt when empty); the Recent
        // calls card stays pinned just above the keypad either way.
        Rectangle {
            vertical-stretch: 1;
            VerticalLayout {
                spacing: 0px;
                Rectangle {
                    vertical-stretch: 1;
                    if root.number != "": Text {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        text: root.number;
                        color: #ffffff;
                        font-size: 44px;
                        font-weight: 800;
                        letter-spacing: 2px;
                        horizontal-alignment: center;
                        overflow: elide;
                    }
                    if root.number == "": Text {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        text: "Enter a number";
                        color: Palette.faint;
                        font-size: 28px;
                        font-weight: 700;
                        horizontal-alignment: center;
                    }
                }
                // Recent calls + Contacts, side by side, pinned above the keypad.
                HorizontalLayout {
                    spacing: 10px;
                    // Recent calls.
                    Rectangle {
                        height: 78px;
                        horizontal-stretch: 1;
                        border-radius: 16px;
                        border-width: 1px;
                        border-color: Palette.line2;
                        background: rec-ta.pressed ? #16202b : Palette.surface;
                        rec-ta := TouchArea {
                            clicked => {
                                root.open-recents();
                            }
                        }
                        HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 14px;
                            spacing: 12px;
                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 46px;
                                    height: 46px;
                                    border-radius: 13px;
                                    background: #33a7dd1f;
                                    Icon {
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                        d: Icons.phone;
                                        tint: Palette.accent;
                                        size: 22px;
                                    }
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                horizontal-stretch: 1;
                                Text {
                                    text: "Recents";
                                    color: Palette.txt;
                                    font-size: 19px;
                                    font-weight: 700;
                                    overflow: elide;
                                }
                            }
                        }
                    }
                    // Contacts.
                    Rectangle {
                        height: 78px;
                        horizontal-stretch: 1;
                        border-radius: 16px;
                        border-width: 1px;
                        border-color: Palette.line2;
                        background: con-ta.pressed ? #16202b : Palette.surface;
                        con-ta := TouchArea {
                            clicked => {
                                root.open-contacts();
                            }
                        }
                        HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 14px;
                            spacing: 12px;
                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 46px;
                                    height: 46px;
                                    border-radius: 13px;
                                    background: #37c06a24;
                                    Icon {
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                        d: Icons.users;
                                        tint: #6fe0a0;
                                        size: 22px;
                                    }
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                horizontal-stretch: 1;
                                Text {
                                    text: "Contacts";
                                    color: Palette.txt;
                                    font-size: 19px;
                                    font-weight: 700;
                                    overflow: elide;
                                }
                            }
                        }
                    }
                }
            }
        }

        // Keypad.
        for row in [["1", "2", "3"], ["4", "5", "6"], ["7", "8", "9"], ["*", "0", "#"]]: HorizontalLayout {
            spacing: 10px;
            for d in row: DialKey {
                text: d;
                sub: d == "0" ? "+" : "";
                horizontal-stretch: 1;
                clicked => {
                    if root.number.character-count < root.max-len {
                        root.key(d);
                    }
                }
                long-press => {
                    // Long-press 0 inserts a leading "+" for international numbers.
                    if d == "0" && root.number.character-count < root.max-len {
                        root.key("+");
                    }
                }
            }
        }

        // Action row below the keypad: Delete | Call (duplex, green) | Backspace.
        HorizontalLayout {
            spacing: 10px;
            // Delete (clear the whole number).
            Rectangle {
                height: 66px;
                horizontal-stretch: 1;
                border-radius: 16px;
                border-width: 1px;
                border-color: Palette.line2;
                background: cltouch.pressed ? #1b2836 : Palette.surface;
                opacity: root.number == "" ? 0.4 : 1.0;
                cltouch := TouchArea {
                    enabled: root.number != "";
                    clicked => {
                        root.key("clear");
                    }
                }
                Icon {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    d: Icons.close;
                    tint: Palette.muted;
                    size: 24px;
                }
            }
            // Call (DUPLEX), green.
            Rectangle {
                height: 66px;
                horizontal-stretch: 1;
                border-radius: 16px;
                border-width: 1px;
                border-color: #2bb76880;
                background: root.number == "" ? Palette.surface : (ctouch.pressed ? #17402a : @linear-gradient(180deg, #2bb768 0%, #1f9a55 100%));
                opacity: root.number == "" ? 0.5 : 1.0;
                ctouch := TouchArea {
                    enabled: root.number != "";
                    clicked => {
                        // Green Call = duplex.
                        root.place-call(root.sel, true);
                    }
                }
                Icon {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    d: Icons.phone;
                    tint: root.number == "" ? Palette.muted : #ffffff;
                    size: 24px;
                }
            }
            // Backspace (delete last digit).
            Rectangle {
                height: 66px;
                horizontal-stretch: 1;
                border-radius: 16px;
                border-width: 1px;
                border-color: Palette.line2;
                background: bstouch.pressed ? #1b2836 : Palette.surface;
                opacity: root.number == "" ? 0.4 : 1.0;
                bstouch := TouchArea {
                    enabled: root.number != "";
                    clicked => {
                        root.key("back");
                    }
                }
                Icon {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    d: Icons.backspace;
                    tint: Palette.muted;
                    size: 24px;
                }
            }
        }

        // Extra distance between the action row and the PTT.
        Rectangle { height: 26px; }

        // Docked PTT: press to place a SIMPLEX (PTT) private call. Only for
        // Private calls; gateway (PABX/PSTN) calls are duplex only, use Call.
        Ptt {
            text: root.is-private ? "Push to talk" : "PTT (private only)";
            enabled: root.number != "" && root.is-private;
            state: 0;
            press-down => {
                root.place-call(root.sel, false);
            }
        }
    }
}

// Parked keypad layout for non-touch device models.
component KeypadHome inherits FocusScope {
    property <[string]> items: ["Talkgroups", "Logs", "Radio info", "Settings"];
    property <int> selected: 0;
    init => {
        self.focus();
    }
    key-pressed(event) => {
        if (event.text == Key.UpArrow) {
            root.selected = Math.max(0, root.selected - 1);
            return accept;
        }
        if (event.text == Key.DownArrow) {
            root.selected = Math.min(root.items.length - 1, root.selected + 1);
            return accept;
        }
        return reject;
    }
    VerticalLayout {
        padding: 18px;
        spacing: 12px;
        alignment: start;
        Text {
            text: "Keypad layout - Up/Down to move";
            color: Palette.muted;
            font-size: 15px;
        }
        for item[idx] in root.items: Rectangle {
            height: 56px;
            border-radius: 10px;
            border-width: 1px;
            background: idx == root.selected ? #1f6feb : Palette.surface;
            border-color: idx == root.selected ? #4a8bff : Palette.line;
            HorizontalLayout {
                padding-left: 16px;
                Text {
                    text: item;
                    color: Palette.txt;
                    font-size: 18px;
                    vertical-alignment: center;
                }
            }
        }
        Rectangle { vertical-stretch: 1; }
    }
}

export component MainWindow inherits Window {
    title: "TETRA TN UI";
    default-font-family: "Inter";
    default-font-size: 15px;
    // Fixed size (logical px), set from config; makes the window non-resizable so
    // content (e.g. the event log) never stretches it.
    in property <length> win-width: 720px;
    in property <length> win-height: 1280px;
    width: root.win-width;
    height: root.win-height;
    background: @linear-gradient(180deg, #0f1620 0%, #0a0f16 100%);

    in property <DeviceInput> device-input: DeviceInput.Touch;
    in property <bool> show-event-log: true;
    in-out property <Screen> screen: Screen.Home;

    // --- Navigation history (breadcrumb stack) ---
    // Back returns to where the user actually came from, not a fixed parent.
    // Forward navigations are recorded automatically via `changed screen`; the
    // Back softkey pops this stack. Programmatic returns use `nav-return()`.
    property <Screen> nav0;
    property <Screen> nav1;
    property <Screen> nav2;
    property <Screen> nav3;
    property <Screen> nav4;
    property <Screen> nav5;
    property <Screen> nav6;
    property <Screen> nav7;
    property <int> nav-sp: 0;            // number of entries on the stack
    property <Screen> nav-prev: Screen.Home; // the screen before the current one
    property <bool> nav-going-back: false;   // suppress recording during back/return

    function nav-push(s: Screen) {
        if (root.nav-sp == 0) { root.nav0 = s; }
        if (root.nav-sp == 1) { root.nav1 = s; }
        if (root.nav-sp == 2) { root.nav2 = s; }
        if (root.nav-sp == 3) { root.nav3 = s; }
        if (root.nav-sp == 4) { root.nav4 = s; }
        if (root.nav-sp == 5) { root.nav5 = s; }
        if (root.nav-sp == 6) { root.nav6 = s; }
        if (root.nav-sp == 7) { root.nav7 = s; }
        if (root.nav-sp < 8) { root.nav-sp = root.nav-sp + 1; }
    }
    function nav-pop() -> Screen {
        if (root.nav-sp <= 0) { root.nav-sp = 0; return Screen.Home; }
        root.nav-sp = root.nav-sp - 1;
        if (root.nav-sp == 0) { return root.nav0; }
        if (root.nav-sp == 1) { return root.nav1; }
        if (root.nav-sp == 2) { return root.nav2; }
        if (root.nav-sp == 3) { return root.nav3; }
        if (root.nav-sp == 4) { return root.nav4; }
        if (root.nav-sp == 5) { return root.nav5; }
        if (root.nav-sp == 6) { return root.nav6; }
        return root.nav7;
    }
    // Value of stack slot `i` (for the unwind search).
    // (unwind uses the inline chain in nav-return.)

    // Record forward navigations automatically. Returning to Home resets the
    // stack (Home is the root).
    changed screen => {
        if (root.nav-going-back) {
            root.nav-going-back = false;
        } else {
            if (root.nav-prev == Screen.Home) {
                root.nav-sp = 0;
            }
            root.nav-push(root.nav-prev);
        }
        if (root.screen == Screen.Home) {
            root.nav-sp = 0;
        }
        root.nav-prev = root.screen;
    }

    // The Back softkey target: pop the history.
    function nav-back() {
        root.nav-going-back = true;
        root.screen = root.nav-pop();
    }

    // Programmatic return to `t` (after save/delete/cancel). If `t` is already in
    // the history, unwind to it so Back continues to its real parent; otherwise
    // just replace the current screen without recording it.
    callback nav-return(Screen);
    nav-return(t) => {
        root.nav-going-back = true;
        if (root.nav-sp > 7 && root.nav7 == t) { root.nav-sp = 7; }
        else if (root.nav-sp > 6 && root.nav6 == t) { root.nav-sp = 6; }
        else if (root.nav-sp > 5 && root.nav5 == t) { root.nav-sp = 5; }
        else if (root.nav-sp > 4 && root.nav4 == t) { root.nav-sp = 4; }
        else if (root.nav-sp > 3 && root.nav3 == t) { root.nav-sp = 3; }
        else if (root.nav-sp > 2 && root.nav2 == t) { root.nav-sp = 2; }
        else if (root.nav-sp > 1 && root.nav1 == t) { root.nav-sp = 1; }
        else if (root.nav-sp > 0 && root.nav0 == t) { root.nav-sp = 0; }
        root.screen = t;
    }

    // Auto-open the in-call screen while an individual call is live, and leave it
    // when the call ends (mirrors the web UI pushing/popping the call view).
    changed call-live => {
        if (root.call-live) {
            root.screen = Screen.InCall;
        } else if (root.screen == Screen.InCall) {
            root.screen = Screen.Home;
        }
    }


    // Live state (set from Rust off MsRuntimeState + channel status).
    in property <bool> control-connected;
    in property <bool> telemetry-connected;
    in property <string> reg-state: "Idle";
    in property <string> service-status: "Out of service";
    in property <bool> in-service;
    in property <bool> registered;
    in property <bool> registering;
    in property <int> signal-bars;
    in property <string> rssi: "--";
    in property <string> issi: "--";
    in property <string> network: "0 / 0";
    in property <string> serving-la: "0";
    in property <string> colour-code: "0";
    in property <int> attached-count;
    in property <bool> scan-active;
    in property <bool> has-codeplug;
    in property <string> talkgroup-name: "No group";
    in property <string> talkgroup-id: "--";
    in property <string> tg-sub: "";
    in property <string> badge: "";
    in property <int> badge-kind;
    in property <bool> can-cycle;
    in property <bool> select-enabled;
    in property <bool> show-cancel-select;
    in property <bool> ptt-enabled;
    in property <string> ptt-label: "Register to talk";
    in property <string> folder-name: "Talkgroups";
    in property <string> home-display: "";
    in property <int> sel-folder;
    in property <[FolderRow]> folders;
    in property <[ContactRow]> contacts;
    in property <string> contact-query;
    in property <[ConvRow]> conversations;
    in property <[MsgRow]> msg-thread;
    in property <string> msg-thread-title;
    in property <string> msg-draft;
    in property <bool> msg-shift;
    in property <string> msg-new-issi;
    in property <int> msg-unread;
    in property <int> msg-scroll-tick;
    // Codeplug programming: generic list + generic edit form (Rust-driven).
    in property <string> prog-title: "Programming";
    in property <[EntityRow]> prog-rows;
    in property <string> prog-empty: "Nothing programmed";
    in property <string> prog-add-label: "Add";
    in property <string> form-title: "Edit";
    in property <[FormField]> form-fields;
    in property <int> form-focus: -1;
    in property <bool> form-shift;
    in property <bool> form-can-delete;
    in property <bool> form-from-tree;
    in property <[TreeRow]> tree-rows;
    // Ringtone settings (UI-only preference).
    in property <[EntityRow]> ringtones;
    in property <int> ringtone-sel;
    in property <int> ring-category;
    in property <bool> ring-enabled;
    // Recents / call log.
    in property <[RecentRow]> recents;
    in property <bool> recents-missed-only;
    in property <int> missed-calls;
    in property <string> dial-recent-hint;
    in property <string> recent-detail-title;
    in property <string> recent-detail-sub;
    in property <string> recent-detail-time;
    in property <int> recent-detail-kind;
    in property <bool> recent-detail-outgoing;
    in property <bool> recent-detail-can-call;
    in property <bool> recent-detail-can-ptt;
    in property <bool> recent-detail-can-message;
    in property <bool> recent-detail-can-add;
    in property <[DialTarget]> dial-targets: [{ label: "Private", max-len: 8 }];
    // Contact detail page.
    in property <int> detail-index: -1;
    in property <string> detail-name;
    in property <string> detail-callsign;
    in property <string> detail-sub;
    in property <bool> detail-is-phone;
    // Contact editor form.
    in property <string> edit-title: "New contact";
    in property <string> edit-name;
    in property <string> edit-callsign;
    in property <string> edit-issi;
    in property <string> edit-number;
    in property <bool> edit-is-phone;
    in property <int> edit-focus;
    in property <bool> edit-numeric;
    in property <bool> edit-shift;
    in property <int> edit-target-sel;
    in property <bool> restart-required;
    in property <string> clock: "--:--:--";
    in property <string> date: "";
    in property <string> dial-number: "";
    in property <[LogRow]> logs;
    in property <int> unread;
    in property <[GroupRow]> groups;
    in property <[ScanRow]> scanlists;
    in property <bool> alert-visible;
    in property <string> alert-title;
    in property <string> alert-message;
    in property <int> alert-kind;
    in property <string> config-toml: "";
    in property <bool> survey-manual;
    in property <bool> survey-scanning;
    in property <string> survey-status: "";
    in property <[SurveyRow]> survey-rows;
    in property <bool> call-live;
    in property <string> call-dir: "";
    in property <string> call-peer: "";
    in property <string> call-sub: "";
    in property <string> call-state: "";
    in property <string> call-clock: "";
    in property <bool> call-can-ptt;
    in property <int> call-ptt-state;
    in property <bool> call-muted;
    in property <bool> call-dtmf;
    in property <string> call-digits: "";
    in property <bool> call-incoming;
    in property <string> incoming-peer: "";
    in property <string> incoming-sub: "";
    in property <bool> group-call-active;
    in property <string> group-call-name: "";
    in property <string> group-call-status: "";
    in property <string> group-talker-id: "";
    in property <int> group-ptt-state;

    callback register;
    callback deregister;
    callback cycle-prev;
    callback cycle-next;
    callback select-talkgroup;
    callback cancel-select;
    callback select-folder(int);
    callback ptt;
    callback dial-key(string);
    callback dial-call(int, bool);
    callback call-dtmf-key(string);
    callback call-contact(int, bool);
    callback open-contact(int);
    callback contact-search-key(string);
    callback contact-search-backspace;
    callback contact-search-clear;
    callback contact-new;
    callback open-messages;
    callback open-thread(int);
    callback message-contact(int);
    callback msg-new;
    callback msg-new-key(string);
    callback msg-new-backspace;
    callback msg-new-start;
    callback msg-key(string);
    callback msg-backspace;
    callback msg-shift-toggle;
    callback msg-send;
    callback msg-delete(int);
    callback msg-delete-thread(int, bool);
    callback contact-edit(int);
    callback contact-delete(int);
    callback contact-save;
    callback contact-cancel;
    callback edit-set-focus(int);
    callback edit-key(string);
    callback edit-backspace;
    callback edit-shift-toggle;
    callback edit-target(int);
    // Codeplug programming callbacks.
    callback open-program;
    callback prog-section(int);
    callback prog-open(int);
    callback prog-add;
    callback form-pick(int);
    callback form-key(string);
    callback form-backspace;
    callback form-shift-toggle;
    callback form-toggle(int);
    callback form-cycle(int);
    callback form-save;
    callback form-cancel;
    callback form-delete;
    callback open-tree;
    callback tree-folder(int);
    callback tree-toggle(int);
    callback tree-group(int);
    callback tree-add-group(int);
    callback tree-add-folder;
    callback tree-move-up(int);
    callback tree-move-down(int);
    callback open-ringtones;
    callback open-settings;
    callback ring-select(int);
    callback ring-toggle;
    callback ring-pick-category(int);
    callback open-recents;
    callback recents-open(int);
    callback recents-call(int);
    callback recents-delete(int);
    callback recents-filter(bool);
    callback recents-clear;
    callback recent-call-duplex;
    callback recent-call-ptt;
    callback recent-message;
    callback recent-add-contact;
    callback recent-delete;
    callback open-logs;
    callback alert-dismiss;
    callback group-select(int, int);
    callback group-attach(int, int);
    callback group-detach(int);
    callback scanlist-toggle(string, bool);
    callback apply-config;
    callback refresh;
    callback survey-toggle-mode;
    callback survey-scan;
    callback survey-stop;
    callback survey-camp(int, bool);
    callback call-ptt-down;
    callback call-ptt-up;
    callback group-ptt-down;
    callback group-ptt-up;
    callback answer-call;
    callback reject-call;
    callback hangup-call;
    callback hangup-group;
    callback toggle-mute;

    // Detail of the event currently open on the LogDetail screen.
    property <string> detail-variant;
    property <string> detail-time;
    property <string> detail-body;

    function screen-title() -> string {
        if (root.screen == Screen.Menu) {
            return "Menu";
        }
        if (root.screen == Screen.Info) {
            return "Radio Info";
        }
        if (root.screen == Screen.Network) {
            return "Network";
        }
        if (root.screen == Screen.Folders) {
            return "Folders";
        }
        if (root.screen == Screen.Dialer) {
            return "Dialer";
        }
        if (root.screen == Screen.Logs) {
            return "Event Log";
        }
        if (root.screen == Screen.LogDetail) {
            return "Event";
        }
        if (root.screen == Screen.Groups) {
            return "Talkgroups";
        }
        if (root.screen == Screen.Config) {
            return "Config";
        }
        if (root.screen == Screen.Program) {
            return "Programming";
        }
        if (root.screen == Screen.Tree) {
            return "Talkgroups";
        }
        if (root.screen == Screen.Ringtones) {
            return "Ringtone";
        }
        if (root.screen == Screen.Settings) {
            return "Settings";
        }
        if (root.screen == Screen.Recents) {
            return "Recents";
        }
        if (root.screen == Screen.RecentDetail) {
            return root.recent-detail-title == "" ? "Call" : root.recent-detail-title;
        }
        if (root.screen == Screen.ProgramList) {
            return root.prog-title;
        }
        if (root.screen == Screen.ProgramEdit) {
            return root.form-title;
        }
        if (root.screen == Screen.Contacts) {
            return "Contacts";
        }
        if (root.screen == Screen.Messages) {
            return "Messages";
        }
        if (root.screen == Screen.MsgThread) {
            return root.msg-thread-title == "" ? "Conversation" : root.msg-thread-title;
        }
        if (root.screen == Screen.MsgNew) {
            return "New message";
        }
        if (root.screen == Screen.ContactDetail) {
            return root.detail-name == "" ? "Contact" : root.detail-name;
        }
        if (root.screen == Screen.ContactEdit) {
            return root.edit-title;
        }
        if (root.screen == Screen.Survey) {
            return "Cell Survey";
        }
        if (root.screen == Screen.InCall) {
            return "Call";
        }
        return root.clock + "   " + root.date;
    }

    VerticalLayout {
        width: 100%;
        height: 100%;
        StatusBar {
            bars: root.signal-bars;
            registered: root.registered;
            registering: root.registering;
            in-service: root.in-service;
            network: root.network;
            scan: root.scan-active;
            control-on: root.control-connected;
            telemetry-on: root.telemetry-connected;
        }

        Header {
            title: root.screen-title();
            muted: root.screen == Screen.Home;
        }

        if root.device-input == DeviceInput.Touch && root.screen == Screen.Home: HomeScreen {
            vertical-stretch: 1;
            has-codeplug: root.has-codeplug;
            folder-name: root.folder-name;
            home-display: root.home-display;
            talkgroup-name: root.talkgroup-name;
            tg-sub: root.tg-sub;
            badge: root.badge;
            badge-kind: root.badge-kind;
            can-cycle: root.can-cycle;
            attached-count: root.attached-count;
            scan-active: root.scan-active;
            select-enabled: root.select-enabled;
            show-cancel: root.show-cancel-select;
            ptt-enabled: root.ptt-enabled;
            ptt-label: root.ptt-label;
            group-call-active: root.group-call-active;
            group-call-name: root.group-call-name;
            group-call-status: root.group-call-status;
            group-talker-id: root.group-talker-id;
            group-ptt-state: root.group-ptt-state;
            cycle-prev => {
                root.cycle-prev();
            }
            cycle-next => {
                root.cycle-next();
            }
            select-tg => {
                root.select-talkgroup();
            }
            cancel-select => {
                root.cancel-select();
            }
            open-folders => {
                root.screen = Screen.Folders;
            }
            ptt => {
                root.ptt();
            }
            group-ptt-down => {
                root.group-ptt-down();
            }
            group-ptt-up => {
                root.group-ptt-up();
            }
            hangup-group => {
                root.hangup-group();
            }
        }

        if root.device-input == DeviceInput.Touch && root.screen == Screen.Menu: MenuScreen {
            vertical-stretch: 1;
            registered: root.registered;
            unread: root.unread;
            unread-messages: root.msg-unread;
            missed-calls: root.missed-calls;
            show-event-log: root.show-event-log;
            open-info => {
                root.screen = Screen.Info;
            }
            open-messages => {
                root.open-messages();
                root.screen = Screen.Messages;
            }
            open-recents => {
                root.open-recents();
                root.screen = Screen.Recents;
            }
            open-groups => {
                root.screen = Screen.Groups;
            }
            open-contacts => {
                root.contact-search-clear();
                root.screen = Screen.Contacts;
            }
            open-logs => {
                root.open-logs();
                root.screen = Screen.Logs;
            }
            open-config => {
                root.refresh();
                root.screen = Screen.Config;
            }
            open-program => {
                root.screen = Screen.Program;
            }
            open-settings => {
                root.open-settings();
            }
            open-network => {
                root.screen = Screen.Network;
            }
            open-survey => {
                root.refresh();
                root.screen = Screen.Survey;
            }
        }

        if root.device-input == DeviceInput.Touch && root.screen == Screen.Logs: LogsScreen {
            vertical-stretch: 1;
            logs: root.logs;
            open(v, t, d) => {
                root.detail-variant = v;
                root.detail-time = t;
                root.detail-body = d;
                root.screen = Screen.LogDetail;
            }
        }

        if root.device-input == DeviceInput.Touch && root.screen == Screen.LogDetail: LogDetailScreen {
            vertical-stretch: 1;
            variant: root.detail-variant;
            time: root.detail-time;
            body: root.detail-body;
        }

        if root.device-input == DeviceInput.Touch && root.screen == Screen.Folders: FoldersScreen {
            vertical-stretch: 1;
            folders: root.folders;
            select-folder(i) => {
                root.select-folder(i);
                root.screen = Screen.Home;
            }
        }

        if root.device-input == DeviceInput.Touch && root.screen == Screen.Groups: GroupsScreen {
            vertical-stretch: 1;
            groups: root.groups;
            scanlists: root.scanlists;
            select(g, c) => {
                root.group-select(g, c);
            }
            add(g, c) => {
                root.group-attach(g, c);
            }
            detach(g) => {
                root.group-detach(g);
            }
            toggle-scan(n, a) => {
                root.scanlist-toggle(n, a);
            }
        }

        if root.device-input == DeviceInput.Touch && root.screen == Screen.Info: InfoScreen {
            vertical-stretch: 1;
            reg-state: root.reg-state;
            registered: root.registered;
            service-status: root.service-status;
            in-service: root.in-service;
            issi: root.issi;
            network: root.network;
            serving-la: root.serving-la;
            colour-code: root.colour-code;
            rssi: root.rssi;
            attached-count: root.attached-count;
            restart-required: root.restart-required;
        }

        if root.device-input == DeviceInput.Touch && root.screen == Screen.Network: NetworkScreen {
            vertical-stretch: 1;
            reg-state: root.reg-state;
            registered: root.registered;
            service-status: root.service-status;
            in-service: root.in-service;
            issi: root.issi;
            network: root.network;
            serving-la: root.serving-la;
            colour-code: root.colour-code;
            rssi: root.rssi;
            attached-count: root.attached-count;
            restart-required: root.restart-required;
            open-survey => {
                root.refresh();
                root.screen = Screen.Survey;
            }
            register => {
                root.register();
            }
            deregister => {
                root.deregister();
            }
        }

        if root.device-input == DeviceInput.Touch && root.screen == Screen.Config: ConfigScreen {
            vertical-stretch: 1;
            toml: root.config-toml;
            apply => {
                root.apply-config();
            }
            refresh => {
                root.refresh();
            }
        }

        if root.device-input == DeviceInput.Touch && root.screen == Screen.Program: ProgHubScreen {
            vertical-stretch: 1;
            open-section(s) => {
                root.prog-section(s);
            }
            open-tree => {
                root.open-tree();
            }
        }

        if root.device-input == DeviceInput.Touch && root.screen == Screen.Tree: TreeScreen {
            vertical-stretch: 1;
            rows: root.tree-rows;
            folder(i) => {
                root.tree-folder(i);
            }
            toggle(i) => {
                root.tree-toggle(i);
            }
            group(i) => {
                root.tree-group(i);
            }
            add-group(i) => {
                root.tree-add-group(i);
            }
            add-folder => {
                root.tree-add-folder();
            }
            move-up(i) => {
                root.tree-move-up(i);
            }
            move-down(i) => {
                root.tree-move-down(i);
            }
        }

        if root.device-input == DeviceInput.Touch && root.screen == Screen.Settings: SettingsScreen {
            vertical-stretch: 1;
            open-ringtones => {
                root.open-ringtones();
            }
        }

        if root.device-input == DeviceInput.Touch && root.screen == Screen.Recents: RecentsScreen {
            vertical-stretch: 1;
            rows: root.recents;
            missed-only: root.recents-missed-only;
            open(id) => {
                root.recents-open(id);
                root.screen = Screen.RecentDetail;
            }
            call(id) => {
                root.recents-call(id);
            }
            delete(id) => {
                root.recents-delete(id);
            }
            set-filter(m) => {
                root.recents-filter(m);
            }
            clear-all => {
                root.recents-clear();
            }
        }

        if root.device-input == DeviceInput.Touch && root.screen == Screen.RecentDetail: RecentDetailScreen {
            vertical-stretch: 1;
            title: root.recent-detail-title;
            sub: root.recent-detail-sub;
            time: root.recent-detail-time;
            kind: root.recent-detail-kind;
            outgoing: root.recent-detail-outgoing;
            can-call: root.recent-detail-can-call;
            can-ptt: root.recent-detail-can-ptt;
            can-message: root.recent-detail-can-message;
            can-add: root.recent-detail-can-add;
            call-duplex => {
                root.recent-call-duplex();
            }
            call-ptt => {
                root.recent-call-ptt();
            }
            message => {
                root.recent-message();
            }
            add-contact => {
                root.recent-add-contact();
            }
            delete => {
                root.recent-delete();
            }
        }

        if root.device-input == DeviceInput.Touch && root.screen == Screen.Ringtones: RingtoneScreen {
            vertical-stretch: 1;
            tones: root.ringtones;
            selected: root.ringtone-sel;
            category: root.ring-category;
            enabled: root.ring-enabled;
            toggle => {
                root.ring-toggle();
            }
            select(i) => {
                root.ring-select(i);
            }
            pick-category(i) => {
                root.ring-pick-category(i);
            }
        }

        if root.device-input == DeviceInput.Touch && root.screen == Screen.ProgramList: EntityListScreen {
            vertical-stretch: 1;
            rows: root.prog-rows;
            empty-text: root.prog-empty;
            add-label: root.prog-add-label;
            open(i) => {
                root.prog-open(i);
            }
            add => {
                root.prog-add();
            }
        }

        if root.device-input == DeviceInput.Touch && root.screen == Screen.ProgramEdit: FormEditScreen {
            vertical-stretch: 1;
            fields: root.form-fields;
            focus-field: root.form-focus;
            shift: root.form-shift;
            can-delete: root.form-can-delete;
            title: root.form-title;
            pick(i) => {
                root.form-pick(i);
            }
            key(c) => {
                root.form-key(c);
            }
            backspace => {
                root.form-backspace();
            }
            shift-toggle => {
                root.form-shift-toggle();
            }
            toggle(i) => {
                root.form-toggle(i);
            }
            cycle(i) => {
                root.form-cycle(i);
            }
            save => {
                root.form-save();
            }
            cancel => {
                root.form-cancel();
            }
            delete => {
                root.form-delete();
            }
        }

        if root.device-input == DeviceInput.Touch && root.screen == Screen.Contacts: ContactsScreen {
            vertical-stretch: 1;
            contacts: root.contacts;
            query: root.contact-query;
            open-contact(i) => {
                root.open-contact(i);
                root.screen = Screen.ContactDetail;
            }
            call-contact(i) => {
                root.call-contact(i, true);
            }
            search-key(c) => {
                root.contact-search-key(c);
            }
            search-backspace => {
                root.contact-search-backspace();
            }
            search-clear => {
                root.contact-search-clear();
            }
            add-contact => {
                root.contact-new();
                root.screen = Screen.ContactEdit;
            }
        }

        if root.device-input == DeviceInput.Touch && root.screen == Screen.Messages: MessagesScreen {
            vertical-stretch: 1;
            conversations: root.conversations;
            open-thread(p) => {
                root.open-thread(p);
                root.screen = Screen.MsgThread;
            }
            new-message => {
                root.msg-new();
                root.screen = Screen.MsgNew;
            }
            delete-thread(p, g) => {
                root.msg-delete-thread(p, g);
            }
        }

        if root.device-input == DeviceInput.Touch && root.screen == Screen.MsgThread: MsgThreadScreen {
            vertical-stretch: 1;
            messages: root.msg-thread;
            scroll-tick: root.msg-scroll-tick;
            draft: root.msg-draft;
            shift: root.msg-shift;
            key(c) => {
                root.msg-key(c);
            }
            backspace => {
                root.msg-backspace();
            }
            shift-toggle => {
                root.msg-shift-toggle();
            }
            send => {
                root.msg-send();
            }
            delete-message(id) => {
                root.msg-delete(id);
            }
        }

        if root.device-input == DeviceInput.Touch && root.screen == Screen.MsgNew: MsgNewScreen {
            vertical-stretch: 1;
            issi: root.msg-new-issi;
            key(c) => {
                root.msg-new-key(c);
            }
            backspace => {
                root.msg-new-backspace();
            }
            start => {
                root.msg-new-start();
            }
            cancel => {
                root.screen = Screen.Messages;
            }
        }

        if root.device-input == DeviceInput.Touch && root.screen == Screen.ContactDetail: ContactDetailScreen {
            vertical-stretch: 1;
            name: root.detail-name;
            callsign: root.detail-callsign;
            sub: root.detail-sub;
            is-phone: root.detail-is-phone;
            call-duplex => {
                root.call-contact(root.detail-index, true);
            }
            call-simplex => {
                root.call-contact(root.detail-index, false);
            }
            message => {
                root.message-contact(root.detail-index);
                root.screen = Screen.MsgThread;
            }
            edit => {
                root.contact-edit(root.detail-index);
                root.screen = Screen.ContactEdit;
            }
            delete => {
                root.contact-delete(root.detail-index);
            }
        }

        if root.device-input == DeviceInput.Touch && root.screen == Screen.ContactEdit: ContactEditScreen {
            vertical-stretch: 1;
            title: root.edit-title;
            name: root.edit-name;
            callsign: root.edit-callsign;
            issi: root.edit-issi;
            number: root.edit-number;
            is-phone: root.edit-is-phone;
            focus-field: root.edit-focus;
            numeric: root.edit-numeric;
            shift: root.edit-shift;
            targets: root.dial-targets;
            target-sel: root.edit-target-sel;
            set-focus(f) => {
                root.edit-set-focus(f);
            }
            key(c) => {
                root.edit-key(c);
            }
            backspace => {
                root.edit-backspace();
            }
            shift-toggle => {
                root.edit-shift-toggle();
            }
            select-target(i) => {
                root.edit-target(i);
            }
            save => {
                root.contact-save();
            }
            cancel => {
                root.contact-cancel();
                root.screen = Screen.Contacts;
            }
        }

        if root.device-input == DeviceInput.Touch && root.screen == Screen.Survey: SurveyScreen {
            vertical-stretch: 1;
            manual: root.survey-manual;
            scanning: root.survey-scanning;
            status: root.survey-status;
            rows: root.survey-rows;
            toggle-mode => {
                root.survey-toggle-mode();
            }
            scan => {
                root.survey-scan();
            }
            stop => {
                root.survey-stop();
            }
            camp(c, r) => {
                root.survey-camp(c, r);
            }
        }

        if root.device-input == DeviceInput.Touch && root.screen == Screen.Dialer: DialerScreen {
            vertical-stretch: 1;
            number: root.dial-number;
            recent-hint: root.dial-recent-hint;
            targets: root.dial-targets;
            key(k) => {
                root.dial-key(k);
            }
            place-call(t, d) => {
                root.dial-call(t, d);
            }
            open-recents => {
                root.open-recents();
                root.screen = Screen.Recents;
            }
            open-contacts => {
                root.contact-search-clear();
                root.screen = Screen.Contacts;
            }
        }
        if root.device-input == DeviceInput.Keypad: KeypadHome {
            vertical-stretch: 1;
        }

        if root.device-input == DeviceInput.Touch && root.screen == Screen.InCall: InCallScreen {
            vertical-stretch: 1;
            dir: root.call-dir;
            peer: root.call-peer;
            sub: root.call-sub;
            state: root.call-state;
            clock: root.call-clock;
            can-ptt: root.call-can-ptt;
            ptt-state: root.call-ptt-state;
            // In-call PTT depends only on being registered, NOT on having a home
            // TX talkgroup selected (root.ptt-enabled). A private simplex call
            // must be able to transmit with no talkgroup attached.
            ptt-enabled: root.registered;
            show-dtmf: root.call-dtmf;
            digits: root.call-digits;
            ptt-down => {
                root.call-ptt-down();
            }
            ptt-up => {
                root.call-ptt-up();
            }
            dtmf(k) => {
                root.call-dtmf-key(k);
            }
        }

        // Softkey bar: three fixed equal-width slots (LEFT / CENTER / RIGHT).
        // Each slot is a stretch:1 wrapper whose width never depends on its
        // content, so buttons stay the same size and never shift between screens.
        // Only the button shown inside each slot changes per screen.
        Rectangle {
            height: 92px;
            background: @linear-gradient(180deg, #0c141d 0%, #0a1017 100%);
            HorizontalLayout {
                padding-top: 14px;
                padding-bottom: 14px;
                padding-left: 14px;
                padding-right: 14px;
                spacing: 10px;

                // LEFT slot.
                Rectangle {
                    horizontal-stretch: 1;
                    if root.screen == Screen.Home: Softkey {
                        width: 100%;
                        height: 100%;
                        text: "Menu";
                        icon: Icons.menu;
                        clicked => {
                            root.screen = Screen.Menu;
                        }
                    }
                    if root.screen == Screen.InCall: Softkey {
                        width: 100%;
                        height: 100%;
                        text: root.call-muted ? "Unmute" : "Mute";
                        icon: root.call-muted ? Icons.mic-off : Icons.mic;
                        clicked => {
                            root.toggle-mute();
                        }
                    }
                    if root.screen != Screen.Home && root.screen != Screen.InCall: Softkey {
                        width: 100%;
                        height: 100%;
                        text: "Back";
                        icon: Icons.back;
                        clicked => {
                            root.nav-back();
                        }
                    }
                }

                // CENTER slot: Home on sub-menus, empty on Home/in-call/Menu/Dialer.
                Rectangle {
                    horizontal-stretch: 1;
                    if root.screen != Screen.Home && root.screen != Screen.InCall
                        && root.screen != Screen.Menu && root.screen != Screen.Dialer: Softkey {
                        width: 100%;
                        height: 100%;
                        text: "Home";
                        icon: Icons.home;
                        clicked => {
                            root.screen = Screen.Home;
                        }
                    }
                }

                // RIGHT slot.
                Rectangle {
                    horizontal-stretch: 1;
                    if root.screen == Screen.Home && !root.group-call-active: Softkey {
                        width: 100%;
                        height: 100%;
                        text: "Dialer";
                        icon: Icons.phone;
                        clicked => {
                            root.screen = Screen.Dialer;
                        }
                    }
                    if root.screen == Screen.Home && root.group-call-active: Softkey {
                        width: 100%;
                        height: 100%;
                        text: "Hang up";
                        icon: Icons.phone-off;
                        danger: true;
                        clicked => {
                            root.hangup-group();
                        }
                    }
                    if root.screen == Screen.InCall: Softkey {
                        width: 100%;
                        height: 100%;
                        text: "Hang up";
                        icon: Icons.phone-off;
                        danger: true;
                        clicked => {
                            root.hangup-call();
                        }
                    }
                }
            }
        }
    }

    if root.call-incoming: IncomingOverlay {
        peer: root.incoming-peer;
        sub: root.incoming-sub;
        answer => {
            root.answer-call();
        }
        reject => {
            root.reject-call();
        }
    }

    if root.alert-visible: AlertOverlay {
        title: root.alert-title;
        message: root.alert-message;
        kind: root.alert-kind;
        dismiss => {
            root.alert-dismiss();
        }
    }
}
