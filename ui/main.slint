// TETRA TN UI - Slint UI (Pi touch), styled to match the browser
// tetra-tn-web-ui (Classic-style radio). Device frame of status bar + header +
// stage + softkey grid; home is the talkgroup cycler with the select action
// directly below and a docked PTT; Menu and Dialer reachable from the home
// softkeys. Bundled Inter font, SVG-path icons, large touch metrics. Live values
// are `in` properties set from Rust (app.rs) off MsRuntimeState.

// Bundle the Inter font (matches the web UI) so the look is consistent on
// Windows and the Pi regardless of installed system fonts.
import "fonts/Inter-Regular.ttf";
import "fonts/Inter-Medium.ttf";
import "fonts/Inter-SemiBold.ttf";
import "fonts/Inter-Bold.ttf";
import "fonts/Inter-ExtraBold.ttf";

export enum DeviceInput { Touch, Keypad }
enum Screen { Home, Menu, Info, Folders, Dialer, Logs, LogDetail, Groups, Config, Survey, InCall }

export struct FolderRow {
    name: string,
    count: int,
    selected: bool,
}

export struct LogRow {
    time: string,
    variant: string,
    summary: string,
    detail: string,
}

export struct GroupRow {
    gssi: int,
    name: string,
    sub: string,
    tag: int, // 0 none, 1 scan, 2 tx
    cou: int,
    attached: bool,
    is-tx: bool,
}

export struct ScanRow {
    name: string,
    sub: string,
    active: bool,
}

export struct SurveyRow {
    carrier: int,
    title: string,
    sub1: string,
    sub2: string,
}

// Palette lifted from the web UI's :root custom properties.
global Palette {
    out property <color> bg: #06080b;
    out property <color> glass1: #0f1620;
    out property <color> glass2: #0a0f16;
    out property <color> surface: #131c26;
    out property <color> surface2: #17222f;
    out property <color> line: #ffffff12;
    out property <color> line2: #ffffff21;
    out property <color> txt: #eaf0f5;
    out property <color> muted: #8b98a5;
    out property <color> faint: #58656f;
    out property <color> accent: #33a7dd;
    out property <color> green: #37c06a;
    out property <color> red: #f0555a;
    out property <color> amber: #e7a72b;
}

// Line icon rendered from an SVG path (24x24 viewbox), like the web UI icons.
component Icon inherits Path {
    in property <string> d;
    in property <length> size: 22px;
    in property <color> tint: Palette.txt;
    in property <float> weight: 2.0;
    width: root.size;
    height: root.size;
    viewbox-width: 24;
    viewbox-height: 24;
    commands: root.d;
    fill: transparent;
    stroke: root.tint;
    stroke-width: root.weight * 1px;
}

global Icons {
    out property <string> menu: "M4 7L20 7M4 12L20 12M4 17L20 17";
    out property <string> home: "M3 11L12 4L21 11M6 9.5V20H18V9.5";
    out property <string> phone: "M5 3.5h3.2l1.6 4-2 1.4a11 11 0 0 0 5.3 5.3l1.4-2 4 1.6V19a2 2 0 0 1-2.2 2A16.5 16.5 0 0 1 4 6.7 2 2 0 0 1 5 3.5z";
    out property <string> back: "M15 18L9 12L15 6";
    out property <string> chevron: "M9 6L15 12L9 18";
    out property <string> chevron-down: "M6 9L12 15L18 9";
    out property <string> info: "M12 3a9 9 0 1 0 0.001 0M12 11L12 16.5";
    out property <string> folder: "M3 7.5a2 2 0 0 1 2-2h3.6l2 2H19a2 2 0 0 1 2 2v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z";
    out property <string> check: "M4 12L10 18L20 6";
    out property <string> login: "M14 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4M10 8L14 12L10 16M14 12L3 12";
    out property <string> logout: "M10 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h4M16 8L20 12L16 16M20 12L9 12";
    out property <string> mic: "M12 3a3 3 0 0 1 3 3v5a3 3 0 0 1-6 0V6a3 3 0 0 1 3-3M6 11a6 6 0 0 0 12 0M12 17v4M8.5 21h7";
    out property <string> mic-off: "M9 6a3 3 0 0 1 6 0v3M15 12v-1M6 11a6 6 0 0 0 9 5.2M12 17v4M8.5 21h7M4 4l16 16";
    out property <string> backspace: "M9 5.5h11a1.5 1.5 0 0 1 1.5 1.5v10a1.5 1.5 0 0 1-1.5 1.5H9L2.5 12zM12 9.5L17 14.5M17 9.5L12 14.5";
    out property <string> users: "M9 8a3 3 0 1 0 0.01 0M3.6 19c0-3 2.5-5.2 5.4-5.2S14.4 16 14.4 19M16.5 5.5a3 3 0 0 1 0 5.8M17.6 13.9c2 .6 3.3 2.5 3.3 5.1";
    out property <string> alert: "M12 3.5L22 20H2zM12 10v4.5M12 17.4v0.01";
    out property <string> logs: "M8 7L20 7M8 12L20 12M8 17L20 17M4 7v0.01M4 12v0.01M4 17v0.01";
    out property <string> plus: "M12 5L12 19M5 12L19 12";
    out property <string> minus: "M5 12L19 12";
    out property <string> refresh: "M20 12a8 8 0 1 1-2.3-5.6M20 4v4h-4";
    out property <string> gear: "M12 2.5v3.5M12 18v3.5M2.5 12h3.5M18 12h3.5M12 15a3 3 0 1 0 0-6a3 3 0 0 0 0 6";
    out property <string> close: "M6 6L18 18M18 6L6 18";
    out property <string> phone-off: "M10.68 13.31a16 16 0 0 0 3.41 2.6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7 2 2 0 0 1 1.72 2v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.42 19.42 0 0 1-3.33-2.67m-2.67-3.34a19.79 19.79 0 0 1-3.07-8.63A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91M23 1 1 23";
    out property <string> activity: "M3 12h4l3 8l4-16l3 8h4";
    out property <string> radio: "M6.3 6.3a8 8 0 0 0 0 11.4M17.7 6.3a8 8 0 0 1 0 11.4M9.2 9.2a4 4 0 0 0 0 5.6M14.8 9.2a4 4 0 0 1 0 5.6M12 12v0.01";
}

// 5 signal bars, heights scaled up, bottom-aligned (web UI .sig).
component SignalBars inherits Rectangle {
    in property <int> bars;
    width: 32px;
    height: 20px;
    HorizontalLayout {
        spacing: 2.5px;
        alignment: start;
        for h[i] in [6, 9, 13, 16, 20]: VerticalLayout {
            alignment: end;
            Rectangle {
                width: 4px;
                height: h * 1px;
                border-radius: 1px;
                background: i < root.bars ? #dbe6ee : #35424c;
            }
        }
    }
}

// Rounded channel-link badge with a letter (web UI .lnk).
component LinkBadge inherits Rectangle {
    in property <string> label;
    in property <bool> on;
    width: 24px;
    height: 22px;
    border-radius: 7px;
    background: root.on ? #37c06a2e : #f0555a24;
    Text {
        text: root.label;
        color: root.on ? #79dfa0 : #ff9a9d;
        font-size: 12px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component Battery inherits Rectangle {
    width: 32px;
    height: 16px;
    Rectangle {
        x: 0;
        y: 0;
        width: 28px;
        height: 16px;
        border-width: 1.5px;
        border-color: #7f8f9b;
        border-radius: 3px;
        Rectangle {
            x: 2.5px;
            y: 2.5px;
            width: 17px;
            height: 11px;
            background: Palette.green;
            border-radius: 1px;
        }
    }
    Rectangle {
        x: 28px;
        y: 4.5px;
        width: 3px;
        height: 7px;
        background: #7f8f9b;
        border-radius: 1px;
    }
}

component StatusBar inherits Rectangle {
    in property <int> bars;
    in property <string> network;
    in property <bool> scan;
    in property <bool> control-on;
    in property <bool> telemetry-on;
    height: 70px;
    background: @linear-gradient(180deg, #0e1822 0%, #0b131b 100%);

    HorizontalLayout {
        padding-left: 18px;
        padding-right: 14px;
        spacing: 12px;

        VerticalLayout { alignment: center; SignalBars { bars: root.bars; } }
        VerticalLayout {
            alignment: center;
            Text {
                text: root.network;
                color: Palette.muted;
                font-size: 15px;
                font-weight: 500;
                vertical-alignment: center;
            }
        }
        VerticalLayout { alignment: center; LinkBadge { label: "C"; on: root.control-on; } }
        VerticalLayout { alignment: center; LinkBadge { label: "T"; on: root.telemetry-on; } }
        if root.scan: VerticalLayout {
            alignment: center;
            Text {
                text: "SCAN";
                color: Palette.accent;
                font-size: 13px;
                font-weight: 800;
                letter-spacing: 1.5px;
                vertical-alignment: center;
            }
        }

        Rectangle { horizontal-stretch: 1; }

        // Battery pinned flush to the far right (time lives in the header below).
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;
            Battery { }
        }
    }
}

component Header inherits Rectangle {
    in property <string> title;
    in property <bool> muted;
    height: 60px;
    background: @linear-gradient(180deg, #0e1822 0%, #0b131b 100%);
    Text {
        text: root.title;
        color: root.muted ? Palette.muted : Palette.txt;
        font-size: 19px;
        font-weight: root.muted ? 500 : 600;
        letter-spacing: root.muted ? 1px : 0.3px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component CyclerArrow inherits Rectangle {
    in property <bool> right;
    in property <bool> enabled: true;
    callback clicked;
    width: 80px;
    height: 168px;
    border-radius: 18px;
    border-width: 1px;
    border-color: Palette.line2;
    background: touch.pressed ? #1b2836 : @linear-gradient(160deg, #17222f 0%, #0f1822 100%);
    opacity: root.enabled ? 1.0 : 0.3;
    touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            root.clicked();
        }
    }
    Icon {
        x: (parent.width - self.width) / 2 + (root.right ? 2px : -2px);
        y: (parent.height - self.height) / 2;
        d: root.right ? Icons.chevron : Icons.back;
        tint: #cfe0ec;
        size: 40px;
        weight: 2.4;
    }
}

component FolderButton inherits Rectangle {
    in property <string> name;
    callback clicked;
    height: 52px;
    border-radius: 14px;
    border-width: 1px;
    border-color: Palette.line;
    background: touch.pressed ? #1b2836 : Palette.surface;
    horizontal-stretch: 0;
    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }
    HorizontalLayout {
        padding-left: 18px;
        padding-right: 16px;
        spacing: 10px;
        alignment: center;
        VerticalLayout { alignment: center; Icon { d: Icons.folder; tint: Palette.accent; size: 18px; } }
        Text {
            text: root.name;
            color: #cfe0ec;
            font-size: 17px;
            font-weight: 600;
            vertical-alignment: center;
        }
        VerticalLayout { alignment: center; Icon { d: Icons.chevron-down; tint: Palette.faint; size: 16px; } }
    }
}

component Badge inherits Rectangle {
    in property <string> text;
    in property <color> fg;
    in property <color> bg;
    height: 28px;
    border-radius: 999px;
    background: root.bg;
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        Text {
            text: root.text;
            color: root.fg;
            font-size: 12px;
            font-weight: 800;
            letter-spacing: 1.5px;
            vertical-alignment: center;
        }
    }
}

component PrimaryButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    in property <string> icon: Icons.check;
    callback clicked;
    height: 64px;
    border-radius: 16px;
    border-width: 1px;
    border-color: root.enabled ? #37c06a80 : Palette.line;
    background: root.enabled
        ? (touch.pressed ? #16321f : @linear-gradient(180deg, #16351f 0%, #10281a 100%))
        : Palette.surface;
    opacity: root.enabled ? 1.0 : 0.45;
    touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            root.clicked();
        }
    }
    HorizontalLayout {
        alignment: center;
        spacing: 10px;
        VerticalLayout {
            alignment: center;
            Icon { d: root.icon; tint: root.enabled ? #8fe6ab : Palette.muted; size: 20px; }
        }
        Text {
            text: root.text;
            color: root.enabled ? #8fe6ab : Palette.muted;
            font-size: 18px;
            font-weight: 700;
            vertical-alignment: center;
        }
    }
}

component SecondaryButton inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    callback clicked;
    height: 64px;
    border-radius: 14px;
    border-width: 1px;
    border-color: Palette.line2;
    background: touch.pressed ? #1b2836 : Palette.surface;
    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }
    HorizontalLayout {
        alignment: center;
        spacing: 10px;
        VerticalLayout {
            alignment: center;
            if root.icon != "": Icon { d: root.icon; tint: Palette.txt; size: 20px; }
        }
        Text {
            text: root.text;
            color: Palette.txt;
            font-size: 17px;
            font-weight: 600;
            vertical-alignment: center;
        }
    }
}

// Docked push-to-talk button. `state`: 0 idle, 1 requesting, 2 on air, 3 locked.
component Ptt inherits Rectangle {
    in property <string> text;
    in property <string> sub;
    in property <bool> enabled;
    in property <int> state;
    callback press-down;
    callback release;
    height: 138px;
    border-radius: 22px;
    border-width: 1px;
    border-color: root.state == 2 ? #ff5a5f
        : root.state == 1 ? #e6b53f
        : (root.enabled ? Palette.line2 : #ffffff1f);
    background: root.state == 2
        ? @linear-gradient(180deg, #d23b41 0%, #a82a2f 100%)
        : root.state == 1
            ? @linear-gradient(180deg, #7a5f1e 0%, #5c470f 100%)
            : (root.enabled
                ? (touch.pressed ? @linear-gradient(180deg, #24303d 0%, #1a2430 100%)
                                 : @linear-gradient(180deg, #1a2430 0%, #131b24 100%))
                : @linear-gradient(180deg, #1b1d22 0%, #141519 100%));
    opacity: root.enabled ? 1.0 : 0.7;
    touch := TouchArea {
        enabled: root.enabled;
        pointer-event(ev) => {
            if (ev.kind == PointerEventKind.down) {
                root.press-down();
            }
            if (ev.kind == PointerEventKind.up) {
                root.release();
            }
        }
    }
    HorizontalLayout {
        alignment: center;
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            Icon { d: Icons.mic; tint: root.enabled ? Palette.txt : Palette.muted; size: 34px; }
        }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            Text {
                text: root.text;
                color: root.enabled ? Palette.txt : Palette.muted;
                font-size: 18px;
                font-weight: 700;
                letter-spacing: 0.4px;
                horizontal-alignment: center;
            }
            if root.sub != "": Text {
                text: root.sub;
                color: root.enabled ? #b9ccd8 : Palette.muted;
                font-size: 13px;
                font-weight: 600;
                horizontal-alignment: center;
                overflow: elide;
            }
        }
    }
}

component Softkey inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <bool> danger;
    in property <bool> enabled: true;
    in property <int> badge-count;
    callback clicked;
    border-radius: 14px;
    border-width: 1px;
    border-color: root.danger ? #b5343a : Palette.line;
    background: root.danger
        ? @linear-gradient(180deg, #d23b41 0%, #a82a2f 100%)
        : (touch.pressed ? #16202b : Palette.surface);
    opacity: root.enabled ? 1.0 : 0.35;
    touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            root.clicked();
        }
    }
    HorizontalLayout {
        alignment: center;
        spacing: 8px;
        VerticalLayout {
            alignment: center;
            if root.icon != "": Icon {
                d: root.icon;
                tint: root.danger ? #ffffff : Palette.txt;
                size: 22px;
            }
        }
        Text {
            text: root.text;
            color: root.danger ? #ffffff : Palette.txt;
            font-size: 18px;
            font-weight: 600;
            vertical-alignment: center;
        }
    }
    if root.badge-count > 0: Rectangle {
        x: parent.width - self.width + 8px;
        y: -8px;
        width: max(20px, txt.preferred-width + 10px);
        height: 20px;
        border-radius: 10px;
        background: Palette.red;
        border-width: 2px;
        border-color: #0b1017;
        txt := Text {
            text: root.badge-count > 99 ? "99+" : root.badge-count;
            color: #ffffff;
            font-size: 11px;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

component InfoRow inherits HorizontalLayout {
    in property <string> label;
    in property <string> value;
    in property <color> value-color: Palette.txt;
    height: 46px;
    Text {
        text: root.label;
        color: Palette.muted;
        font-size: 17px;
        vertical-alignment: center;
    }
    Rectangle { horizontal-stretch: 1; }
    Text {
        text: root.value;
        color: root.value-color;
        font-size: 17px;
        font-weight: 600;
        vertical-alignment: center;
        horizontal-alignment: right;
    }
}

// Unified list row used across Menu, Folders and the Event Log.
component ListRow inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    in property <string> icon;
    in property <color> icon-tint: Palette.accent;
    in property <bool> danger;
    in property <string> trailing-text;
    in property <bool> selected;
    in property <bool> show-chevron: true;
    callback clicked;
    height: 92px;
    border-radius: 16px;
    border-width: 1px;
    border-color: root.selected ? #33a7dd80 : Palette.line;
    background: touch.pressed ? #16202b : (root.selected ? #33a7dd1a : Palette.surface);
    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }
    HorizontalLayout {
        padding-left: 18px;
        padding-right: 18px;
        spacing: 16px;
        if root.icon != "": VerticalLayout {
            alignment: center;
            Rectangle {
                width: 54px;
                height: 54px;
                border-radius: 15px;
                background: root.danger ? #f0555a1f : #33a7dd1f;
                Icon {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    d: root.icon;
                    tint: root.danger ? Palette.red : root.icon-tint;
                    size: 27px;
                }
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 4px;
            horizontal-stretch: 1;
            Text {
                text: root.title;
                color: root.danger ? #ff9a9d : Palette.txt;
                font-size: 21px;
                font-weight: 600;
                overflow: elide;
            }
            if root.subtitle != "": Text {
                text: root.subtitle;
                color: Palette.muted;
                font-size: 15px;
                overflow: elide;
            }
        }
        if root.trailing-text != "": VerticalLayout {
            alignment: center;
            Text {
                text: root.trailing-text;
                color: Palette.faint;
                font-size: 15px;
                font-weight: 600;
            }
        }
        if root.selected: VerticalLayout {
            alignment: center;
            Icon { d: Icons.check; tint: Palette.accent; size: 26px; }
        }
        if root.show-chevron && !root.selected && root.trailing-text == "": VerticalLayout {
            alignment: center;
            Icon { d: Icons.chevron; tint: Palette.faint; size: 22px; }
        }
    }
}

// ---- Home screen: talkgroup cycler + select action + docked PTT ----
component HomeScreen inherits Rectangle {
    in property <bool> has-codeplug;
    in property <string> folder-name;
    in property <string> talkgroup-name;
    in property <string> tg-sub;
    in property <string> badge;
    in property <int> badge-kind; // 0 not-selected, 1 scanning, 2 on-air
    in property <bool> can-cycle;
    in property <int> attached-count;
    in property <bool> scan-active;
    in property <bool> select-enabled;
    in property <bool> show-cancel;
    in property <bool> ptt-enabled;
    in property <string> ptt-label;
    in property <bool> group-call-active;
    in property <string> group-call-name;
    in property <string> group-call-status;
    in property <string> group-talker-id;
    in property <int> group-ptt-state;
    callback cycle-prev;
    callback cycle-next;
    callback select-tg;
    callback cancel-select;
    callback open-folders;
    callback ptt;
    callback group-ptt-down;
    callback group-ptt-up;
    callback hangup-group;

    property <color> badge-fg: root.badge-kind == 2 ? #ff9a9d : (root.badge-kind == 1 ? #7ecbef : Palette.muted);
    property <color> badge-bg: root.badge-kind == 2 ? #d23b4133 : (root.badge-kind == 1 ? #33a7dd29 : #ffffff10);

    background: transparent;

    VerticalLayout {
        padding: 22px;
        spacing: 18px;

        // Cycler group, vertically centered. Replaced by the group-call panel
        // while a group call is up.
        Rectangle {
            vertical-stretch: 1;
            if root.group-call-active: VerticalLayout {
                alignment: center;
                spacing: 14px;
                HorizontalLayout {
                    alignment: center;
                    Rectangle {
                        height: 30px;
                        border-radius: 999px;
                        background: #d23b4133;
                        HorizontalLayout {
                            padding-left: 16px;
                            padding-right: 16px;
                            Text {
                                text: "GROUP IN USE";
                                color: #ff9a9d;
                                font-size: 13px;
                                font-weight: 800;
                                letter-spacing: 2px;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
                Text {
                    text: root.group-call-name;
                    color: #f2f7fb;
                    font-size: 52px;
                    font-weight: 800;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
                Text {
                    text: root.group-call-status;
                    color: Palette.muted;
                    font-size: 17px;
                    font-weight: 600;
                    horizontal-alignment: center;
                }
                if root.group-talker-id != "": Text {
                    text: root.group-talker-id;
                    color: Palette.faint;
                    font-size: 15px;
                    font-weight: 600;
                    horizontal-alignment: center;
                }
            }

            if !root.group-call-active: VerticalLayout {
                alignment: center;
                spacing: 20px;

                if root.has-codeplug: HorizontalLayout {
                    alignment: center;
                    FolderButton {
                        name: root.folder-name;
                        clicked => {
                            root.open-folders();
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 12px;
                    CyclerArrow {
                        right: false;
                        enabled: root.can-cycle;
                        clicked => {
                            root.cycle-prev();
                        }
                    }
                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: center;
                        spacing: 6px;
                        Text {
                            text: "TALKGROUP";
                            color: Palette.faint;
                            font-size: 12px;
                            font-weight: 700;
                            letter-spacing: 4px;
                            horizontal-alignment: center;
                        }
                        Text {
                            text: root.talkgroup-name;
                            color: #f2f7fb;
                            font-size: 64px;
                            font-weight: 800;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                        }
                        Text {
                            text: root.tg-sub;
                            color: Palette.muted;
                            font-size: 15px;
                            horizontal-alignment: center;
                        }
                        if root.badge != "": HorizontalLayout {
                            alignment: center;
                            Badge { text: root.badge; fg: root.badge-fg; bg: root.badge-bg; }
                        }
                    }
                    CyclerArrow {
                        right: true;
                        enabled: root.can-cycle;
                        clicked => {
                            root.cycle-next();
                        }
                    }
                }

                // Select-talkgroup action, directly below the cycler. A Cancel
                // button appears beside it when a TX group is active, snapping
                // the cycler back to that group.
                if root.has-codeplug: HorizontalLayout {
                    spacing: 10px;
                    PrimaryButton {
                        horizontal-stretch: 1;
                        text: root.badge-kind == 2 ? "On air" : "Select talkgroup";
                        enabled: root.select-enabled;
                        clicked => {
                            root.select-tg();
                        }
                    }
                    if root.show-cancel: SecondaryButton {
                        horizontal-stretch: 1;
                        text: "Cancel";
                        clicked => {
                            root.cancel-select();
                        }
                    }
                }

                if root.scan-active: HorizontalLayout {
                    alignment: center;
                    Rectangle {
                        height: 40px;
                        border-radius: 999px;
                        background: #33a7dd29;
                        HorizontalLayout {
                            padding-left: 16px;
                            padding-right: 16px;
                            Text {
                                text: "SCAN - " + root.attached-count + " groups";
                                color: #7ecbef;
                                font-size: 13px;
                                font-weight: 700;
                                letter-spacing: 1px;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }

        // Fixed PTT dock: drives the group-call floor (press to key, release to
        // cease). Its look reflects the current floor state.
        Ptt {
            text: root.group-ptt-state == 2 ? "ON AIR"
                : root.group-ptt-state == 1 ? "Requesting..."
                : root.group-ptt-state == 3 ? "Floor busy"
                : root.ptt-label;
            enabled: root.ptt-enabled;
            state: root.group-ptt-state;
            press-down => {
                root.group-ptt-down();
            }
            release => {
                root.group-ptt-up();
            }
        }
    }
}

component MenuScreen inherits Rectangle {
    in property <bool> registered;
    in property <int> unread;
    in property <bool> show-event-log: true;
    callback open-info;
    callback open-logs;
    callback open-groups;
    callback open-config;
    callback open-survey;
    callback register;
    callback deregister;
    background: transparent;
    VerticalLayout {
        padding: 18px;
        spacing: 12px;
        alignment: start;
        ListRow {
            title: "Talkgroups";
            subtitle: "Select, scan, attach and detach groups";
            icon: Icons.users;
            clicked => {
                root.open-groups();
            }
        }
        ListRow {
            title: "Radio Info";
            subtitle: "Registration, network, signal";
            icon: Icons.info;
            clicked => {
                root.open-info();
            }
        }
        if root.show-event-log: ListRow {
            title: "Event Log";
            subtitle: root.unread > 0 ? root.unread + " new events" : "Telemetry events";
            icon: Icons.logs;
            clicked => {
                root.open-logs();
            }
        }
        ListRow {
            title: "Config";
            subtitle: "View and apply the device configuration";
            icon: Icons.gear;
            clicked => {
                root.open-config();
            }
        }
        ListRow {
            title: "Cell Survey";
            subtitle: "Survey carriers and camp on a cell";
            icon: Icons.radio;
            clicked => {
                root.open-survey();
            }
        }
        ListRow {
            title: root.registered ? "Deregister" : "Register";
            subtitle: root.registered ? "Detach from the network" : "Attach to the network";
            icon: root.registered ? Icons.logout : Icons.login;
            danger: root.registered;
            icon-tint: Palette.green;
            clicked => {
                if (root.registered) {
                    root.deregister();
                } else {
                    root.register();
                }
            }
        }
    }
}

component LogsScreen inherits Rectangle {
    in property <[LogRow]> logs;
    callback open(string, string, string);
    background: transparent;
    // Flickable is the direct child so it fills the screen; the softkey bar below
    // it stays pinned to the bottom regardless of how many rows there are.
    Flickable {
        viewport-height: col.preferred-height;
        col := VerticalLayout {
            padding: 16px;
            spacing: 10px;
            alignment: start;
            if root.logs.length == 0: Text {
                text: "No events yet";
                color: Palette.muted;
                font-size: 16px;
                horizontal-alignment: center;
            }
            for e in root.logs: ListRow {
                title: e.variant;
                subtitle: e.summary;
                icon: Icons.logs;
                trailing-text: e.time;
                clicked => {
                    root.open(e.variant, e.time, e.detail);
                }
            }
        }
    }
}

component LogDetailScreen inherits Rectangle {
    in property <string> variant;
    in property <string> time;
    in property <string> body;
    background: transparent;
    VerticalLayout {
        padding: 16px;
        spacing: 12px;
        HorizontalLayout {
            spacing: 12px;
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 48px;
                    height: 48px;
                    border-radius: 13px;
                    background: #33a7dd1f;
                    Icon {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        d: Icons.logs;
                        tint: Palette.accent;
                        size: 24px;
                    }
                }
            }
            VerticalLayout {
                alignment: center;
                spacing: 2px;
                horizontal-stretch: 1;
                Text {
                    text: root.variant;
                    color: Palette.txt;
                    font-size: 20px;
                    font-weight: 700;
                    overflow: elide;
                }
                Text {
                    text: "Received " + root.time;
                    color: Palette.muted;
                    font-size: 14px;
                }
            }
        }
        Rectangle {
            vertical-stretch: 1;
            border-radius: 14px;
            border-width: 1px;
            border-color: Palette.line;
            background: #070d14;
            Flickable {
                viewport-height: body-text.preferred-height + 24px;
                body-text := Text {
                    x: 14px;
                    y: 12px;
                    width: parent.width - 28px;
                    text: root.body;
                    color: #b9ccd8;
                    font-size: 14px;
                    font-family: "Consolas";
                    wrap: word-wrap;
                }
            }
        }
    }
}

component AlertOverlay inherits Rectangle {
    in property <string> title;
    in property <string> message;
    in property <int> kind; // 0 amber, 1 red, 2 green
    callback dismiss;
    width: 100%;
    height: 100%;
    background: #03070cc7;

    property <color> tint: root.kind == 1 ? Palette.red : (root.kind == 2 ? Palette.green : Palette.amber);
    property <string> glyph: root.kind == 1 ? Icons.alert : (root.kind == 2 ? Icons.check : Icons.info);

    TouchArea {
        clicked => {
            root.dismiss();
        }
    }

    Rectangle {
        width: Math.min(parent.width - 44px, 400px);
        height: card.preferred-height;
        background: #131c26;
        border-radius: 20px;
        border-width: 1px;
        border-color: Palette.line2;
        card := VerticalLayout {
            padding: 30px;
            spacing: 16px;
            alignment: start;
            HorizontalLayout {
                alignment: center;
                Rectangle {
                    width: 68px;
                    height: 68px;
                    border-radius: 34px;
                    background: root.kind == 1 ? #f0555a29 : (root.kind == 2 ? #37c06a29 : #e7a72b29);
                    Icon {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        d: root.glyph;
                        tint: root.tint;
                        size: 34px;
                    }
                }
            }
            Text {
                text: root.title;
                color: #ffffff;
                font-size: 22px;
                font-weight: 700;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
            if root.message != "": Text {
                text: root.message;
                color: Palette.muted;
                font-size: 16px;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
            Rectangle {
                height: 54px;
                border-radius: 14px;
                border-width: 1px;
                border-color: Palette.line;
                background: okt.pressed ? #1b2836 : transparent;
                okt := TouchArea {
                    clicked => {
                        root.dismiss();
                    }
                }
                Text {
                    text: "OK";
                    color: #6ab0ff;
                    font-size: 18px;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
    }
}

component InfoScreen inherits Rectangle {
    in property <string> reg-state;
    in property <bool> registered;
    in property <string> service-status;
    in property <bool> in-service;
    in property <string> issi;
    in property <string> network;
    in property <string> serving-la;
    in property <string> colour-code;
    in property <string> rssi;
    in property <int> attached-count;
    in property <bool> restart-required;
    background: transparent;
    VerticalLayout {
        padding: 18px;
        spacing: 12px;
        alignment: start;
        Rectangle {
            background: Palette.surface;
            border-radius: 16px;
            border-width: 1px;
            border-color: Palette.line;
            VerticalLayout {
                padding: 18px;
                spacing: 2px;
                InfoRow {
                    label: "Registration";
                    value: root.reg-state;
                    value-color: root.registered ? Palette.green : Palette.muted;
                }
                InfoRow {
                    label: "Service";
                    value: root.service-status;
                    value-color: root.in-service ? Palette.green : Palette.red;
                }
                InfoRow { label: "Own ISSI"; value: root.issi; }
                InfoRow { label: "Network (MCC/MNC)"; value: root.network; }
                InfoRow { label: "Serving LA"; value: root.serving-la; }
                InfoRow { label: "Colour code"; value: root.colour-code; }
                InfoRow { label: "Signal"; value: root.rssi; }
                InfoRow { label: "Attached groups"; value: root.attached-count; }
            }
        }
        if root.restart-required: Text {
            text: "Restart required to apply staged config";
            color: Palette.amber;
            font-size: 14px;
            wrap: word-wrap;
        }
    }
}

component FoldersScreen inherits Rectangle {
    in property <[FolderRow]> folders;
    callback select-folder(int);
    background: transparent;
    VerticalLayout {
        padding: 18px;
        spacing: 12px;
        alignment: start;
        for f[idx] in root.folders: ListRow {
            title: f.name;
            subtitle: f.count + (f.count == 1 ? " talkgroup" : " talkgroups");
            icon: Icons.folder;
            selected: f.selected;
            clicked => {
                root.select-folder(idx);
            }
        }
    }
}

component Toggle inherits Rectangle {
    in property <bool> on;
    callback toggled(bool);
    width: 66px;
    height: 38px;
    border-radius: 19px;
    border-width: 1px;
    border-color: root.on ? #37c06a80 : Palette.line2;
    background: root.on ? #37c06a3d : #ffffff10;
    TouchArea {
        clicked => {
            root.toggled(!root.on);
        }
    }
    Rectangle {
        width: 30px;
        height: 30px;
        border-radius: 15px;
        x: root.on ? parent.width - self.width - 4px : 4px;
        y: (parent.height - self.height) / 2;
        background: root.on ? #79dfa0 : #8fa3b8;
        animate x { duration: 120ms; easing: ease; }
    }
}

component TagPill inherits Rectangle {
    in property <int> tag; // 1 scan, 2 tx
    height: 22px;
    border-radius: 999px;
    background: root.tag == 2 ? #37c06a2e : #33a7dd29;
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        Text {
            text: root.tag == 2 ? "TX" : "SCAN";
            color: root.tag == 2 ? #79dfa0 : #7ecbef;
            font-size: 11px;
            font-weight: 800;
            letter-spacing: 0.8px;
            vertical-alignment: center;
        }
    }
}

component GroupRowView inherits Rectangle {
    in property <string> name;
    in property <string> sub;
    in property <int> tag;
    in property <bool> attached;
    in property <bool> is-tx;
    callback select;
    callback add;
    callback detach;
    height: 84px;
    border-radius: 16px;
    border-width: 1px;
    border-color: root.is-tx ? #37c06a55 : Palette.line;
    background: touch.pressed ? #16202b : Palette.surface;
    touch := TouchArea {
        clicked => {
            root.select();
        }
    }
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 12px;
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            spacing: 5px;
            horizontal-stretch: 1;
            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                Text {
                    text: root.name;
                    color: Palette.txt;
                    font-size: 19px;
                    font-weight: 600;
                    overflow: elide;
                }
                if root.tag > 0: VerticalLayout { alignment: center; TagPill { tag: root.tag; } }
                Rectangle { horizontal-stretch: 1; }
            }
            Text {
                text: root.sub;
                color: Palette.muted;
                font-size: 14px;
                overflow: elide;
            }
        }
        if !root.is-tx: VerticalLayout {
            alignment: center;
            Rectangle {
                width: 48px;
                height: 48px;
                border-radius: 13px;
                border-width: 1px;
                border-color: Palette.line2;
                background: act.pressed
                    ? #24303d
                    : (root.attached ? #f0555a1f : #37c06a1f);
                act := TouchArea {
                    clicked => {
                        if (root.attached) {
                            root.detach();
                        } else {
                            root.add();
                        }
                    }
                }
                Icon {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    d: root.attached ? Icons.minus : Icons.plus;
                    tint: root.attached ? #ff9a9d : #79dfa0;
                    size: 24px;
                }
            }
        }
    }
}

component ScanRowView inherits Rectangle {
    in property <string> name;
    in property <string> sub;
    in property <bool> active;
    callback toggled(bool);
    height: 76px;
    border-radius: 16px;
    border-width: 1px;
    border-color: root.active ? #37c06a55 : Palette.line;
    background: Palette.surface;
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            spacing: 3px;
            horizontal-stretch: 1;
            Text {
                text: root.name;
                color: Palette.txt;
                font-size: 18px;
                font-weight: 600;
                overflow: elide;
            }
            if root.sub != "": Text {
                text: root.sub;
                color: Palette.muted;
                font-size: 13px;
                overflow: elide;
            }
        }
        VerticalLayout {
            alignment: center;
            Toggle {
                on: root.active;
                toggled(v) => {
                    root.toggled(v);
                }
            }
        }
    }
}

component SectionHeader inherits Text {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 2px;
    color: Palette.faint;
}

component GroupsScreen inherits Rectangle {
    in property <[GroupRow]> groups;
    in property <[ScanRow]> scanlists;
    callback select(int, int);
    callback add(int, int);
    callback detach(int);
    callback toggle-scan(string, bool);
    background: transparent;
    Flickable {
        viewport-height: col.preferred-height;
        col := VerticalLayout {
            padding: 16px;
            spacing: 10px;
            alignment: start;
            if root.groups.length == 0: Text {
                text: "No talkgroups programmed";
                color: Palette.muted;
                font-size: 16px;
                horizontal-alignment: center;
            }
            if root.scanlists.length > 0: SectionHeader { text: "SCAN LISTS"; }
            for s in root.scanlists: ScanRowView {
                name: s.name;
                sub: s.sub;
                active: s.active;
                toggled(v) => {
                    root.toggle-scan(s.name, v);
                }
            }
            if root.scanlists.length > 0 && root.groups.length > 0: SectionHeader {
                text: "TALKGROUPS";
            }
            for g in root.groups: GroupRowView {
                name: g.name;
                sub: g.sub;
                tag: g.tag;
                attached: g.attached;
                is-tx: g.is-tx;
                select => {
                    root.select(g.gssi, g.cou);
                }
                add => {
                    root.add(g.gssi, g.cou);
                }
                detach => {
                    root.detach(g.gssi);
                }
            }
        }
    }
}

component ConfigScreen inherits Rectangle {
    in property <string> toml;
    callback apply;
    callback refresh;
    background: transparent;
    VerticalLayout {
        padding: 16px;
        spacing: 12px;
        Rectangle {
            vertical-stretch: 1;
            border-radius: 14px;
            border-width: 1px;
            border-color: Palette.line;
            background: #070d14;
            Flickable {
                viewport-height: body.preferred-height + 24px;
                body := Text {
                    x: 14px;
                    y: 12px;
                    width: parent.width - 28px;
                    text: root.toml == "" ? "No config loaded yet" : root.toml;
                    color: #b9ccd8;
                    font-size: 13px;
                    font-family: "Consolas";
                    wrap: word-wrap;
                }
            }
        }
        HorizontalLayout {
            spacing: 10px;
            SecondaryButton {
                text: "Refresh";
                icon: Icons.refresh;
                horizontal-stretch: 1;
                clicked => {
                    root.refresh();
                }
            }
            PrimaryButton {
                text: "Apply Config";
                icon: Icons.check;
                horizontal-stretch: 1;
                clicked => {
                    root.apply();
                }
            }
        }
    }
}

component SurveyRowView inherits Rectangle {
    in property <string> title;
    in property <string> sub1;
    in property <string> sub2;
    callback register;
    callback monitor;
    height: 150px;
    border-radius: 14px;
    border-width: 1px;
    border-color: Palette.line;
    background: Palette.surface;
    VerticalLayout {
        padding: 14px;
        spacing: 6px;
        Text {
            text: root.title;
            color: Palette.txt;
            font-size: 20px;
            font-weight: 700;
        }
        Text {
            text: root.sub1;
            color: Palette.muted;
            font-size: 14px;
        }
        Text {
            text: root.sub2;
            color: Palette.muted;
            font-size: 14px;
        }
        HorizontalLayout {
            spacing: 10px;
            padding-top: 4px;
            PrimaryButton {
                text: "Register";
                icon: Icons.login;
                horizontal-stretch: 1;
                clicked => {
                    root.register();
                }
            }
            SecondaryButton {
                text: "Monitor";
                icon: Icons.activity;
                horizontal-stretch: 1;
                clicked => {
                    root.monitor();
                }
            }
        }
    }
}

component SurveyScreen inherits Rectangle {
    in property <bool> manual;
    in property <bool> scanning;
    in property <string> status;
    in property <[SurveyRow]> rows;
    callback toggle-mode;
    callback scan;
    callback stop;
    callback camp(int, bool);
    background: transparent;
    Flickable {
        viewport-height: col.preferred-height;
        col := VerticalLayout {
            padding: 16px;
            spacing: 12px;
            alignment: start;

            // Manual/Auto toggle.
            Rectangle {
                height: 76px;
                border-radius: 14px;
                border-width: 1px;
                border-color: Palette.line;
                background: Palette.surface;
                HorizontalLayout {
                    padding-left: 18px;
                    padding-right: 18px;
                    spacing: 12px;
                    Text {
                        text: "Manual cell selection";
                        color: Palette.txt;
                        font-size: 19px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                    Rectangle { horizontal-stretch: 1; }
                    VerticalLayout {
                        alignment: center;
                        Toggle {
                            on: root.manual;
                            toggled(v) => {
                                root.toggle-mode();
                            }
                        }
                    }
                }
            }

            if !root.manual: Rectangle {
                height: 160px;
                VerticalLayout {
                    alignment: center;
                    spacing: 10px;
                    HorizontalLayout {
                        alignment: center;
                        Icon { d: Icons.radio; tint: Palette.muted; size: 34px; }
                    }
                    Text {
                        text: "Auto mode";
                        color: Palette.txt;
                        font-size: 18px;
                        font-weight: 700;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: "The stack scans and camps on its own. Switch to Manual to survey the programmed carriers and pick a cell.";
                        color: Palette.muted;
                        font-size: 14px;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }
                }
            }

            if root.manual: HorizontalLayout {
                if root.scanning: SecondaryButton {
                    text: "Stop scan";
                    icon: Icons.close;
                    horizontal-stretch: 1;
                    clicked => {
                        root.stop();
                    }
                }
                if !root.scanning: PrimaryButton {
                    text: "Scan cells";
                    icon: Icons.radio;
                    horizontal-stretch: 1;
                    clicked => {
                        root.scan();
                    }
                }
            }

            if root.manual && root.status != "": Text {
                text: root.status;
                color: Palette.muted;
                font-size: 14px;
                horizontal-alignment: center;
            }

            if root.manual: VerticalLayout {
                spacing: 12px;
                for r in root.rows: SurveyRowView {
                    title: r.title;
                    sub1: r.sub1;
                    sub2: r.sub2;
                    register => {
                        root.camp(r.carrier, true);
                    }
                    monitor => {
                        root.camp(r.carrier, false);
                    }
                }
            }

            if root.manual && root.rows.length == 0 && !root.scanning: Text {
                text: "Tap Scan to survey the programmed carriers. The survey is receive-only.";
                color: Palette.muted;
                font-size: 14px;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
        }
    }
}

// In-call view (individual). A proper screen: keeps the status/header/nav chrome
// and mirrors the web UI's .call-hero + docked PTT. Hang up lives in the nav bar.
component InCallScreen inherits Rectangle {
    in property <string> dir;
    in property <string> peer;
    in property <string> sub;
    in property <string> state;
    in property <string> clock;
    in property <bool> can-ptt;
    in property <int> ptt-state;
    in property <bool> ptt-enabled;
    callback ptt-down;
    callback ptt-up;
    background: transparent;
    VerticalLayout {
        padding: 22px;
        // Hero, vertically centered.
        Rectangle {
            vertical-stretch: 1;
            VerticalLayout {
                alignment: center;
                spacing: 4px;
                Text {
                    text: root.dir;
                    color: Palette.muted;
                    font-size: 13px;
                    letter-spacing: 1px;
                    font-weight: 600;
                    horizontal-alignment: center;
                }
                Text {
                    text: root.peer;
                    color: #ffffff;
                    font-size: 40px;
                    font-weight: 800;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
                Text {
                    text: root.sub;
                    color: Palette.muted;
                    font-size: 15px;
                    horizontal-alignment: center;
                }
                Rectangle { height: 10px; }
                Text {
                    text: root.state;
                    color: #8fe6ab;
                    font-size: 16px;
                    font-weight: 600;
                    horizontal-alignment: center;
                }
                if root.clock != "": Text {
                    text: root.clock;
                    color: #cfe9ff;
                    font-size: 24px;
                    font-weight: 700;
                    horizontal-alignment: center;
                }
            }
        }
        // Docked PTT (simplex active calls only), same position as home/group.
        if root.can-ptt: Ptt {
            text: root.ptt-state == 2 ? "ON AIR"
                : root.ptt-state == 1 ? "Requesting..."
                : "Push to talk";
            enabled: root.ptt-enabled;
            state: root.ptt-state;
            press-down => {
                root.ptt-down();
            }
            release => {
                root.ptt-up();
            }
        }
    }
}

// Incoming-call modal overlay (mirrors the web UI .callov / .inc-card).
component IncomingOverlay inherits Rectangle {
    in property <string> peer;
    in property <string> sub;
    callback answer;
    callback reject;
    width: 100%;
    height: 100%;
    // Full-screen opaque incoming-call view (matches the app background).
    background: @linear-gradient(180deg, #0f1620 0%, #0a0f16 100%);
    VerticalLayout {
        padding: 26px;
        spacing: 16px;
        alignment: center;
        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: 84px;
                height: 84px;
                border-radius: 42px;
                background: #37c06a29;
                HorizontalLayout {
                    alignment: center;
                    VerticalLayout {
                        alignment: center;
                        Icon { d: Icons.phone; tint: Palette.green; size: 38px; }
                    }
                }
            }
        }
        Text {
            text: "INCOMING CALL";
            color: Palette.muted;
            font-size: 13px;
            letter-spacing: 1.5px;
            font-weight: 600;
            horizontal-alignment: center;
        }
        Text {
            text: root.peer;
            color: #ffffff;
            font-size: 40px;
            font-weight: 800;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
        Text {
            text: root.sub;
            color: Palette.muted;
            font-size: 15px;
            horizontal-alignment: center;
        }
        Rectangle { height: 14px; }
        // Reject / Answer, big column buttons like the web UI grid.
        HorizontalLayout {
            spacing: 16px;
            Rectangle {
                horizontal-stretch: 1;
                height: 96px;
                border-radius: 18px;
                background: rej.pressed
                    ? @linear-gradient(180deg, #cf3f44 0%, #a82a2f 100%)
                    : @linear-gradient(180deg, #ef5a5f 0%, #cf3f44 100%);
                rej := TouchArea {
                    clicked => {
                        root.reject();
                    }
                }
                VerticalLayout {
                    alignment: center;
                    spacing: 8px;
                    HorizontalLayout {
                        alignment: center;
                        Icon { d: Icons.phone-off; tint: #ffffff; size: 28px; }
                    }
                    Text {
                        text: "Reject";
                        color: #ffffff;
                        font-size: 16px;
                        font-weight: 700;
                        horizontal-alignment: center;
                    }
                }
            }
            Rectangle {
                horizontal-stretch: 1;
                height: 96px;
                border-radius: 18px;
                background: ans.pressed
                    ? @linear-gradient(180deg, #1f9a55 0%, #178045 100%)
                    : @linear-gradient(180deg, #2bb768 0%, #1f9a55 100%);
                ans := TouchArea {
                    clicked => {
                        root.answer();
                    }
                }
                VerticalLayout {
                    alignment: center;
                    spacing: 8px;
                    HorizontalLayout {
                        alignment: center;
                        Icon { d: Icons.phone; tint: #ffffff; size: 28px; }
                    }
                    Text {
                        text: "Answer";
                        color: #ffffff;
                        font-size: 16px;
                        font-weight: 700;
                        horizontal-alignment: center;
                    }
                }
            }
        }
    }
}

component DialKey inherits Rectangle {
    in property <string> text;
    in property <string> sub;
    callback clicked;
    height: 76px;
    border-radius: 16px;
    border-width: 1px;
    border-color: Palette.line2;
    background: touch.pressed ? #1b2836 : @linear-gradient(180deg, #17222f 0%, #0f1822 100%);
    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }
    VerticalLayout {
        alignment: center;
        spacing: 0px;
        Text {
            text: root.text;
            color: #e8f0f6;
            font-size: 26px;
            font-weight: 600;
            horizontal-alignment: center;
        }
        if root.sub != "": Text {
            text: root.sub;
            color: Palette.faint;
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 1px;
            horizontal-alignment: center;
        }
    }
}

component DialerScreen inherits Rectangle {
    in property <string> number;
    callback key(string);
    callback call-simplex;
    background: transparent;
    VerticalLayout {
        padding: 18px;
        spacing: 12px;

        // Number readout at the top.
        VerticalLayout {
            alignment: center;
            spacing: 4px;
            Text {
                text: root.number == "" ? "Enter number" : root.number;
                color: root.number == "" ? Palette.faint : #ffffff;
                font-size: root.number == "" ? 20px : 34px;
                font-weight: root.number == "" ? 600 : 800;
                letter-spacing: 2px;
                horizontal-alignment: center;
            }
            Text {
                text: "PRIVATE NUMBER (ISSI)";
                color: Palette.muted;
                font-size: 11px;
                letter-spacing: 3px;
                horizontal-alignment: center;
            }
        }

        // Keypad, moved up directly under the readout.
        for row in [["1", "2", "3"], ["4", "5", "6"], ["7", "8", "9"], ["*", "0", "#"]]: HorizontalLayout {
            spacing: 10px;
            for d in row: DialKey {
                text: d;
                horizontal-stretch: 1;
                clicked => {
                    root.key(d);
                }
            }
        }

        // Backspace (full width).
        Rectangle {
            height: 60px;
            border-radius: 16px;
            border-width: 1px;
            border-color: Palette.line2;
            background: bstouch.pressed ? #1b2836 : Palette.surface;
            bstouch := TouchArea {
                clicked => {
                    root.key("back");
                }
            }
            Icon {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                d: Icons.backspace;
                tint: Palette.muted;
                size: 24px;
            }
        }

        Rectangle { vertical-stretch: 1; }

        // Docked PTT: press to place a SIMPLEX (PTT) private call. A DUPLEX call
        // is placed from the "Call" softkey in the bottom bar.
        Ptt {
            text: "Push to talk";
            enabled: root.number != "";
            state: 0;
            press-down => {
                root.call-simplex();
            }
        }
    }
}

// Parked keypad layout for non-touch device models.
component KeypadHome inherits FocusScope {
    property <[string]> items: ["Talkgroups", "Logs", "Radio info", "Settings"];
    property <int> selected: 0;
    init => {
        self.focus();
    }
    key-pressed(event) => {
        if (event.text == Key.UpArrow) {
            root.selected = Math.max(0, root.selected - 1);
            return accept;
        }
        if (event.text == Key.DownArrow) {
            root.selected = Math.min(root.items.length - 1, root.selected + 1);
            return accept;
        }
        return reject;
    }
    VerticalLayout {
        padding: 18px;
        spacing: 12px;
        alignment: start;
        Text {
            text: "Keypad layout - Up/Down to move";
            color: Palette.muted;
            font-size: 15px;
        }
        for item[idx] in root.items: Rectangle {
            height: 56px;
            border-radius: 10px;
            border-width: 1px;
            background: idx == root.selected ? #1f6feb : Palette.surface;
            border-color: idx == root.selected ? #4a8bff : Palette.line;
            HorizontalLayout {
                padding-left: 16px;
                Text {
                    text: item;
                    color: Palette.txt;
                    font-size: 18px;
                    vertical-alignment: center;
                }
            }
        }
        Rectangle { vertical-stretch: 1; }
    }
}

export component MainWindow inherits Window {
    title: "TETRA TN UI";
    default-font-family: "Inter";
    default-font-size: 15px;
    // Fixed size (logical px), set from config; makes the window non-resizable so
    // content (e.g. the event log) never stretches it.
    in property <length> win-width: 720px;
    in property <length> win-height: 1280px;
    width: root.win-width;
    height: root.win-height;
    background: @linear-gradient(180deg, #0f1620 0%, #0a0f16 100%);

    in property <DeviceInput> device-input: DeviceInput.Touch;
    in property <bool> show-event-log: true;
    property <Screen> screen: Screen.Home;

    // Auto-open the in-call screen while an individual call is live, and leave it
    // when the call ends (mirrors the web UI pushing/popping the call view).
    changed call-live => {
        if (root.call-live) {
            root.screen = Screen.InCall;
        } else if (root.screen == Screen.InCall) {
            root.screen = Screen.Home;
        }
    }

    // Live state (set from Rust off MsRuntimeState + channel status).
    in property <bool> control-connected;
    in property <bool> telemetry-connected;
    in property <string> reg-state: "Idle";
    in property <string> service-status: "Out of service";
    in property <bool> in-service;
    in property <bool> registered;
    in property <int> signal-bars;
    in property <string> rssi: "--";
    in property <string> issi: "--";
    in property <string> network: "0 / 0";
    in property <string> serving-la: "0";
    in property <string> colour-code: "0";
    in property <int> attached-count;
    in property <bool> scan-active;
    in property <bool> has-codeplug;
    in property <string> talkgroup-name: "No group";
    in property <string> talkgroup-id: "--";
    in property <string> tg-sub: "";
    in property <string> badge: "";
    in property <int> badge-kind;
    in property <bool> can-cycle;
    in property <bool> select-enabled;
    in property <bool> show-cancel-select;
    in property <bool> ptt-enabled;
    in property <string> ptt-label: "Register to talk";
    in property <string> folder-name: "Talkgroups";
    in property <int> sel-folder;
    in property <[FolderRow]> folders;
    in property <bool> restart-required;
    in property <string> clock: "--:--:--";
    in property <string> date: "";
    in property <string> dial-number: "";
    in property <[LogRow]> logs;
    in property <int> unread;
    in property <[GroupRow]> groups;
    in property <[ScanRow]> scanlists;
    in property <bool> alert-visible;
    in property <string> alert-title;
    in property <string> alert-message;
    in property <int> alert-kind;
    in property <string> config-toml: "";
    in property <bool> survey-manual;
    in property <bool> survey-scanning;
    in property <string> survey-status: "";
    in property <[SurveyRow]> survey-rows;
    in property <bool> call-live;
    in property <string> call-dir: "";
    in property <string> call-peer: "";
    in property <string> call-sub: "";
    in property <string> call-state: "";
    in property <string> call-clock: "";
    in property <bool> call-can-ptt;
    in property <int> call-ptt-state;
    in property <bool> call-muted;
    in property <bool> call-incoming;
    in property <string> incoming-peer: "";
    in property <string> incoming-sub: "";
    in property <bool> group-call-active;
    in property <string> group-call-name: "";
    in property <string> group-call-status: "";
    in property <string> group-talker-id: "";
    in property <int> group-ptt-state;

    callback register;
    callback deregister;
    callback cycle-prev;
    callback cycle-next;
    callback select-talkgroup;
    callback cancel-select;
    callback select-folder(int);
    callback ptt;
    callback dial-key(string);
    callback dial-call(bool);
    callback open-logs;
    callback alert-dismiss;
    callback group-select(int, int);
    callback group-attach(int, int);
    callback group-detach(int);
    callback scanlist-toggle(string, bool);
    callback apply-config;
    callback refresh;
    callback survey-toggle-mode;
    callback survey-scan;
    callback survey-stop;
    callback survey-camp(int, bool);
    callback call-ptt-down;
    callback call-ptt-up;
    callback group-ptt-down;
    callback group-ptt-up;
    callback answer-call;
    callback reject-call;
    callback hangup-call;
    callback hangup-group;
    callback toggle-mute;

    // Detail of the event currently open on the LogDetail screen.
    property <string> detail-variant;
    property <string> detail-time;
    property <string> detail-body;

    function screen-title() -> string {
        if (root.screen == Screen.Menu) {
            return "Menu";
        }
        if (root.screen == Screen.Info) {
            return "Radio Info";
        }
        if (root.screen == Screen.Folders) {
            return "Folders";
        }
        if (root.screen == Screen.Dialer) {
            return "Dialer";
        }
        if (root.screen == Screen.Logs) {
            return "Event Log";
        }
        if (root.screen == Screen.LogDetail) {
            return "Event";
        }
        if (root.screen == Screen.Groups) {
            return "Talkgroups";
        }
        if (root.screen == Screen.Config) {
            return "Config";
        }
        if (root.screen == Screen.Survey) {
            return "Cell Survey";
        }
        if (root.screen == Screen.InCall) {
            return "Call";
        }
        return root.clock + "   " + root.date;
    }

    // Parent screen for the Back softkey.
    function back-target() -> Screen {
        if (root.screen == Screen.Info || root.screen == Screen.Logs || root.screen == Screen.Groups || root.screen == Screen.Config || root.screen == Screen.Survey) {
            return Screen.Menu;
        }
        if (root.screen == Screen.LogDetail) {
            return Screen.Logs;
        }
        return Screen.Home;
    }

    VerticalLayout {
        width: 100%;
        height: 100%;
        StatusBar {
            bars: root.signal-bars;
            network: root.network;
            scan: root.scan-active;
            control-on: root.control-connected;
            telemetry-on: root.telemetry-connected;
        }

        Header {
            title: root.screen-title();
            muted: root.screen == Screen.Home;
        }

        if root.device-input == DeviceInput.Touch && root.screen == Screen.Home: HomeScreen {
            vertical-stretch: 1;
            has-codeplug: root.has-codeplug;
            folder-name: root.folder-name;
            talkgroup-name: root.talkgroup-name;
            tg-sub: root.tg-sub;
            badge: root.badge;
            badge-kind: root.badge-kind;
            can-cycle: root.can-cycle;
            attached-count: root.attached-count;
            scan-active: root.scan-active;
            select-enabled: root.select-enabled;
            show-cancel: root.show-cancel-select;
            ptt-enabled: root.ptt-enabled;
            ptt-label: root.ptt-label;
            group-call-active: root.group-call-active;
            group-call-name: root.group-call-name;
            group-call-status: root.group-call-status;
            group-talker-id: root.group-talker-id;
            group-ptt-state: root.group-ptt-state;
            cycle-prev => {
                root.cycle-prev();
            }
            cycle-next => {
                root.cycle-next();
            }
            select-tg => {
                root.select-talkgroup();
            }
            cancel-select => {
                root.cancel-select();
            }
            open-folders => {
                root.screen = Screen.Folders;
            }
            ptt => {
                root.ptt();
            }
            group-ptt-down => {
                root.group-ptt-down();
            }
            group-ptt-up => {
                root.group-ptt-up();
            }
            hangup-group => {
                root.hangup-group();
            }
        }

        if root.device-input == DeviceInput.Touch && root.screen == Screen.Menu: MenuScreen {
            vertical-stretch: 1;
            registered: root.registered;
            unread: root.unread;
            show-event-log: root.show-event-log;
            open-info => {
                root.screen = Screen.Info;
            }
            open-groups => {
                root.screen = Screen.Groups;
            }
            open-logs => {
                root.open-logs();
                root.screen = Screen.Logs;
            }
            open-config => {
                root.refresh();
                root.screen = Screen.Config;
            }
            open-survey => {
                root.refresh();
                root.screen = Screen.Survey;
            }
            register => {
                root.register();
                root.screen = Screen.Home;
            }
            deregister => {
                root.deregister();
                root.screen = Screen.Home;
            }
        }

        if root.device-input == DeviceInput.Touch && root.screen == Screen.Logs: LogsScreen {
            vertical-stretch: 1;
            logs: root.logs;
            open(v, t, d) => {
                root.detail-variant = v;
                root.detail-time = t;
                root.detail-body = d;
                root.screen = Screen.LogDetail;
            }
        }

        if root.device-input == DeviceInput.Touch && root.screen == Screen.LogDetail: LogDetailScreen {
            vertical-stretch: 1;
            variant: root.detail-variant;
            time: root.detail-time;
            body: root.detail-body;
        }

        if root.device-input == DeviceInput.Touch && root.screen == Screen.Folders: FoldersScreen {
            vertical-stretch: 1;
            folders: root.folders;
            select-folder(i) => {
                root.select-folder(i);
                root.screen = Screen.Home;
            }
        }

        if root.device-input == DeviceInput.Touch && root.screen == Screen.Groups: GroupsScreen {
            vertical-stretch: 1;
            groups: root.groups;
            scanlists: root.scanlists;
            select(g, c) => {
                root.group-select(g, c);
            }
            add(g, c) => {
                root.group-attach(g, c);
            }
            detach(g) => {
                root.group-detach(g);
            }
            toggle-scan(n, a) => {
                root.scanlist-toggle(n, a);
            }
        }

        if root.device-input == DeviceInput.Touch && root.screen == Screen.Info: InfoScreen {
            vertical-stretch: 1;
            reg-state: root.reg-state;
            registered: root.registered;
            service-status: root.service-status;
            in-service: root.in-service;
            issi: root.issi;
            network: root.network;
            serving-la: root.serving-la;
            colour-code: root.colour-code;
            rssi: root.rssi;
            attached-count: root.attached-count;
            restart-required: root.restart-required;
        }

        if root.device-input == DeviceInput.Touch && root.screen == Screen.Config: ConfigScreen {
            vertical-stretch: 1;
            toml: root.config-toml;
            apply => {
                root.apply-config();
            }
            refresh => {
                root.refresh();
            }
        }

        if root.device-input == DeviceInput.Touch && root.screen == Screen.Survey: SurveyScreen {
            vertical-stretch: 1;
            manual: root.survey-manual;
            scanning: root.survey-scanning;
            status: root.survey-status;
            rows: root.survey-rows;
            toggle-mode => {
                root.survey-toggle-mode();
            }
            scan => {
                root.survey-scan();
            }
            stop => {
                root.survey-stop();
            }
            camp(c, r) => {
                root.survey-camp(c, r);
            }
        }

        if root.device-input == DeviceInput.Touch && root.screen == Screen.Dialer: DialerScreen {
            vertical-stretch: 1;
            number: root.dial-number;
            key(k) => {
                root.dial-key(k);
            }
            call-simplex => {
                root.dial-call(false);
            }
        }

        if root.device-input == DeviceInput.Keypad: KeypadHome {
            vertical-stretch: 1;
        }

        if root.device-input == DeviceInput.Touch && root.screen == Screen.InCall: InCallScreen {
            vertical-stretch: 1;
            dir: root.call-dir;
            peer: root.call-peer;
            sub: root.call-sub;
            state: root.call-state;
            clock: root.call-clock;
            can-ptt: root.call-can-ptt;
            ptt-state: root.call-ptt-state;
            ptt-enabled: root.ptt-enabled;
            ptt-down => {
                root.call-ptt-down();
            }
            ptt-up => {
                root.call-ptt-up();
            }
        }

        // Softkey bar (3-column grid), context-dependent.
        Rectangle {
            height: 92px;
            background: @linear-gradient(180deg, #0c141d 0%, #0a1017 100%);
            HorizontalLayout {
                padding-top: 14px;
                padding-bottom: 14px;
                padding-left: 14px;
                padding-right: 14px;
                spacing: 10px;

                if root.screen == Screen.Home: Softkey {
                    text: "Menu";
                    icon: Icons.menu;
                    horizontal-stretch: 1;
                    clicked => {
                        root.screen = Screen.Menu;
                    }
                }
                if root.screen == Screen.Home: Rectangle { horizontal-stretch: 1; }
                if root.screen == Screen.Home && !root.group-call-active: Softkey {
                    text: "Dialer";
                    icon: Icons.phone;
                    horizontal-stretch: 1;
                    clicked => {
                        root.screen = Screen.Dialer;
                    }
                }
                if root.screen == Screen.Home && root.group-call-active: Softkey {
                    text: "Hang up";
                    icon: Icons.phone-off;
                    danger: true;
                    horizontal-stretch: 1;
                    clicked => {
                        root.hangup-group();
                    }
                }

                if root.screen != Screen.Home && root.screen != Screen.InCall: Softkey {
                    text: "Back";
                    icon: Icons.back;
                    horizontal-stretch: 1;
                    clicked => {
                        root.screen = root.back-target();
                    }
                }
                // Center Home button to jump back to the home screen from any
                // sub-menu (not in a call, where the center is call controls).
                if root.screen != Screen.Home && root.screen != Screen.InCall: Softkey {
                    text: "Home";
                    icon: Icons.home;
                    horizontal-stretch: 1;
                    clicked => {
                        root.screen = Screen.Home;
                    }
                }
                // Dialer: Call (right) places a DUPLEX call; the keypad PTT places
                // a simplex call. Other sub-menus keep the right slot empty.
                if root.screen == Screen.Dialer: Softkey {
                    text: "Call";
                    icon: Icons.phone;
                    horizontal-stretch: 1;
                    enabled: root.dial-number != "";
                    clicked => {
                        root.dial-call(true);
                    }
                }
                if root.screen != Screen.Home && root.screen != Screen.InCall && root.screen != Screen.Dialer: Rectangle { horizontal-stretch: 1; }

                // In-call: Mute (left) + Hang up (right, danger).
                if root.screen == Screen.InCall: Softkey {
                    text: root.call-muted ? "Unmute" : "Mute";
                    icon: root.call-muted ? Icons.mic-off : Icons.mic;
                    horizontal-stretch: 1;
                    clicked => {
                        root.toggle-mute();
                    }
                }
                if root.screen == Screen.InCall: Rectangle { horizontal-stretch: 1; }
                if root.screen == Screen.InCall: Softkey {
                    text: "Hang up";
                    icon: Icons.phone-off;
                    danger: true;
                    horizontal-stretch: 1;
                    clicked => {
                        root.hangup-call();
                    }
                }
            }
        }
    }

    if root.call-incoming: IncomingOverlay {
        peer: root.incoming-peer;
        sub: root.incoming-sub;
        answer => {
            root.answer-call();
        }
        reject => {
            root.reject-call();
        }
    }

    if root.alert-visible: AlertOverlay {
        title: root.alert-title;
        message: root.alert-message;
        kind: root.alert-kind;
        dismiss => {
            root.alert-dismiss();
        }
    }
}
