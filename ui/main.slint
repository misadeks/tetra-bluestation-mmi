// TETRA TN UI - Slint UI (Pi touch), styled to match the browser
// tetra-tn-web-ui (Classic-style radio). Device frame of status bar + header +
// stage + softkey grid; home is the talkgroup cycler with the select action
// directly below and a docked PTT; Menu and Dialer reachable from the home
// softkeys. Bundled Inter font, SVG-path icons, large touch metrics. Live values
// are `in` properties set from Rust (app.rs) off MsRuntimeState.

// Bundle the Inter font (matches the web UI) so the look is consistent on
// Windows and the Pi regardless of installed system fonts.
import "fonts/Inter-Regular.ttf";
import "fonts/Inter-Medium.ttf";
import "fonts/Inter-SemiBold.ttf";
import "fonts/Inter-Bold.ttf";
import "fonts/Inter-ExtraBold.ttf";

export enum DeviceInput { Touch, Keypad }
export enum Screen { Home, Menu, Info, Folders, Dialer, Logs, LogDetail, Groups, Config, Survey, InCall, Contacts, ContactDetail, ContactEdit, Messages, MsgThread, MsgNew, Program, ProgramList, ProgramEdit, Tree, Ringtones, Settings, Network, Recents, RecentDetail }

export struct FolderRow {
    name: string,
    count: int,
    selected: bool,
}

// A conversation summary in the messages list.
export struct ConvRow {
    peer: int,
    name: string,
    snippet: string,
    unread: int,
    is-group: bool,
    ts: string,
}

// A single message bubble within a thread.
export struct MsgRow {
    id: int,
    outgoing: bool,
    text: string,
    state: int, // 0 sending, 1 delivered, 2 read, 3 failed, 4 inbound
    ts: string,
}

export struct ContactRow {
    index: int,
    name: string,
    sub: string,
    kind: int, // 0 individual (ISSI), 1 external phone (via gateway)
}

// A row in the recents / call log.
export struct RecentRow {
    id: int,
    title: string,
    sub: string,
    time: string,
    // outcome: 0 answered, 1 missed, 2 rejected, 3 no-answer, 4 failed
    kind: int,
    outgoing: bool,
    can-call: bool,
}

// A row in a codeplug-section list (networks, folders, talkgroups, ...).
export struct EntityRow {
    index: int,
    title: string,
    sub: string,
}

// One field of the generic codeplug edit form.
export struct FormField {
    label: string,
    // 0 text, 1 digits, 2 dial (digits + * # +), 3 toggle, 4 cycle (tap to change)
    kind: int,
    value: string,
    on: bool,
}

// A row in the folders + talkgroups tree.
export struct TreeRow {
    // 0 folder header, 1 group, 2 add-group action, 3 empty hint
    kind: int,
    // group: all_talkgroups index; folder header / add-group: folder index (-1 = Other)
    index: int,
    title: string,
    sub: string,
    // folder header: whether the folder is collapsed
    collapsed: bool,
    // group: whether it can move up / down within its folder
    can-up: bool,
    can-down: bool,
}

// A selectable dialer target: index 0 is always "Private" (ISSI); the rest are
// codeplug gateways in order. max-len is the digit cap for the typed number.
export struct DialTarget {
    label: string,
    max-len: int,
}

export struct LogRow {
    time: string,
    variant: string,
    summary: string,
    detail: string,
}

export struct GroupRow {
    gssi: int,
    name: string,
    sub: string,
    tag: int, // 0 none, 1 scan, 2 tx
    cou: int,
    attached: bool,
    is-tx: bool,
}

export struct ScanRow {
    name: string,
    sub: string,
    active: bool,
}

export struct SurveyRow {
    carrier: int,
    title: string,
    sub1: string,
    sub2: string,
}

// Palette lifted from the web UI's :root custom properties.
global Palette {
    out property <color> bg: #06080b;
    out property <color> glass1: #0f1620;
    out property <color> glass2: #0a0f16;
    out property <color> surface: #131c26;
    out property <color> surface2: #17222f;
    out property <color> line: #ffffff12;
    out property <color> line2: #ffffff21;
    out property <color> txt: #eaf0f5;
    out property <color> muted: #8b98a5;
    out property <color> faint: #58656f;
    out property <color> accent: #33a7dd;
    out property <color> green: #37c06a;
    out property <color> red: #f0555a;
    out property <color> amber: #e7a72b;
}

// Line icon rendered from an SVG path (24x24 viewbox), like the web UI icons.
component Icon inherits Path {
    in property <string> d;
    in property <length> size: 22px;
    in property <color> tint: Palette.txt;
    in property <float> weight: 2.0;
    width: root.size;
    height: root.size;
    viewbox-width: 24;
    viewbox-height: 24;
    commands: root.d;
    fill: transparent;
    stroke: root.tint;
    stroke-width: root.weight * 1px;
}

