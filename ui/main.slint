            backspace => {
                root.backspace();
            }
        }
        Rectangle { height: 8px; }
        HorizontalLayout {
            spacing: 10px;
            SecondaryButton {
                text: "Cancel";
                icon: Icons.close;
                horizontal-stretch: 1;
                clicked => {
                    root.cancel();
