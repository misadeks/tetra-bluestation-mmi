# scripts/cross/pi.env - settings for the WSL/Linux cross-compile path.
# Copy to pi.env (gitignored) and edit. All values are optional; defaults are in
# common.sh.

# Pi SSH target.
PI_USER=pi
PI_HOST=tetra-ms.local

# Where the binary + config.toml land on the Pi.
REMOTE_DIR=/home/pi/tetra-tn-ui

# Cross target. aarch64 for Raspberry Pi OS 64-bit (the Pi 4 kiosk).
PI_TARGET=aarch64-unknown-linux-gnu

# Log level used when the script runs the binary on the Pi.
RUST_LOG=info

# CPU pinning so the UI stays off the cores the TETRA radio/stack uses.
# CPU_AFFINITY: systemd unit syntax (space/'-' separated); empty disables.
#   Must be quoted because the value contains a space (it is sourced by bash).
# TASKSET_CPUS: taskset cpu-list for ad-hoc runs; empty disables.
CPU_AFFINITY="0 1"
TASKSET_CPUS="0-1"

# Touchscreen calibration matrix for a rotated (landscape) panel. Installs a
# libinput udev rule so touch matches [ui].rotation. Empty = leave touch as-is.
# Pair with the rotation you set in config.toml:
#   rotation 90  -> "0 1 0 -1 0 1"
#   rotation 180 -> "-1 0 1 0 -1 1"
#   rotation 270 -> "0 -1 1 1 0 0"
# TOUCH_CALIBRATION_MATRIX="0 1 0 -1 0 1"

# Boot-splash rotation (0/90/180/270) to match [ui].rotation on a landscape
# panel. The splash is written raw to the framebuffer, so a landscape image must
# be pre-rotated the same quarter turn the app applies. Empty/0 = no rotation.
# SPLASH_ROTATE=90

