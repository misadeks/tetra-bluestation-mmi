# scripts/cross/pi.env - settings for the WSL/Linux cross-compile path.
# Copy to pi.env (gitignored) and edit. All values are optional; defaults are in
# common.sh.

# Pi SSH target.
PI_USER=pi
PI_HOST=tetra-ms.local

# Where the binary + config.toml land on the Pi.
REMOTE_DIR=/home/pi/tetra-tn-ui

# Cross target. aarch64 for Raspberry Pi OS 64-bit (the Pi 4 kiosk).
PI_TARGET=aarch64-unknown-linux-gnu

# Log level used when the script runs the binary on the Pi.
RUST_LOG=info

# CPU pinning so the UI stays off the cores the TETRA radio/stack uses.
# CPU_AFFINITY: systemd unit syntax (space/'-' separated); empty disables.
# TASKSET_CPUS: taskset cpu-list for ad-hoc runs; empty disables.
CPU_AFFINITY=0 1
TASKSET_CPUS=0-1
